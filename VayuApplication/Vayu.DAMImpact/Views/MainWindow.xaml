                                <DataGridTextColumn Width="20*" Binding="{Binding Hour23}"  Header="23" IsReadOnly="True"  />
                                <DataGridTextColumn Width="20*" Binding="{Binding Hour24}"  Header="24" IsReadOnly="True"  />

