                                </StackPanel>

                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Buttons" BorderBrush="#FF1D1C1C" Height="70" Margin="6,7" Width="190">
                            <StackPanel Orientation="Horizontal">
                                <Button Height="27" Width="70" Margin="5,0,0,0" Content="Refresh" Command="{Binding RefreshAllCommand}"></Button>
                                <Button Height="27" Width="90" Margin="5,0,0,0" Content="Export To CSV" Command="{Binding ExportToExcelCommand}"></Button>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Source Summary" BorderBrush="#FF1D1C1C" Height="70" Margin="6">
