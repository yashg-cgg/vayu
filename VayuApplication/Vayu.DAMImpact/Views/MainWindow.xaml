<Window    x:Class="Vayu.DAMImpact.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:vm="clr-namespace:Vayu.DAMImpact.ViewModels"
        prism:ViewModelLocator.AutoWireViewModel="False"
        Title="VAYU - DAM Impact" Height="650" Width="700">

    <Window.Resources>

        <ResourceDictionary>
            
            <vm:DataGridBackColorConverter x:Key="myBGColor"/>
            <vm:ValueToForegroundColorConverter x:Key="ValueToForeground"/>
            <!--<Style x:Key="CenterCellStyleFG" TargetType="{x:Type DataGridCell}">
                <Setter Property="Foreground" 
                        Value="{Binding RelativeSource={RelativeSource Self},
                        Path=Content.Text, 
                        Converter={
            ValueToForeground}}" />
                <Setter Property="TextBlock.TextAlignment" Value="Center"></Setter>
            </Style>-->
            <Style x:Key="CenterCellStyleFG" TargetType="{x:Type DataGridCell}">

                <Setter Property="Foreground">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource ValueToForeground}">
                            <!--<Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.Items[RowIndex].RTImpactsourceFMAProp"/>
                            
                            <Binding RelativeSource="{RelativeSource Self}" Path="Content.Text"/>-->
                            <Binding Path="DataContext.RTImpactsourceProp" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                            <!-- Binding for DataGrid2 -->
                            <Binding Path="DataContext.RTImpactsourceFMAProp" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
                <Setter Property="TextBlock.TextAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <TabControl>
            <TabItem Header="Source" Width="100">

                <Grid x:Name="LayoutRoot" >
                   
