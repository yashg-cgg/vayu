                        <RowDefinition Height="500*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="3" Orientation="Horizontal" Grid.ColumnSpan="3">

                        <GroupBox Header="Select Date" BorderBrush="#FF1D1C1C" Height="70" Margin="6">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="2" Orientation="Horizontal">
                                    <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="Date  :-"></TextBlock>
