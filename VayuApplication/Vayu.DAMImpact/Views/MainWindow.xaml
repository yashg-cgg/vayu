		          CanUserAddRows="False" FontFamily="Microsoft Sans Serif, 8.25pt" FontWeight="ExtraLight" ItemsSource="{Binding RTImpactsourceProp}"  CellStyle="{StaticResource CenterCellStyleFG}" Grid.ColumnSpan="3">
