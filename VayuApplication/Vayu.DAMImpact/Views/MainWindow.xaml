                                <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="Hours Price Set:-"></TextBlock>
                                <TextBox Margin="5,0,0,0" Width="50" Height="20" VerticalAlignment="Center" Text="{Binding SourceHoursPriceSetProp}"/>
                                <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="Percent:-"></TextBlock>
                                <TextBox Margin="5,0,0,0" Width="40" Height="20" VerticalAlignment="Center" Text="{Binding SourcePercentageProp, StringFormat={}{0:F2}%}"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Total Summary" BorderBrush="#FF1D1C1C" Height="70" Margin="6">
