                                <DataGridTextColumn Width="20*" Binding="{Binding Hour1}"  Header="1" IsReadOnly="True" />
                                <DataGridTextColumn Width="20*" Binding="{Binding Hour2}"  Header="2" IsReadOnly="True" />
