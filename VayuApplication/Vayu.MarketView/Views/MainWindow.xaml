<Window   x:Class="Vayu.MarketView.Views.MainWindow"
                    
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:prism="http://prismlibrary.com/"
                   xmlns:local="clr-namespace:Vayu.MarketView.Views"
                   
                   xmlns:vm="clr-namespace:Vayu.MarketViewNameSpace.ViewModel" xmlns:viewmodels="clr-namespace:Vayu.MarketView.ViewModels" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"   
                   xmlns:wpf="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
                   prism:ViewModelLocator.AutoWireViewModel="False"
                   Title="Vayu-MarketView" HorizontalContentAlignment="Center" Height="1000" Width="1400" Loaded="Window_Loaded_1"
                   >
    <!-- Mapsui/OSM migration: the Bing Maps xmlns:map declaration below was replaced by the wpf xmlns above. Kept for traceability.
         xmlns:map="clr-namespace:Microsoft.Maps.MapControl.WPF;assembly=Microsoft.Maps.MapControl.WPF"
    -->
    <Window.Resources>
        <ResourceDictionary>
            <!--<local:ValueToShapeColorConverter x:Key="V2SC" /> -->
            <!--<local:ColorSwapper x:Key="ColorSwap"/>-->
            <vm:DataGridBackColorConverter x:Key="myBGColor"/>
            <vm:DataGridBackColorConverterLMP x:Key="myBGColorLMP"/>
            <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <local:BoolToCollapsedConverter x:Key="BoolToCollapsedConverter"/>
            <Style TargetType="DataGridCell" x:Key="NodeDeenergizedStyle">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding NodeDeenergized}" Value="True">
                        <Setter Property="Foreground" Value="Red"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding NodeDeenergized}" Value="False">
                        <Setter Property="Foreground" Value="Black"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="CenterCellStyleBG" TargetType="{x:Type DataGridCell}">
                <Setter Property="Foreground" 
                        Value="{Binding RelativeSource={RelativeSource Self},
                        Path=Content.Text, 
                        Converter={StaticResource myBGColor}}" />
            </Style>
            <Style x:Key="CenterCellStyleBGLMP" TargetType="{x:Type DataGridCell}">
                <Setter Property="Background" 
                        Value="{Binding RelativeSource={RelativeSource Self},
                        Path=Content.Text, 
                        Converter={StaticResource myBGColorLMP}}" />
            </Style>
            <ContextMenu x:Key="constraintsContextMenu" Background="Lavender" FontWeight="DemiBold">
                <MenuItem Header="Navigate" Command="{Binding NavigateConstraints}"/>
                <MenuItem Header="Constraint History" Command="{Binding ConstraintHistory}"/>
                <MenuItem Header="Sensitivities" Command="{Binding AllErcotShiftFactors}" IsEnabled="{Binding isErcotEnabled , Mode=TwoWay}" />
                <MenuItem Header="Constraint Outage Mapping" Click="Outages_Click"/>
            </ContextMenu>
            <!-- Mapsui/OSM migration: the shape ControlTemplates and Pushpin styles below only served the Bing map:Pushpin bindings.
                 They are no longer referenced by any live XAML. Kept commented for traceability.
            <ControlTemplate x:Key="squareShape">
                <Rectangle Width="10" Height="10" Fill="{Binding Path=., Converter={StaticResource V2SC}}" Stroke="Black" StrokeThickness="0.8" Margin="-5,-5,0,0"/>
            </ControlTemplate>
            <ControlTemplate x:Key="circleWithStrokeShape">
                <Ellipse Stroke="Black" StrokeThickness="0.8" Width="5" Height="5" Margin="-5,-5,0,0" Fill="{Binding Path=., Converter={StaticResource V2SC}}"/>
            </ControlTemplate>
            <ControlTemplate x:Key="starShape">
                <Polygon Fill="{Binding Path=., Converter={StaticResource V2SC}}" Stroke="Black" StrokeThickness="0.8" Points="3.52671151375484,4.85410196624968 2.85316954888546,0.927050983124842 5.70633909777092,-1.85410196624968 1.76335575687742,-2.42705098312484 7.34763812293426E-16,-6 -1.76335575687742,-2.42705098312484 -5.70633909777092,-1.85410196624969 -2.85316954888546,0.927050983124842 -3.52671151375484,4.85410196624968 -7.34763812293426E-16,3"/>
            </ControlTemplate>
            <ControlTemplate x:Key="TriangleShape">
                <Polygon Fill="{Binding Path=., Converter={StaticResource V2SC}}" Stroke="Black" StrokeThickness="0.8" Points="5.19615242270663,-3 -5.19615242270663,-3 -1.46952762458685E-15,6" />
            </ControlTemplate>
            <ControlTemplate x:Key="DiamondShape">
                <Polygon Fill="{Binding Path=., Converter={StaticResource V2SC}}" Stroke="Black" StrokeThickness="0.8" Points="0,5.5 5.5,0 0,-5.5 -5.5,0" />
            </ControlTemplate>
            <Style x:Key="lmpStyle" TargetType="map:Pushpin">
                <Setter Property="Template" Value="{StaticResource circleWithStrokeShape}"></Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding TypeName}" Value="ZONE">
                        <Setter Property="Template" Value="{StaticResource starShape}"></Setter>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding TypeName}" Value="HUB">
                        <Setter Property="Template" Value="{StaticResource TriangleShape}"></Setter>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding TypeName}" Value="AGGREGATE">
                        <Setter Property="Template" Value="{StaticResource DiamondShape}"></Setter>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding TypeName}" Value="INTERFACE">
                        <Setter Property="Template" Value="{StaticResource squareShape}"></Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="MapFillColor" TargetType="map:MapPolyline">
                <Setter Property="Background" Value="{Binding FillColor}">
                </Setter>
            </Style>
            <local:StringColorConverter x:Key="strColor"/>
            -->
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Expander IsExpanded="True">
            <GroupBox Grid.Row="0" Header="{Binding LMPHeader}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="43.545" />
                        <ColumnDefinition Width="541.455"/>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Expander Grid.Row="0" Grid.Column="0" ExpandDirection="Right" IsExpanded="True" Grid.ColumnSpan="2">
                        <Expander.Content>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="180" />
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="Markets" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="market" Height="15"
                                              ItemsSource="{Binding Markets}" SelectedItem="{Binding SelectedMarket}" SelectionChanged="ComboBox_SelectionChanged_1"/>
                                    <TextBlock Margin="0,0,0,0" Text="{Binding SliderDisplayTime, Mode=TwoWay}" Grid.Column="2" />
                                    <Button Content="Current" Grid.Column="3" Grid.Row="0" Width="95" Margin="0,0,100,0" Command="{Binding OnCurrent}"/>
                                    <Button Content="Add" Grid.Column="3" Grid.Row="0" Margin="100,0,0,0" Width="95" Command="{Binding AddPortfolio}"/>
                                    <Button Content="Refresh" Grid.Column="3" Grid.Row="1" Width="95" Margin="0,0,100,0" Command="{Binding OnRefresh}"/>
                                    <Button Content="Remove" Grid.Column="3" Grid.Row="1" Margin="100,0,0,0" Width="95" Command="{Binding RemovePortfolio}"/>
                                    <Button Content="Un-Pin" Grid.Column="3" Grid.Row="2" Width="95" Margin="0,0,100,0" Command="{Binding UnPin}"/>
                                    <Button Content="All Portfolios" Grid.Column="3" Grid.Row="2" Margin="100,0,0,0" Width="95" Command="{Binding AddAllPortfolio}"/>
                                    <TextBlock Grid.Row="1" Margin="2 0 0 0" VerticalAlignment="Center" Text="Portfolio" FontWeight="Bold" Grid.ColumnSpan="2" />
                                    <TextBlock Grid.Row="2" FontWeight="Bold" Text="Zone" VerticalAlignment="Center" Margin="10 0 0 0" Grid.Column="0" />
                                    <ComboBox Grid.Column="1" Grid.Row="1" x:Name="traderPortFolioComboBox" IsTextSearchEnabled="True"
                                              IsEditable="True" ItemsSource="{Binding TraderPortfolioList}" SelectedValue="{Binding TraderPortfolioSelectedItem}"/>
                                    <ComboBox x:Name="traderPortFolioComboBox2" Grid.Row="2" Grid.Column="1" IsTextSearchEnabled="True"
                                              ItemsSource="{Binding DistinctZoneList}" SelectedValue="{Binding ZoneSelectedItem}"/>
                                    <ListBox x:Name="portfolioListBox" Grid.Row="1" Grid.Column="2" Grid.RowSpan="5" ItemsSource="{Binding PortfolioList}"
                                             ScrollViewer.CanContentScroll="True" BorderBrush="DarkOliveGreen" BorderThickness="1"
                                             SelectedItem="{Binding SelectedPortfolioListItem}" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="2,2,2,2" />
                                    <TextBox x:Name="txtRefreshMap" Text="{Binding TextChangeTxtBox}" Width="80" Height="22" Margin="-95,-10,4,4"
                                             Visibility="Hidden" TextChanged="txtRefreshMap_TextChanged"/>
                                    <CheckBox Content="Historical" Grid.Column="3" Grid.Row="3"
                                              IsChecked="{Binding IsHistoricalChecked, Mode=TwoWay}" />
                                    <Button Content="Play" Command="{Binding PlayCommand}" Grid.Column="3" Grid.Row="4"
                                            Visibility="{Binding IsHistoricalChecked, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Button Content="Stop" Command="{Binding StopCommand}" Grid.Column="3" Grid.Row="5"
                                            Visibility="{Binding IsHistoricalChecked, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Slider x:Name="dateTimeSlider" Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="6"
                                            Minimum="0"
                                            Maximum="576"
                                            Value="{Binding SliderValue, Mode=TwoWay}"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            Width="500"
                                            Visibility="{Binding IsHistoricalChecked, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Grid.Row="3" FontWeight="Bold" Text="Search:" VerticalAlignment="Center" Margin="10 0 0 0" Grid.Column="0" />
                                    <TextBox x:Name="searchTextBox" Grid.Row="3" Grid.Column="1" Width="150"
                                             Text="{Binding SearchText, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" BorderThickness="2"/>
                                </Grid>
                                <Grid Grid.Row="1" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="35"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Margin="0,0,0,0" Content="Time: " VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding UpdateTime, Mode=TwoWay}" VerticalAlignment="Center" Margin="1 2 0 0" Background="LightGreen" />
                                    <CheckBox Grid.Column="2" x:Name="chkSettlementLocationsOnly" Content="Settlement Locations Only" Margin="2,0,0,0" IsChecked="{Binding SettlementOnly,Mode=TwoWay}" IsEnabled="{Binding SettlementEnable}" VerticalAlignment="Center" />
                                    <CheckBox Content="UPTOs Only" IsChecked="{Binding UPTOOnly,Mode=TwoWay}" IsEnabled="{Binding UPTOEnable}" VerticalAlignment="Center" Visibility="Hidden"/>
                                    <RadioButton x:Name="UTCRadioButton" FontWeight="Bold" Grid.Column="3" Margin="2 0 0 0" Content="UTC" IsChecked="{Binding UTCChecked,Mode=TwoWay}" />
                                    <RadioButton x:Name="CRRRadioButton" FontWeight="Bold" Grid.Column="4" Margin="2 0 0 0" Content="CRR" IsChecked="{Binding CRRChecked,Mode=TwoWay}"/>
                                    <RadioButton x:Name="VirtualRadioButton" FontWeight="Bold" Grid.Column="5" Margin="2 0 0 0" Content="Virtual" IsChecked="{Binding VirtualChecked,Mode=TwoWay}" />
                                    <TextBlock Text="Count :" Grid.Column="6" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="6" Margin="50 0 0 0" Text="{Binding Count, Mode=TwoWay}" VerticalAlignment="Center" Background="LightGreen" />
                                </Grid>
                                <DataGrid Grid.Row="2" IsReadOnly="True" Width="535" HorizontalAlignment="Left" VerticalAlignment="Stretch" SelectedItem="{Binding SelectedLMP}"
                                          Margin="3,3,0,0" AlternatingRowBackground="LightGray" AutoGenerateColumns="False" CanUserAddRows="False" Name="SPPLocationMarginal"
                                          SelectionUnit="FullRow" SelectionMode="Extended" SelectedCellsChanged="DataGrid_SelectedCellsChanged" ItemsSource="{Binding LatestLMPList,Mode=TwoWay}" Grid.RowSpan="2">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Click="LMPGraph_Click" Header="LMP Graphs" />
                                            <MenuItem Click="NodeAnalyzer_Click" Header="LMP Satistics" />
                                            <MenuItem Command="{Binding NavigateLMP}" Header="Navigate" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="130*" Binding="{Binding NodeName, Mode=TwoWay}" Header="Node Name" CellStyle="{StaticResource NodeDeenergizedStyle}" />
                                        <DataGridTextColumn Width="80*" Binding="{Binding Zone,Mode=TwoWay}" Foreground="Black" Header="Zone"/>
                                        <DataGridTextColumn Width="50*" Binding="{Binding LMP, Mode=TwoWay, StringFormat=F2}" Foreground="Black" Header="LMP" CellStyle="{StaticResource CenterCellStyleBGLMP}" />
                                        <DataGridTextColumn Width="55*" Binding="{Binding EnergyPrice, Mode=TwoWay, StringFormat=F2}" Header="Energy" CellStyle="{StaticResource CenterCellStyleBG}" />
                                        <DataGridTextColumn Width="60*" Binding="{Binding Congestion, Mode=TwoWay, StringFormat=F2}" Header="RTCong" CellStyle="{StaticResource CenterCellStyleBG}" />
                                        <DataGridTextColumn Width="60*" Binding="{Binding DACongestion, Mode=TwoWay, StringFormat=F2}" Header="DACong" CellStyle="{StaticResource CenterCellStyleBG}" />
                                        <DataGridTextColumn Width="50*" Binding="{Binding DART, Mode=TwoWay, StringFormat=F2}" Header="DARTCong" CellStyle="{StaticResource CenterCellStyleBG}" />
                                        <DataGridTextColumn Width="116*" Foreground="Black" Binding="{Binding DateTime, Mode=TwoWay}" Header="Date Time" />
                                    </DataGrid.Columns>
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        </Style>
                                    </DataGrid.CellStyle>
                                </DataGrid>
                            </Grid>
                        </Expander.Content>
                    </Expander>
                    <Grid x:Name="LmpMapZone" Grid.ColumnSpan="2" ></Grid>

