                    <!-- Mapsui/OSM replacement for the Bing <map:Map> block above.
                         Layers and features are managed in code-behind (see MainWindow.xaml.cs -> InitializeMap). -->
                    <wpf:MapControl x:Name="LmpMap"
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Height="Auto"
                                    Margin="3,2,0,0"
                                    />

