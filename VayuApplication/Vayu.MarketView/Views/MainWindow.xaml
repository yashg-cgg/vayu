                          CanUserAddRows="False" ItemsSource="{Binding LatestConstraintsList, Mode=OneWay}" Foreground="Black" ContextMenu="{StaticResource constraintsContextMenu}" AutoGenerateColumns="False"
                          SelectedItem="{Binding SelectedConstrain}" local:HideColByMarket.HideCol="{Binding ElementName=market,Path=Text,Mode=TwoWay}">
