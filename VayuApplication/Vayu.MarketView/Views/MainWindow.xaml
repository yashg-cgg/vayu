                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <CheckBox Grid.Row="0" Margin="20,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Content="AllDay ?" FontWeight="Bold" IsChecked="{Binding IsAllDay, Mode=TwoWay}"/>
