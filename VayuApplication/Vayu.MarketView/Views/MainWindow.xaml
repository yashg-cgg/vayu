                        <DataGridTextColumn Width="15*" Foreground="Black" Binding="{Binding MarketDate, StringFormat=MM/dd/yyyy HH:mm:ss tt}" Header="Market Date"/>
                        <DataGridTextColumn Width="11*" Foreground="Black" Binding="{Binding ShadowPrice, StringFormat=F2}" CellStyle="{StaticResource CenterCellStyleBG}" Header="Shadow Price"/>
                        <DataGridTextColumn Width="18*" Foreground="Black" Binding="{Binding ContigencyText}" Header="Contigency Text">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="ToolTip" Value="{Binding ContigencyText}"/>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="25*" Foreground="Black" Binding="{Binding ContingencyDesc}" Header="Contingency Desc"/>
                        <DataGridTextColumn Width="21*" TextBlock.TextAlignment="Center" Foreground="Black" Binding="{Binding ConstraintText}" Header="Constraint Text"/>
                        <DataGridTextColumn Width="17*" Foreground="Black" Binding="{Binding ConstraintType}" Header="Monitored Element Type">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="12*" Foreground="Black" Binding="{Binding FromStation}" Header="From Station" />
                        <DataGridTextColumn Width="12*" Foreground="Black" Binding="{Binding ToStation}" Header="To Station" />
                        <DataGridTextColumn Width="12*" Foreground="Black" Binding="{Binding FromKV}" Header="From KV" />
                        <DataGridTextColumn Width="12*" Foreground="Black" Binding="{Binding ToKV}" Header="To KV" />
                        <DataGridTextColumn Width="12*" Foreground="Black" Binding="{Binding SourceZone}" Header="Source Zone" />
                        <DataGridTextColumn Width="12*" Foreground="Black" Binding="{Binding SinkZone}" Header="Sink Zone" />
                        <DataGridTextColumn Width="10*" Foreground="Black" Binding="{Binding MonitoredID1}" Header="MonitoredID1" />
                        <DataGridTextColumn Width="12*" Foreground="Black" Binding="{Binding MonitoredID2}" Header="MonitoredID2" />
                        <DataGridTextColumn Width="15*" Foreground="Black" Binding="{Binding RatingType}" Header="Rating Type" />
                        <DataGridTextColumn Width="12*" Foreground="Black" Binding="{Binding RatingMW}" Header="Discount Factor" />
                        <DataGridTextColumn Width="12*" Foreground="Black" Binding="{Binding ConstrainedSCEDLimitMW , StringFormat=0.00}" Header="ConstrainedSCEDLimitMW" />
                        <DataGridTextColumn Width="12*" Foreground="Black" Binding="{Binding SCEDRatingMVA, StringFormat=0.00}" Header="SCEDRatingMVA" />
                        <DataGridTextColumn Width="12*" Foreground="Black" Binding="{Binding PostCTGFlowMW, StringFormat=0.00}" Header="Post CTG Flow MW" />
                        <DataGridTextColumn Width="12*" Foreground="Black" Binding="{Binding PostCTGFlowMVA, StringFormat=0.00}" Header="PostCTGFlowMVA" />
                        <DataGridTextColumn Width="12*" Foreground="Black" Binding="{Binding PercentViolation, StringFormat=0.00}" Header="Percent Violation" />
                        <DataGridTextColumn Width="10*" Foreground="Black" Binding="{Binding DSTFlag}" Header="DST Flag" />
                    </DataGrid.Columns>
                    <DataGrid.CellStyle>
                        <Style TargetType="{x:Type DataGridCell}">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
