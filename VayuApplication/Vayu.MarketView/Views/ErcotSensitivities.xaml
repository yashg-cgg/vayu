<Window    x:Class="Vayu.MarketView.Views.ErcotSensitivities"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"             
             prism:ViewModelLocator.AutoWireViewModel="False" Title="ErcotSensitivities" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"></ColumnDefinition>
                    <ColumnDefinition Width="70"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Button Name="Commit" Grid.Row="0" Grid.Column="0" Content="Commit" Margin="10,0,0,5" Height="25"  Command="{Binding CommitUpdatedShiftFactors}" IsEnabled="{Binding isCommitEnabled}" />
                <Button x:Name="Update"  Grid.Row="0" Grid.Column="1" Content="Update" Margin="10,0,0,5" Height="25" Command="{Binding UpdateShiftFactors}" IsEnabled="{Binding isUpdateEnabled}" />
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="30"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="450"></ColumnDefinition>
                            <ColumnDefinition Width="110"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Label Name="Constraint" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" Content="{Binding ConstraintName ,  Mode=TwoWay}" Margin="10,0,0,5"></Label>
                        <Label Name="Contingency" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" Content="{Binding ContingencyName , Mode=TwoWay}" Margin="10,0,0,5"></Label>
                        <Label Name="ConstraintId" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Content="{Binding ConstraintID , Mode=TwoWay}" Margin="10,0,0,5"></Label>
                        <Label Name="Markettype" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Left" Content="{Binding Markettype , Mode=TwoWay}" Margin="10,0,0,5"></Label>
                    </Grid>
                </StackPanel>
            </Grid>
        </StackPanel>
        <DataGrid Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="True" SelectionMode="Extended" SelectedItem="{Binding SelectedNode , Mode=TwoWay}"  ItemsSource="{Binding SensitivityList }"
                  AlternatingRowBackground="LightGray">
            <DataGrid.Columns>
                <DataGridTextColumn Header="NodeName"  Binding="{ Binding NodeName}" Width="*" />
                <DataGridTextColumn Header="Zone"  Binding="{ Binding Zone}" Width="*" />
                <DataGridTextColumn Header="Sensitivity"  Binding="{ Binding Sensitivity }" Width="*" IsReadOnly="{Binding isSensitivityUpdatable , Mode=TwoWay}" />
                <DataGridTextColumn Header="Source"  Binding="{ Binding Source}" Width="*"  />
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Window>
