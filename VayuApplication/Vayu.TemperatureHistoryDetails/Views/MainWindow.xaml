<Window x:Class="Vayu.TemperatureHistoryDetails.Views.MainWindow"
                   
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="False"
        Title="VAYU -Temperature History Details" Height="1000" Width="1645">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="LayoutRoot" Margin="0,0,-0.4,60.8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170*"/>
            <ColumnDefinition Width="427*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="540"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,10,-1,365" Grid.ColumnSpan="2" >
            <GroupBox Grid.Column="0" Header="Product/Market" Width="162" Margin="10,0,15,63"
                      BorderBrush="#FF1D1C1C">
                <StackPanel Orientation="Horizontal" Margin="0,0,0.8,70.4">
                    <Label Content="Markets" Margin="0,-3,0,-28"/>
                    <ComboBox ItemsSource="{Binding MarketList}" SelectedItem="{Binding SelectedMarket}" Width="90" Margin="0,0,0,-29"></ComboBox>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Date Range" HorizontalAlignment="Left"
                     BorderBrush="#FF1D1C1C" Margin="0,0,0,0" VerticalAlignment="Top" Height="104" Width="262">
                <StackPanel Margin="0,0,-2.8,0.2">
                    <DatePicker
                        x:Name="startDatePicker"
                        SelectedDateFormat="Short"
                        SelectedDate="{Binding StartDate}"
                        Margin="0,5,149.6,0" Height="25"></DatePicker>
                    <Label Height="24" Margin="110,-23,114.6,5" Content="TO"></Label>
                    <DatePicker x:Name="endDatePicker"
                       SelectedDateFormat="Short" SelectedDate="{Binding EndDate}"
                        Margin="134,-33,7.6,0" Height="23"></DatePicker>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="City " HorizontalAlignment="Left" 
                     BorderBrush="#FF1D1C1C" VerticalAlignment="Top" Width="300" Height="104" Margin="10,0,0,0">

                    <ListBox x:Name="cityListBox" Margin="0 0  0 0" ItemsSource="{Binding cityList,Mode=TwoWay}" SelectedItem="{Binding SelecetedItemCity}" 
                             SelectedValue="{Binding SelectedFamily, Mode=TwoWay}" 
                             SelectionMode="Multiple"
                             SelectionChanged="cityListBox_SelectionChanged"/>
                 
            </GroupBox>
            <StackPanel Orientation="Horizontal" Margin="13,54,0,61.6" Width="205">
                <Button Content="Refresh" FontWeight="ExtraBold" Width="90" Height="35"  x:Name="RefreshButton" 
                        Command="{Binding RunRetrieveFetchDataCommand}" Margin="5,5,0,8.8" IsEnabled="{Binding IsRefreshEnabled}" RenderTransformOrigin="0.5,0.503" />
                <Button Content="ExportToCSV" 
                                    HorizontalAlignment="Left" 
                                    Height="35" Margin="12,5,5,0" VerticalAlignment="Top" 
                                    Width="86" 
                                    Click="ExportToCSV"
                                    RenderTransformOrigin="0.515,-0.45" Grid.Column="1" Grid.ColumnSpan="2"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="-201,0,0,111.6" Width="205">
                <Button Content="Select All" FontWeight="DemiBold" Width="90" Height="35" Click="CityAllSelect_Click"></Button>
                <Button Content="UnSelect All" FontWeight="DemiBold" Margin="10,0,0,0" Width="90"  Click="CityUnSelect_Click" Height="35"></Button>

            </StackPanel>

        </StackPanel>
        <DataGrid x:Name="TemperatureListMinMax1" ScrollViewer.CanContentScroll="True" 
      ScrollViewer.VerticalScrollBarVisibility="Auto"
      ScrollViewer.HorizontalScrollBarVisibility="Auto" AlternatingRowBackground="LightSteelBlue"
						          AutoGenerateColumns="False"                                 
						          CanUserAddRows="False"
						          ColumnWidth="auto"                                 
						          IsReadOnly="True"
						          ItemsSource="{Binding TemperatureList }"  
                                      Margin="2,131,-2.4,-263.2" Grid.ColumnSpan="2">

            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding City}" Header="City" Width="65"/>
                <DataGridTextColumn Binding="{Binding TempVal}" Header="Temp" Width="20*" TextBlock.TextAlignment="Center"/>
                <DataGridTextColumn Binding="{Binding ClimateDate}" Header="Date" Width="40*"/>
                <DataGridTextColumn Binding="{Binding Humidity}" Header="Humidity" Width="20*" TextBlock.TextAlignment="Center"/>
                <DataGridTextColumn Binding="{Binding Rain, StringFormat=N2}" Header="Rain" Width="20*" TextBlock.TextAlignment="Center"/>
                <DataGridTextColumn Binding="{Binding Clouds}" Header="Cloud"  Width="20*" TextBlock.TextAlignment="Center"/>
                <DataGridTextColumn Binding="{Binding Description}"  Header="Description" Width="41*" TextBlock.TextAlignment="Center"/>
                <DataGridTextColumn Binding="{Binding WindGust}"  Header="WindGust" Width="20*" TextBlock.TextAlignment="Center"/>
                <DataGridTextColumn Binding="{Binding WindSpeed}"  Header="WindSpeed" Width="20*" TextBlock.TextAlignment="Center"/>
                <DataGridTextColumn Binding="{Binding MinTemp}"  Header="MinTemp" Width="20*" TextBlock.TextAlignment="Center"/>
                <DataGridTextColumn Binding="{Binding MaxTemp}"  Header="MaxTemp"  Width="20*" TextBlock.TextAlignment="Center"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
