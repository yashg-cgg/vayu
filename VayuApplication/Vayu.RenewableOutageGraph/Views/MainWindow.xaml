<Window    x:Class="Vayu.RenewableOutageGraph.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="False"
        Title="Renewable Outage Graph" Height="1450" WindowState="Maximized">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Header="Market" Grid.Column="0">
                <ComboBox x:Name="MarketName" 
                      IsEditable="True" 
                      ItemsSource="{Binding ISOMarketList}" 
                      SelectedValue="{Binding MarketComboSelectedValue, Mode=TwoWay}"
            	      Margin="0,15,0,15" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                          />
            </GroupBox>
            <GroupBox Header="Select Dates" Grid.Column="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="StartDate"/>
                        <DatePicker x:Name="startdate"
                            Width="125"
                            SelectedDate="{Binding StartDate}"
                            HorizontalAlignment="Left"
							VerticalAlignment="Center"
                            Margin="15,0,0,0"
                            SelectedDateFormat="Short" />
                    </StackPanel>
                    <StackPanel  Orientation="Horizontal">
                        <Label Content="EndDate" Width="60"/>
                        <DatePicker x:Name="Enddate"
                            Width="121"
                            SelectedDate="{Binding Enddate}"
                            HorizontalAlignment="Left"
							VerticalAlignment="Center"
                            Margin="15,0,0,0"
                            SelectedDateFormat="Short" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <GroupBox Header=" " Grid.Column="2">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Refresh"
                            Margin="50,10,10,10" 
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                          	Command="{Binding RunRefreshCommand}"
                               Width="82"/>
                </StackPanel>
            </GroupBox>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>
            <TabControl Grid.Row="1" HorizontalAlignment="Left" >

                
                <TabItem Header="Graph">
                    
                    <oxy:PlotView
		          Height="Auto"
		          VerticalContentAlignment="Stretch"
		          Background="Black"
		          BorderBrush="Gray" 

		          BorderThickness="1"
		          Model="{Binding PlotDataModel}" HorizontalAlignment="Left" Width="1590" Margin="0,0,0,0.16" />
                </TabItem>
            </TabControl>
        </Grid>
        <ContentControl prism:RegionManager.RegionName="ContentRegion" />
    </Grid>
</Window>
