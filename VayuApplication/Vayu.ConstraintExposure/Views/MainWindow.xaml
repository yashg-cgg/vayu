<Window 
                  x:Class="Vayu.ConstraintExposure.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/" xmlns:local="clr-namespace:Vayu.ConstraintExposure.Views"
    prism:ViewModelLocator.AutoWireViewModel="False"
       Title="VAYU - Constraint Exposure Analyzer"    Width="1200">
    <Window.Resources>
        <ResourceDictionary>
            <local:ForeColorConverter x:Key="foreGroundColor"/>
            <local:TextColumnConverter x:Key="textColumnConverter"/>
            <BooleanToVisibilityConverter x:Key="b2v" />
            <Style x:Key="CenterCellStyleFGSimple" TargetType="{x:Type DataGridCell}">
                <!--Path=Content.Text, -->
                <Setter Property="Foreground" 
                        Value="{Binding RelativeSource={RelativeSource Self},Path=Content.Text,
                        
                        Converter={StaticResource foreGroundColor}}" />
                <Setter Property="Margin" Value="0,0,0,0"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="LightBlue">
        <Grid.RowDefinitions>
            <RowDefinition Height="220"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="0" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Content="_Markets"/>
                <ComboBox x:Name="Markets" Grid.Row="0" Grid.Column="1" SelectionChanged="Markets_SelectionChanged" ItemsSource="{Binding MarketList}" SelectedItem="{Binding SelectedMarket}" />
                <Label Grid.Row="1" Grid.Column="0" Content="Mode"/>
                <ComboBox x:Name="mode"  Grid.Row="1" Grid.Column="1" SelectionChanged="mode_SelectionChanged" ItemsSource="{Binding ModeList}" SelectedItem="{Binding SelectedMode}" />
                <Label Grid.Row="2" Grid.Column="0" Content="Virtual Type"/>
                <ComboBox x:Name="virtualType" SelectionChanged="virtualType_SelectionChanged" ItemsSource="{Binding VirtualTypeList}" SelectedItem="{Binding SelectedVirtual}"  Grid.Row="2" Grid.Column="1"/>
                <Label Grid.Row="3" Grid.Column="0" Content="Capture"/>
                <ComboBox x:Name="capture" SelectionChanged="ComboBox_SelectionChanged" Grid.Row="3" Grid.Column="1" ItemsSource="{Binding CaptureList}" SelectedItem="{Binding SelectedCapture}"/>
                <Label Grid.Row="4" Grid.Column="0" Content="INC or DEC"/>
                <ComboBox x:Name="rbINCDEC" ItemsSource="{Binding IncDecList}" Grid.Row="4" Grid.Column="1" SelectedItem="{Binding SelectedIncDec}" IsReadOnly="True"/>
                <Label Grid.Row="5" Grid.Column="0" Content="RT or DA"/>
                <ComboBox x:Name="rbRTDA" ItemsSource="{Binding RTDAList}" Grid.Row="5" Grid.Column="1" SelectedItem="{Binding SelectedRTDA}" IsReadOnly="True" SelectionChanged="rbRTDA_SelectionChanged"/>
                <Button Grid.Column="0" Name="BtnPaste" Command="{Binding RunPasteCommand}" Grid.Row="6" Content="Paste" Margin="26,5,21,0" Grid.ColumnSpan="2"/>
            </Grid>
            <Grid Grid.Row="0" Grid.Column="1">
                <GroupBox  x:Name="groupBox4" Header="Source/Sink" Grid.Column="1" Margin="5" BorderBrush="#FF1D1C1C">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130*"/>
                                <ColumnDefinition Width="130*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.Resources>
                                <Style TargetType="ComboBox">
                                    <Setter Property="Margin" Value="2"/>
                                </Style>
                            </Grid.Resources>
                            <ComboBox Height="23" x:Name="sourceComboBox" IsEditable="True" IsTextSearchEnabled="True"
    	        	            ItemsSource="{Binding SourceNodeList}" DisplayMemberPath="NodeName"  SelectedValue="{Binding SourceComboSelectedItem}" GotFocus="sourceComboBox_GotFocus"  Visibility="{Binding VisibleUpToTrue, Mode=TwoWay, Converter={StaticResource b2v}}"
                                VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" Grid.Column="0" />

                            <ComboBox Height="23"  x:Name="sinkComboBox" IsEditable="True" IsTextSearchEnabled="True"
    	        	            ItemsSource="{Binding SinkNodeList}" DisplayMemberPath="NodeName" SelectedValue="{Binding SinkComboSelectedItem}" GotFocus="sinkComboBox_GotFocus" Visibility="{Binding VisibleUpToTrue, Mode=TwoWay, Converter={StaticResource b2v}}"
                                 VirtualizingStackPanel.IsVirtualizing="True"  VirtualizingStackPanel.VirtualizationMode="Recycling" Grid.Column="1"/>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <StackPanel.Resources>
                                <Style TargetType="Button">
                                    <Setter Property="Margin" Value="2"/>
                                    <Setter Property="Width" Value="60"/>
                                    <Setter Property="Height" Value="23"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </StackPanel.Resources>
                            <Button Name="addSourceSinkButton"
		        		        Command="{Binding AddSourceSinkCommand}"
		        		        Content="Add"/>
                            <Button Name="removeSourceSinkButton"
		        		        Command="{Binding RemoveSourceSinkCommand}"
		        		        Content="Remove"/>
                            <Button Name="swapSourceSinkButton"
		        		        Command="{Binding SwapSourceSinkCommand}"
		        		        Content="Swap"/>
                        </StackPanel>
                        <DataGrid Name="sourceSinkDataGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                               AlternatingRowBackground="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}"
                               AutoGenerateColumns="False" CanUserAddRows="False" CanUserReorderColumns="False"
                               CanUserResizeRows="False" IsReadOnly="True" ItemsSource="{Binding SourceSinkList,Mode=TwoWay}"
                               SelectedValue="{Binding SourceSinkDataSelected}" SelectionMode="Single" Grid.Row="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*" Binding="{Binding Source}"
                                                 CanUserReorder="False" Header="Source"/>
                                <DataGridTextColumn Width="*" Binding="{Binding Sink}"
                                                 CanUserReorder="False" Header="Sink"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </GroupBox>
            </Grid>
            <Grid Grid.Row="0" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition  />
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <GroupBox   Header="Settlement Dates" x:Name="groupBox3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="115"/>

                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="Date Range" Margin="2 0 0 0"     IsChecked="{Binding DateRangeDACheckBoxChecked}" x:Name="cbDateDARange"/>
                        <CheckBox Content="Date Range" Margin="2,0,0,0"  Grid.Column="0" Grid.Row="1" IsChecked="{Binding DateRangeRTCheckBoxChecked}"  x:Name="cbDateRTRange" />
                        <Label Content="DA Settle"  Grid.Column="1" Grid.Row="0"   Margin="5"  x:Name="label1"/>
                        <Label Content="RT Settle"  Grid.Column="1" Grid.Row="1"  Margin="5"    x:Name="label2"/>
                        <DatePicker   Grid.Row="0" Grid.Column="2"  Margin="5"  x:Name="DASettleDatePicker" SelectedDate="{Binding DASettleSelected}"/>
                        <DatePicker Grid.Row="1" Grid.Column="2"  Margin="5" x:Name="RTSettleDatePicker" SelectedDate="{Binding RTSettleSelected}"/>
                        <DatePicker  Grid.Row="0" Grid.Column="3"  Margin="5" IsEnabled="{Binding IsChecked, ElementName=cbDateDARange}" SelectedDate="{Binding ThroDADate, Mode=TwoWay}" />
                        <DatePicker Margin="5" Grid.Row="1" Grid.Column="3"  IsEnabled="{Binding IsChecked, ElementName=cbDateRTRange}" SelectedDate="{Binding ThroRTDate, Mode=TwoWay}"/>

                    </Grid>

                </GroupBox>
                <GroupBox Grid.Row="1" Grid.Column="0" Header="Specific Constraint Display" >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105*"/>
                            <ColumnDefinition Width="113*"/>
                            <ColumnDefinition Width="97*"/>
                            <ColumnDefinition Width="105*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="Start Date"  Margin="5" Grid.Row="0" Grid.Column="0" IsChecked="{Binding StartChecked, Mode=TwoWay}" IsEnabled="{Binding StartDateEnabled}"/>
                        <CheckBox Content="Choose Family" Margin="5" Grid.Row="0" Grid.Column="1"  
                        		IsChecked="{Binding FamilyChecked, Mode=TwoWay}" x:Name="cbFamily" Checked="cbFamily_Checked" 
                        		Unchecked="cbFamily_Unchecked" />
                        <ComboBox   VerticalAlignment="Top" Margin="5" Grid.Column="2"  x:Name="FamilyComboBox" IsEditable="True" IsTextSearchEnabled="True"  ItemsSource="{Binding FamilyList}" SelectedValue="{Binding SelectedFamily, Mode=TwoWay}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                        <CheckBox Content="Best" Grid.Row="0" Grid.Column="3" Margin="5"  IsChecked="{Binding BestChecked, Mode=TwoWay}" x:Name="cbBest" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                        <CheckBox x:Name="OutageChkBox" Content="Outage" Grid.Column="0" Grid.Row="1" Margin="5" IsChecked="{Binding OutageChecked,Mode=TwoWay}"></CheckBox>
                        <CheckBox x:Name="ConstraintChkBox" Content="Genscape" Grid.Row="1" Grid.Column="1" Margin="5" IsChecked="{Binding ConstraintChecked,Mode=TwoWay}"/>
                        <Label Content="Shadow Price"   HorizontalAlignment="Left" Grid.Column="2" Grid.Row="1" />
                        <TextBox x:Name="ShadowPriceTextBox" Grid.Column="3" Grid.Row="1"   Text="{Binding ShadowPriceValue,Mode=TwoWay}"></TextBox>
                    </Grid>
                </GroupBox>
                <GroupBox Grid.Row="0" Grid.Column="2" Header="History">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="Lookback"   Margin="5,5,0,0"   IsChecked="{Binding LookBackChecked, Mode=TwoWay}" x:Name="cbLookBack"/>
                        <Label Content="Days" HorizontalAlignment="Left" Margin="5,5,0,0"  Grid.Row="0" Grid.Column="1" VerticalAlignment="Top" x:Name="label6"/>
                        <TextBox HorizontalAlignment="Left" Height="23" Margin="45,5,0,0"  Grid.Row="0" Grid.Column="1"  TextWrapping="Wrap" VerticalAlignment="Top" Width="29" Text="{Binding DaysVal, Mode=TwoWay}" x:Name="tbDays"/>
                    </Grid>
                </GroupBox>
                <Grid Grid.Row="1" Grid.Column="2">
                    <Button Content="Go" Margin="10,0,0,0" Width="72" x:Name="Button1"  Command="{Binding RunRetrieveFetchDataCommand}" VerticalAlignment="Center" HorizontalAlignment="Left"
                            IsEnabled="{Binding IsGoEnabled}" Click="Button1_Click" Height="38"/>
                </Grid>
            </Grid>
            
        </Grid>
        <Grid Grid.Row="1" Grid.Column="0" Background="Aqua">
            <DataGrid HorizontalAlignment="Stretch" Grid.Row="1" Sorting="DataGrid_Sorting" x:Name="dataGrid"
                   IsReadOnly="True" AlternatingRowBackground="LightGray" AreRowDetailsFrozen="True"  CanUserReorderColumns="False"
                  VerticalAlignment="Stretch" CanUserAddRows="False" GridLinesVisibility="All" ItemsSource="{Binding ConstraintsList,Mode=TwoWay}" SelectedItem="{Binding SelectedExposureItem}"
    	        AutoGenerateColumns="False" Margin="0,5,0,-5" 
                 >
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding summaryConstraintNum}" Value="-1">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="Beige"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding summaryConstraintNum}" Value="-2">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="Cornsilk"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Command="{Binding RunHistoricalConstraintsCommand}" Header="Historical Constraints"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Width="30*" CanUserReorder="False" IsReadOnly="True" Binding="{Binding constraintNum}" Foreground="Black"/>
                    <DataGridTextColumn Header="Constraint" Width="120*" Binding="{Binding monitoredName}" Foreground="Black"/>
                    <DataGridTextColumn Header="Congestion" Width="70*" Binding="{Binding contingName}" CellStyle="{StaticResource CenterCellStyleFGSimple}"/>
                    <DataGridTextColumn Header="HE1" Width="35*"  Binding="{Binding he1Value,ConverterCulture=en-US,Converter={StaticResource textColumnConverter}}" CellStyle="{StaticResource CenterCellStyleFGSimple}" />
                    <DataGridTextColumn Header="HE2" Width="35*"  Binding="{Binding he2Value,ConverterCulture=en-US,Converter={StaticResource textColumnConverter}}" CellStyle="{StaticResource CenterCellStyleFGSimple}"/>
                    <DataGridTextColumn Header="HE3" Width="35*"  Binding="{Binding he3Value,ConverterCulture=en-US,Converter={StaticResource textColumnConverter}}" CellStyle="{StaticResource CenterCellStyleFGSimple}"/>
                    <DataGridTextColumn Header="HE4" Width="35*"  Binding="{Binding he4Value,ConverterCulture=en-US,Converter={StaticResource textColumnConverter}}" CellStyle="{StaticResource CenterCellStyleFGSimple}"/>
                    <DataGridTextColumn Header="HE5" Width="35*"  Binding="{Binding he5Value,ConverterCulture=en-US,Converter={StaticResource textColumnConverter}}" CellStyle="{StaticResource CenterCellStyleFGSimple}"/>
                    <DataGridTextColumn Header="HE6" Width="35*"  Binding="{Binding he6Value,ConverterCulture=en-US,Converter={StaticResource textColumnConverter}}" CellStyle="{StaticResource CenterCellStyleFGSimple}"/>
                    <DataGridTextColumn Header="HE7" Width="35*"  Binding="{Binding he7Value,ConverterCulture=en-US,Converter={StaticResource textColumnConverter}}" CellStyle="{StaticResource CenterCellStyleFGSimple}"/>
                    <DataGridTextColumn Header="HE8" Width="35*"  Binding="{Binding he8Value,ConverterCulture=en-US,Converter={StaticResource textColumnConverter}}" CellStyle="{StaticResource CenterCellStyleFGSimple}"/>
                    <DataGridTextColumn Header="HE9" Width="35*"  Binding="{Binding he9Value,ConverterCulture=en-US,Converter={StaticResource textColumnConverter}}" CellStyle="{StaticResource CenterCellStyleFGSimple}"/>
                    <DataGridTextColumn Header="HE10" Width="35*"  Binding="{Binding he10Value,ConverterCulture=en-US,Converter={StaticResource textColumnConverter}}" CellStyle="{StaticResource CenterCellStyleFGSimple}" />
                    <DataGridTextColumn Header="HE11" Width="35*"  Binding="{Binding he11Value,ConverterCulture=en-US,Converter={StaticResource textColumnConverter}}" CellStyle="{StaticResource CenterCellStyleFGSimple}" />
                    <DataGridTextColumn Header="HE12" Width="35*"  Binding="{Binding he12Value,ConverterCulture=en-US,Converter={StaticResource textColumnConverter}}" CellStyle="{StaticResource CenterCellStyleFGSimple}"/>
                    <DataGridTextColumn Header="HE13" Width="35*"  Binding="{Binding he13Value,ConverterCulture=en-US,Converter={StaticResource textColumnConverter}}" CellStyle="{StaticResource CenterCellStyleFGSimple}"/>
                    <DataGridTextColumn Header="HE14" Width="35*"  Binding="{Binding he14Value,ConverterCulture=en-US,Converter={StaticResource textColumnConverter}}" CellStyle="{StaticResource CenterCellStyleFGSimple}"/>
                    <DataGridTextColumn Header="HE15" Width="35*"  Binding="{Binding he15Value,ConverterCulture=en-US,Converter={StaticResource textColumnConverter}}" CellStyle="{StaticResource CenterCellStyleFGSimple}"/>
                    <DataGridTextColumn Header="HE16" Width="35*"  Binding="{Binding he16Value,ConverterCulture=en-US,Converter={StaticResource textColumnConverter}}" CellStyle="{StaticResource CenterCellStyleFGSimple}"/>
                    <DataGridTextColumn Header="HE17" Width="35*"  Binding="{Binding he17Value,ConverterCulture=en-US,Converter={StaticResource textColumnConverter}}" CellStyle="{StaticResource CenterCellStyleFGSimple}"/>
                    <DataGridTextColumn Header="HE18" Width="35*"  Binding="{Binding he18Value,ConverterCulture=en-US,Converter={StaticResource textColumnConverter}}" CellStyle="{StaticResource CenterCellStyleFGSimple}"/>
                    <DataGridTextColumn Header="HE19" Width="35*"  Binding="{Binding he19Value,ConverterCulture=en-US,Converter={StaticResource textColumnConverter}}" CellStyle="{StaticResource CenterCellStyleFGSimple}"/>
                    <DataGridTextColumn Header="HE20" Width="35*"  Binding="{Binding he20Value,ConverterCulture=en-US,Converter={StaticResource textColumnConverter}}" CellStyle="{StaticResource CenterCellStyleFGSimple}"/>
                    <DataGridTextColumn Header="HE21" Width="35*"  Binding="{Binding he21Value,ConverterCulture=en-US,Converter={StaticResource textColumnConverter}}" CellStyle="{StaticResource CenterCellStyleFGSimple}"/>
                    <DataGridTextColumn Header="HE22" Width="35*"  Binding="{Binding he22Value,ConverterCulture=en-US,Converter={StaticResource textColumnConverter}}" CellStyle="{StaticResource CenterCellStyleFGSimple}"/>
                    <DataGridTextColumn Header="HE23" Width="35*"  Binding="{Binding he23Value,ConverterCulture=en-US,Converter={StaticResource textColumnConverter}}" CellStyle="{StaticResource CenterCellStyleFGSimple}"/>
                    <DataGridTextColumn Header="HE24" Width="35*"  Binding="{Binding he24Value,ConverterCulture=en-US,Converter={StaticResource textColumnConverter}}" CellStyle="{StaticResource CenterCellStyleFGSimple}"/>
                    <DataGridTextColumn Header="Total" Width="35*" Binding="{Binding TotalHourlyValue,ConverterCulture=en-US,Converter={StaticResource textColumnConverter}}" CellStyle="{StaticResource CenterCellStyleFGSimple}"/>
                    <DataGridTextColumn Header="Shift" Width="30*" Binding="{Binding shiftFactor}" Foreground="Black"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <ContentControl prism:RegionManager.RegionName="ContentRegion" />
    </Grid>
</Window>
