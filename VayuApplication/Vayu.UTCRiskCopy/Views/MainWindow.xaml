<Window x:Class="Vayu.UTCRiskCopy.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
          
        xmlns:viewmodels="clr-namespace:Vayu.UTCRiskCopy.ViewModels" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
                 prism:ViewModelLocator.AutoWireViewModel="False"
        Title="Vayu -Risk Copy" Height="330" Width="700">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="300" />
            <ColumnDefinition  Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="80" />
            </Grid.RowDefinitions>
            <GroupBox Grid.Column="0"   Header="Product/Market"  Grid.ColumnSpan="4" BorderBrush="#FF1D1C1C">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="productlist" Margin="2 2 2 0"  Grid.Column="0" Grid.Row="0"									          
									          ItemsSource="{Binding ProductList}"
									          SelectedItem="{Binding SelectedProduct,
                                              Mode=TwoWay}" />
                    <ComboBox x:Name="marketListBox"  
									         Grid.Column="1" Grid.Row="0"	  Margin="2 2 2 0"									         
									          ItemsSource="{Binding MarketList, Mode=TwoWay}" 
									          SelectedItem="{Binding SelectedMarket}" />
                    <ComboBox x:Name="RiskAccount"
									          Grid.Column="2" Grid.Row="0"		 Margin="2 2 2 0"							         
									          ItemsSource="{Binding RiskAcoountList, Mode=TwoWay}" 
									          SelectedItem="{Binding SelectedRiskAcoount}" IsEnabled="{Binding RiskEnabled}"/>
                </Grid>
            </GroupBox>
            <GroupBox Grid.Column="0" Header="Select Dates"  Grid.Row="1"  Grid.ColumnSpan="4" BorderBrush="#FF1D1C1C">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="93*"/>
                        <ColumnDefinition Width="97*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0"	 Margin="5,5,20,15"
								       Content="Start Date" />
                    <DatePicker x:Name="startDatePicker"
								            Grid.Row="0"  Grid.Column="1"    Margin="0 4 4 10"
								            SelectedDate="{Binding StartDate}" 	
								            SelectedDateFormat="Short" SelectedDateChanged="startDatePicker_SelectedDateChanged"  />
                </Grid>
            </GroupBox>
        </Grid>
        <Grid Grid.Column="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Label    Content="Accounts"  HorizontalAlignment="Center" />

            <Label  Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center"
						            Content="Portfolio" Visibility="{Binding PortfolioVisible}" />
            <ListBox x:Name="accountListBox"								         
								         Grid.Row="1" Margin="2" BorderBrush="Black" BorderThickness="1"
								         ItemsSource="{Binding AccountList,
								                               Mode=TwoWay}"
								         SelectedItem="{Binding SelectedAccount}"
								         SelectionChanged="AccountListBox_SelectionChanged"
								         SelectionMode="Multiple" />
            <ListBox x:Name="portfolioListBox"
								          Grid.Row="1" Grid.Column="1" BorderBrush="Black" BorderThickness="1" Margin="2"
								         ItemsSource="{Binding PortfolioList}" Visibility="{Binding isVisible}"
								         SelectionChanged="PortfolioListBox_SelectionChanged"
								         SelectionMode="Multiple" />
        </Grid>
        <Grid Grid.Column="3">
            <Grid.ColumnDefinitions >
                <ColumnDefinition Width="44*"/>
                <ColumnDefinition Width="27*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Button x:Name="portfolioSelectAllButton"  Margin="0 2 0 0"
								         Grid.Column="0" Grid.Row="1"  BorderBrush="Black"
								        Click="portfolioSelectAllButton_Click"
								        Content="Select All" Visibility="{Binding SelectAllVisible}"/>
            <Button x:Name="portfolioUnSelectAllButton"		  Margin="0 2 0 0"			  BorderBrush="Black"			       
								        Grid.Column="0" Grid.Row="2"  
								        Click="portfolioUnSelectAllButton_Click"
								        Content="UnSelect All" Visibility="{Binding UnSelectAllVisible}" />
            <Button x:Name="resetButton" Margin="0 2 0 0"
                 Grid.Column="0" Grid.Row="3"    BorderBrush="Black"
            	Click="resetButton_Click"
            	Command="{Binding ResetCommand}"
            	Content="Reset" />
            <Button  Grid.Column="0" Grid.ColumnSpan="2"  x:Name="CopyButton" Background="LightGreen" FontWeight="Bold" FontSize="15" Margin="4,2,0,1"  BorderBrush="Black" Grid.Row="0"	Content="Copy"    Command="{Binding CopyCommand}"/>
        </Grid>
        <ContentControl prism:RegionManager.RegionName="ContentRegion" />
    </Grid>
</Window>
