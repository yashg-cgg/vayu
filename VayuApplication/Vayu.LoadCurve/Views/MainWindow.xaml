<Window  x:Class="Vayu.LoadCurve.Views.MainWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:prism="http://prismlibrary.com/"
                   xmlns:oxyplot="http://oxyplot.org/wpf" 
                  xmlns:viewmodels="clr-namespace:Vayu.LoadCurve.ViewModels" 
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
                  prism:ViewModelLocator.AutoWireViewModel="False"
                   Title="VAYU- Load Graph" Height="650" Width="auto">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75" />
            <RowDefinition Height="700*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0"
		            Margin="3"
		            Orientation="Horizontal">
            <StackPanel Orientation="Vertical">
                <StackPanel Margin="2" Orientation="Horizontal">
                    <TextBlock Margin="5,4,0,0"
					           VerticalAlignment="Center"
					           Text="Start" />
                    <DatePicker Margin="15,4,0,0" SelectedDate="{Binding FromSelectedDate, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Margin="2" Orientation="Horizontal">
                    <TextBlock Margin="5,4,0,0"
					           VerticalAlignment="Center"
					           Text="End'" />
                    <DatePicker Margin="15,4,0,0" SelectedDate="{Binding EndSelectedDate, Mode=TwoWay}" />
                </StackPanel>

            </StackPanel>
            <StackPanel Orientation="Vertical">
                <ComboBox Width="180"
				          Height="25"
				          Margin="8,3,0,0"
				          VerticalContentAlignment="Center"
				          IsEditable="True"
				          ItemsSource="{Binding ZoneList}"
				          SelectedItem="{Binding ZoneSelectedItem,
				                                 Mode=TwoWay}" />
                <Button Width="180"
				        Height="27"
				        Margin="8,4,0,0"
				        Command="{Binding RefreshCommand}"
				        Content="Refresh" />
            </StackPanel>
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="Current" IsChecked="{Binding CURRENTChecked, Mode=TwoWay}" />
                    <CheckBox Content="ISO" IsChecked="{Binding ISOChecked, Mode=TwoWay}" />

                    <CheckBox Content="DA" IsChecked="{Binding DAChecked, Mode=TwoWay}" />

                    <StackPanel.Resources>
                        <Style TargetType="CheckBox">
                            <Setter Property="Margin" Value="25,10,0,0" />
                        </Style>
                    </StackPanel.Resources>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="H ISO" IsChecked="{Binding HISOChecked, Mode=TwoWay}" Margin="25,10,0,0" />
                            <CheckBox Content="F ISO" IsChecked="{Binding FISOChecked, Mode=TwoWay}" Margin="34,10,0,0" />

                            <CheckBox Content="H DA" IsChecked="{Binding HDAChecked, Mode=TwoWay}" Margin="16,10,0,0"/>

                        </StackPanel>
                    </StackPanel>


                </StackPanel>

            </StackPanel>
            <StackPanel Orientation="Vertical" Height="57" VerticalAlignment="Top">
                <GroupBox Header="Frozen" Margin="10,0,0,0" Height="55">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="5" IsChecked="{Binding FiveFrozenChecked,Mode=TwoWay}"></RadioButton>
                        <RadioButton Content="11" IsChecked="{Binding ElevenFrozenChecked,Mode=TwoWay}"></RadioButton>
                        <CheckBox Content="ISO Forecast" IsChecked="{Binding ISOForecastFrozenChecked, Mode=TwoWay}" />
                        <StackPanel.Resources>
                            <Style TargetType="CheckBox">
                                <Setter Property="Margin" Value="10,5,0,0" />
                            </Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="Margin" Value="10,5,0,0" />
                            </Style>
                        </StackPanel.Resources>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="10,20,0,30" Width="170">
                <StackPanel Orientation="Horizontal" >
                    <TextBlock Text="Update Time:" ToolTip="Updated only on Callback" />
                    <TextBlock Margin="5,0,0,0" Text="{Binding UpdateTime, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <oxyplot:PlotView Grid.Row="1"
		          Height="Auto"
		          Margin="0,2,10,4"
		          VerticalContentAlignment="Stretch"
		          Background="Black"
		          BorderBrush="Gray"
		          BorderThickness="1"
		          Model="{Binding PlotDataModel}" />
        <ContentControl prism:RegionManager.RegionName="ContentRegion" />
    </Grid>
</Window>
