<Window x:Class="Vayu.CRRAuction.Views.MainWindow"
                          
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="False"
        Width="800"
        Height="Auto"
        Title="LTC Auction Schedule" >
    <Grid x:Name="LayoutRoot">
       
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Margin="5,6,0,0"
			           HorizontalAlignment="Center"
			           Text="Market:" />
            <ComboBox Width="70"
			          Height="25"
			          Margin="15,2,0,0"
			          ItemsSource="{Binding MarketList,
			                                Mode=TwoWay}"
			          SelectedItem="{Binding MarketSelectedItem}" />
        </StackPanel>
        <DataGrid Grid.Row="1"
		          Margin="5,10,0,0"
		          AlternatingRowBackground="LightGray"
		          AutoGenerateColumns="False"
		          CanUserAddRows="False"
		          IsReadOnly="True"
		          ItemsSource="{Binding AuctionList}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOld}" Value="true">
                            <Setter Property="Foreground" Value="Red" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsOld}" Value="false">
                            <Setter Property="Foreground" Value="Black" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Resources>
                <Style x:Key="headerStyle" TargetType="DataGridColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
                <Style x:Key="cellStyle" TargetType="DataGridCell">
                    <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn HeaderStyle="{StaticResource headerStyle}" CellStyle="{StaticResource cellStyle}"
                                    Width="8*" Binding="{Binding FTRAuctionKey}" 
				                    Header="Key"/>
                <DataGridTextColumn Width="20*"  HeaderStyle="{StaticResource headerStyle}" CellStyle="{StaticResource cellStyle}"
				                    Binding="{Binding FTRAuctionName}"
				                    Header="Name"/>
                <DataGridTextColumn  HeaderStyle="{StaticResource headerStyle}" Width="10*" CellStyle="{StaticResource cellStyle}"
                                    Binding="{Binding FTRAuctionPeriod}"
                                    Header="Period"/>
                <DataGridTextColumn Width="6*"  HeaderStyle="{StaticResource headerStyle}" CellStyle="{StaticResource cellStyle}"
				                    Binding="{Binding AuctionRound}"
				                    Header="Round"/>
                <DataGridTextColumn Width="10*" HeaderStyle="{StaticResource headerStyle}" CellStyle="{StaticResource cellStyle}"
				                    Binding="{Binding CreditPostedDate,StringFormat=d}"
				                    Header="Credit Posted"/>
                <DataGridTextColumn Width="10*" HeaderStyle="{StaticResource headerStyle}" CellStyle="{StaticResource cellStyle}"
				                    Binding="{Binding AuctionStartDate, StringFormat=d}"                                                                  
				                    Header="Start"/>
                <DataGridTextColumn Width="10*" HeaderStyle="{StaticResource headerStyle}" CellStyle="{StaticResource cellStyle}"
				                    Binding="{Binding AuctionEndDate, StringFormat=d}"				                                     
				                    Header="End"/>
                <DataGridTextColumn Width="10*" HeaderStyle="{StaticResource headerStyle}" CellStyle="{StaticResource cellStyle}"
				                    Binding="{Binding ResultPostedDate,StringFormat=d}"
				                    Header="Results"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
