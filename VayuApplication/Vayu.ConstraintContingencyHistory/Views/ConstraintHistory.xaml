<Window     x:Class="Vayu.ConstraintContingencyHistory.ViewModels.ConstraintHistory"
                    
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:prism="http://prismlibrary.com/"
                     xmlns:local="clr-namespace:Vayu.ConstraintContingencyHistory.Views" 
                     xmlns:pc="clr-namespace:Vayu.ConstraintContingencyHistory.ViewModels"
                     prism:ViewModelLocator.AutoWireViewModel="False"
                     Title="Constraint History" Height="570" Width="1600" >
    <Window.Resources>
        <ResourceDictionary>
            <local:CurrencyColorConverter x:Key="c2c" />
            <pc:InverseBooleanToVisibilityConverter x:Key="InvertBoolConverter" />
            <BooleanToVisibilityConverter x:Key="b2v" />
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="LayoutRoot" Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="75" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0"
		            Margin="0,10,0,0"
		            Orientation="Horizontal">
            <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                <TextBlock Name="ConstraintSearch" Width="60" Margin="5,25,0,0" Text="Constraint" />
                <TextBox Width="700" Height="25" Margin="03,0,10,0" TextAlignment="Left" VerticalContentAlignment="Center" IsReadOnly="True" Text="{Binding ConstraintItem}"></TextBox> 
            </StackPanel>
            <Button x:Name="ExportButton"
				        Width="130" 
				        Height="30" BorderThickness="1" Background="LightGreen" BorderBrush="Black"
				        Margin="15,0,0,0"
				        Command="{Binding ExporttoExcelCommand}"
				        Content="Export To CSV" />
        </StackPanel>
        <DataGrid x:Name="constraintDataGrid"
		          Grid.Row="1"
		          Margin="0,2,0,0"
		          HorizontalAlignment="Stretch"
		          VerticalAlignment="Stretch"
		          AlternatingRowBackground="LightGray"
		          AreRowDetailsFrozen="True"
		          AutoGenerateColumns="False"
		          CanUserAddRows="False"
		          FontFamily="Microsoft Sans Serif, 8.25pt"
		          FontWeight="ExtraLight"
		          ItemsSource="{Binding HistoryConstraintList}"
		          SelectedItem="{Binding SelectedConstraint,
		                                 Mode=TwoWay}"
		          SelectionMode="Single"
		          SelectionUnit="Cell"
		          VirtualizingStackPanel.IsVirtualizing="True"
		          VirtualizingStackPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTextColumn Width="45*"
				                    Binding="{Binding ConstraintDate,
				                                      StringFormat={}{0:MM/dd/yy}}"
				                    CanUserReorder="False"
				                    Header="Date"
				                    IsReadOnly="True" />
                <DataGridTextColumn Width="250*"
				                    Binding="{Binding ConstraintText}"
				                    CanUserReorder="False"
				                    Header="Constraint"
				                    IsReadOnly="True" 
                                    Visibility="{Binding isConstraintChecked , Converter= {StaticResource InvertBoolConverter}}" />
                <DataGridTextColumn Width="150*"
				                    Binding="{Binding ContingencyText}"
				                    CanUserReorder="False"
				                    Header="Contingency"
				                    IsReadOnly="True"
                                    Visibility="{Binding isConstraintChecked}"/>
                <DataGridTemplateColumn Width="30*">
                    <DataGridTemplateColumn.Header>
                        <TextBlock>1</TextBlock>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="{Binding HE1, Converter={StaticResource c2c}}" Text="{Binding HE1, StringFormat=0}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="30*">
