<Window  x:Class="Vayu.ConstraintContingencyHistory.Views.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:my1="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls.Input.Toolkit"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:Vayu.ConstraintContingencyHistory.Views"
                  xmlns:pc="clr-namespace:Vayu.ConstraintContingencyHistory.Views" 
        xmlns:prism="http://prismlibrary.com/" xmlns:pc1="clr-namespace:Vayu.ConstraintContingencyHistory.ViewModels"
                  prism:ViewModelLocator.AutoWireViewModel="False" Background="AliceBlue"
        Title="Historical Constraints" Height="570" Width="1700">
    <Window.Resources>
        <ResourceDictionary>
            <local:CurrencyColorConverter x:Key="c2c" />
            <pc1:InverseBooleanToVisibilityConverter x:Key="InvertBoolConverter" />
            <BooleanToVisibilityConverter x:Key="b2v" />
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="LayoutRoot" Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="530*"/>
            <ColumnDefinition Width="193*"/>
            <ColumnDefinition Width="251*"/>
            <ColumnDefinition Width="718*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="89" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Grid.Column="0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="82"/>
                <ColumnDefinition Width="45"/>
                <ColumnDefinition Width="45"/>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="80*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition />
            </Grid.RowDefinitions>
            <GroupBox  BorderBrush="#FF1D1C1C"  Grid.Row="0" Grid.Column="0" Header="Market" Grid.RowSpan="2" >

                <ComboBox Grid.Row="1" Grid.Column="0" Margin="1 4 4  1" ItemsSource="{Binding MarketList,
				                               Mode=TwoWay }" SelectedItem="{Binding MarketSelected,
				                                 Mode=TwoWay}" SelectionChanged="ComboBox_SelectionChanged" x:Name="marketname"/>
            </GroupBox>
            <GroupBox Grid.Row="0"  BorderBrush="#FF1D1C1C" Grid.RowSpan="2" Grid.Column="1" 
                Header="MarketType"  Grid.ColumnSpan="2" >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="rtRadioBtn"  Margin="2 2 2 2 " Content="RT" IsChecked="{Binding RTChecked, Mode=TwoWay}"/>
                    <RadioButton x:Name="DARadiobtn" Grid.Column="1" Content="DA" IsChecked="{Binding DAChecked, Mode=TwoWay}"/>
                </Grid>
            </GroupBox>
            <GroupBox Width="300" Grid.Row="0" Grid.Column="3" Grid.RowSpan="2"  Grid.ColumnSpan="2"
			           
			          Margin="0,0,0,0"
			         
			          BorderBrush="#FF1D1C1C"
			          Header="Date">
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="DateRangeCheckBox"
					          Margin="2,10,2,0"
					          Content="Range?"
					          IsChecked="{Binding DateRangeCheckBoxChecked,
					                              Mode=TwoWay}" />
                    <StackPanel>

                        <DatePicker Width="100"
					            Margin="2,10,2,2"
					            SelectedDate="{Binding FromDate,
					                                   Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel>

                        <DatePicker Width="100"
					            Margin="2,10,2,2"
					            SelectedDate="{Binding ThroDate,
					                                   Mode=TwoWay}" IsEnabled="{Binding ThroDateEnable}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </Grid>
        <Grid Grid.Row="0" Grid.Column="1" Background="Azure" Grid.ColumnSpan="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="781*"/>
                    <ColumnDefinition Width="881*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <GroupBox Header="Constraint details" Grid.RowSpan="2"  BorderBrush="#FF1D1C1C" Margin="0,0,5,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Search By:" Grid.Column="0" HorizontalAlignment="Center"/>
                        <RadioButton x:Name="CntRadioBtn" Grid.Column="0" Margin="2 15 2 2 " Content="Const &#xa; raint" IsChecked="{Binding ConstraintChecked, Mode=TwoWay}"/>
                        <RadioButton x:Name="CnyRadiobtn" Grid.Column="0" Margin="80 15 2 2" Content="Contin &#xa;gency" IsChecked="{Binding ContingencyChecked, Mode=TwoWay}"/>
                        <!--<TextBlock Text="Constraint" Grid.Column="1"  HorizontalAlignment="Center"/>-->
                        <my1:AutoCompleteBox x:Name="ConstraintSearchBox" Grid.Column="1"   Margin="2,20,0,-2" IsEnabled="True" IsDropDownOpen="True" VerticalAlignment="Top" SelectionChanged="SelectionChanged_Con" SelectedItem="{Binding SelectedConstraintItem}"  Text="{Binding SearchTypedText, Mode=TwoWay}" FilterMode="Contains"  ItemsSource="{Binding ConstraintSearchList}" MaxDropDownHeight="150" Height="35" />
                        <!--<TextBlock x:Name="ContingencySearch" Grid.Column="2" HorizontalAlignment="Center" Text="Contingency" />-->
                        <ComboBox x:Name="ContingencySearchBox" Grid.Column="2" Margin="2,20,0,-2" IsTextSearchEnabled="True" IsTextSearchCaseSensitive="False" ItemsSource="{Binding ContingencySearchList}" SelectedValue="{Binding SelectedContengencyItem}" />
                    </Grid>

                </GroupBox>
                <Grid Grid.Column="1"  Grid.RowSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96*"/>
                        <ColumnDefinition Width="95*"/>
                        <ColumnDefinition Width="490*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Button  x:Name="RefreshButton"
				        Margin=" 2 2 2 2"
				        Command="{Binding RefreshCommand}"
				        Content="Refresh" Background="#007EFE"
				        IsEnabled="{Binding IsRefreshEnabled}" Click="RefreshButton_Click" RenderTransformOrigin="0.5,0.5"  >
                        <Button.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="1.228"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Button.RenderTransform>
                    </Button>
                    <Button x:Name="CLearButton" Grid.Row="1"  
				         Margin="2,2,2,1.5" Background="#E74D4D"
				        Command="{Binding ClearCommand}"
				        Content="Clear" />
                    <Button x:Name="PasteButton" 
				         Grid.Column="1" Background="#00BB00"
				        Margin="2,2,2,2"
				        Command="{Binding PasteCommand}"
				        Content="Paste" Click="PasteButton_Click" />
                    <Button x:Name="ExportButton"
				        Grid.Column="1" Grid.Row="1" Background="LightGreen"
				         Margin="2,2,2,1.5"
				        Command="{Binding RunExportCSVCommand}"
				        Content="ExportToCSV" />


                </Grid>
                <GroupBox Header="Frequency"  Grid.Column="2"   BorderBrush="#FF1D1C1C" Grid.RowSpan="2" Width="230px" Height="87px">


                    <Grid Margin="0,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Label x:Name="WinterFrequencyButton"  Grid.Row="0" Grid.Column="0"     Width="45"    Height="23"   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"  Content="Winter" />

                        <Label x:Name="SpringFrequencyLabel"   Grid.Row="1" Grid.Column="0"      Width="45"     Height="28"   HorizontalAlignment="Left"
                           VerticalAlignment="Top"   Content="Spring" />

                        <Label x:Name="SummerFrequencyButton"   Grid.Row="0" Grid.Column="2"      Width="55"      Height="23"   HorizontalAlignment="Left"
				               VerticalAlignment="Top"  Content="Summer" />

                        <Label x:Name="FallFrequencyButton"   Grid.Row="1" Grid.Column="2"        Width="55"       Height="23"   HorizontalAlignment="Left"
				              VerticalAlignment="Top"     Content="Fall" />

                        <TextBox   Grid.Row="0" Grid.Column="1" Height="4" Width="50px"  VerticalAlignment="Center" Text="{Binding WinterFrequency}" RenderTransformOrigin="0.5,0.5"  BorderBrush="Black" BorderThickness="1">
                            <TextBox.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleY="-1"/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </TextBox.RenderTransform>
                        </TextBox>
                        <TextBox  Grid.Row="1" Grid.Column="1" Height="4" Width="50px"  VerticalAlignment="Center" Text="{Binding SpringFrequency}" BorderBrush="Black" BorderThickness="1"/>
                        <TextBox  Grid.Row="0" Grid.Column="3"  Width="50px"  VerticalAlignment="Center" Text="{Binding SummerFrequency}"  BorderBrush="Black" BorderThickness="1"/>
                        <TextBox   Grid.Row="1" Grid.Column="3" Width="50px"  VerticalAlignment="Center" Text="{Binding  FallFrequency  }" RenderTransformOrigin="0.468,0.542"  BorderBrush="Black" BorderThickness="1"/>

                    </Grid>
                </GroupBox>
            </Grid>

        </Grid>
        <DataGrid x:Name="constraintDataGrid"
		          Grid.Row="1"
		          Margin="1,15,5,2" BorderThickness="1" 
		          HorizontalAlignment="Stretch" 
		          VerticalAlignment="Stretch"  
		          AlternatingRowBackground="LightGray"
		          AreRowDetailsFrozen="True"
		          AutoGenerateColumns="False"
		          CanUserAddRows="False"
		          FontFamily="Microsoft Sans Serif, 8.25pt"
		          FontWeight="ExtraLight"
		          ItemsSource="{Binding ConstraintList}"
		          SelectedCellsChanged="constraintDataGrid_SelectedCellsChanged"
                  PreviewMouseLeftButtonDown="constraintDataGrid_PreviewMouseLeftButtonDown"
		          SelectedItem="{Binding SelectedConstraint,
		                                 Mode=TwoWay}"
		          SelectionMode="Single"
		          SelectionUnit="Cell"
		          VirtualizingStackPanel.IsVirtualizing="True"
		          VirtualizingStackPanel.VirtualizationMode="Recycling" Grid.ColumnSpan="4"
                  >

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="{Binding HourDetailsCommand}" Header="Hour Details" />
                    <MenuItem Header="Uptos Export 5 Min Prices" Command="{Binding ExportFiveMinPricesCmd}" />
                    <MenuItem Header="Ercot Sensitivities" Command="{Binding AllErcotShiftFactors}" IsEnabled="{Binding isErcotEnabled , Mode=TwoWay}" />
                    <!--<MenuItem Name="ConstHistory" Header="ConstraintHistory" Command="{Binding ConstraintHistory}" Click="ConstHistory_Click"  />-->
                    <MenuItem  Header="ConstraintRTHistory" Command="{Binding ConstraintRTHistory}"   />
                    <MenuItem  Header="ConstraintDAHistory" Command="{Binding ConstraintDAHistory}"   />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Width="50*"
				                    Binding="{Binding ConstraintDate, StringFormat={}{0:MM/dd/yy}}"
				                    CanUserReorder="False"
				                    Header="Date"
				                    IsReadOnly="True" />
                <DataGridTextColumn Width="230*"
				                    Binding="{Binding ConstraintText}"
				                    CanUserReorder="False"
				                    Header="Constraint"
				                    IsReadOnly="True" 
                                    Visibility="{Binding isConstraintChecked, Converter= {StaticResource InvertBoolConverter}}" />
                <!--
					<DataGridTemplateColumn Header="Monitored Facility" Visibility="{Binding IsSpp, Converter={StaticResource b2v}}">
					<DataGridTemplateColumn.CellTemplate>
					<DataTemplate>
					<TextBlock Text="{Binding MonitoredFacility}" />
					</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				-->
                <!--<DataGridTextColumn Width="60*"
				                    Binding="{Binding MonitoredFacility}"
				                    CanUserReorder="False"
				                    Header="Monitored Facility"
				                    IsReadOnly="True"
				                      />-->
                <DataGridTextColumn Width="80*"
				                    Binding="{Binding ContingencyText}"
				                    CanUserReorder="False"
				                    Header="Contingency"
				                    IsReadOnly="True"
                                    Visibility="{Binding isConstraintChecked}"/>
                <DataGridTextColumn Width="68*"
				                    Binding="{Binding SourceZone}"
				                    CanUserReorder="False"
				                    Header="SourceZone"
				                    IsReadOnly="True"/>
                <DataGridTextColumn Width="68*"
				                    Binding="{Binding SinkZone}"
				                    CanUserReorder="False"
				                    Header="SinkZone"
				                    IsReadOnly="True"/>
                <DataGridTextColumn Width="50*"
				                    Binding="{Binding MaxLoad}"
				                    CanUserReorder="False"
				                    Header="MaxLoad"
				                    IsReadOnly="True"
                                    Visibility="{Binding isConstraintChecked}"/>
                <DataGridTextColumn Width="35*"
				                    Binding="{Binding Price,StringFormat=0}"
				                    CanUserReorder="False"
				                    Header="Avg"
				                    IsReadOnly="True"
                                    Visibility="{Binding isConstraintChecked}"/>
                <DataGridTextColumn Width="50*"
				                    Binding="{Binding MaxShadowPrice,StringFormat=0}"
				                    CanUserReorder="False"
				                    Header="MaxShadowPrice"
				                    IsReadOnly="True" />
                <DataGridTextColumn Width="50*"
