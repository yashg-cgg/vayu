<Window  x:Class="Vayu.CRRPathAnalyzer.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   
                 xmlns:oxyplot="http://oxyplot.org/wpf" 
                 xmlns:util="clr-namespace:Vayu.CommonControls;assembly=Vayu.CommonControls"
                 xmlns:bingMap="clr-namespace:Microsoft.Maps.MapControl.WPF;assembly=Microsoft.Maps.MapControl.WPF"
                 xmlns:GridLines="clr-namespace:Vayu.CommonControls;assembly=Vayu.CommonControls"
                 xmlns:Behaviours="clr-namespace:Vayu.CommonControls;assembly=Vayu.CommonControls"
                 xmlns:oxy="http://oxyplot.org/wpf"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:prism="http://prismlibrary.com/"
                 xmlns:local="clr-namespace:Vayu.CRRPathAnalyzer.Views"
                 prism:ViewModelLocator.AutoWireViewModel="False"
                 Title="LTC Path Analyzer" Height="1003" Width="1683">
 
    <Window.Resources>
        <ResourceDictionary>
            <local:DataGridCellForeColorConverterSimple x:Key="myFGColorSimple" />
            <local:TextBlockForeColorConverter x:Key="myTBFGColor" />
            <local:TextBlockBackColorConverter x:Key="myTBBGColor" />
            <local:DataGridCellForeColorConverter x:Key="myFGColor" />
            <local:DataGridCellBackColorConverter x:Key="myBGColor" />
            <local:LocationsViewConverter x:Key="LocationsViewConverter" />
            <Style x:Key="HeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="22" />
            </Style>
            <ControlTemplate x:Key="squareShape">
                <Rectangle Width="10" Height="10" Fill="{Binding Path=., Converter={StaticResource V2SC}}" Stroke="Black" StrokeThickness="0.8" Margin="-5,-5,0,0"/>
            </ControlTemplate>
            <ControlTemplate x:Key="circleWithStrokeShape">
                <Ellipse Stroke="Black" StrokeThickness="0.8" Width="5" Height="5" Margin="-5,-5,0,0" Fill="{Binding Path=., Converter={StaticResource V2SC}}"/>
            </ControlTemplate>
            <ControlTemplate x:Key="starShape">
                <Polygon Fill="{Binding Path=., Converter={StaticResource V2SC}}" Stroke="Black" StrokeThickness="0.8" Points="3.52671151375484,4.85410196624968 2.85316954888546,0.927050983124842 5.70633909777092,-1.85410196624968 1.76335575687742,-2.42705098312484 7.34763812293426E-16,-6 -1.76335575687742,-2.42705098312484 -5.70633909777092,-1.85410196624969 -2.85316954888546,0.927050983124842 -3.52671151375484,4.85410196624968 -7.34763812293426E-16,3"/>
            </ControlTemplate>
            <ControlTemplate x:Key="TriangleShape">
                <Polygon Fill="{Binding Path=., Converter={StaticResource V2SC}}" Stroke="Black" StrokeThickness="0.8" Points="5.19615242270663,-3 -5.19615242270663,-3 -1.46952762458685E-15,6" />
            </ControlTemplate>
            <ControlTemplate x:Key="DiamondShape">
                <Polygon Fill="{Binding Path=., Converter={StaticResource V2SC}}" Stroke="Black" StrokeThickness="0.8" Points="0,5.5 5.5,0 0,-5.5 -5.5,0" />
            </ControlTemplate>
            <Style x:Key="lmpStyle" TargetType="bingMap:Pushpin">
                <Setter Property="Template" Value="{StaticResource circleWithStrokeShape}"></Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding TypeName}" Value="GENERATOR">
                        <Setter Property="Template" Value="{StaticResource starShape}"></Setter>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding TypeName}" Value="LOAD">
                        <Setter Property="Template" Value="{StaticResource TriangleShape}"></Setter>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding TypeName}" Value="EHV">
                        <Setter Property="Template" Value="{StaticResource DiamondShape}"></Setter>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding TypeName}" Value="INTERFACE">
                        <Setter Property="Template" Value="{StaticResource squareShape}"></Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="CenterCellStyle" TargetType="{x:Type DataGridCell}">
                <Setter Property="Foreground">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource myFGColor}">
                            <Binding Path="DataContext.SpreadHeatMapFactorsAbove" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Window}}" />
                            <Binding Path="DataContext.SpreadHeatMapFactorsBelow" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Window}}" />
                            <Binding RelativeSource="{RelativeSource Self}" />
                            <Binding Path="." />
                            <Binding Path="Content.Text" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
                <Setter Property="Background">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource myBGColor}">
                            <Binding Path="DataContext.SpreadHeatMapFactorsAbove" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Window}}" />
                            <Binding Path="DataContext.SpreadHeatMapFactorsBelow" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Window}}" />
                            <Binding RelativeSource="{RelativeSource Self}" />
                            <Binding Path="." />
                            <Binding Path="Content.Text" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
                <Setter Property="Margin" Value="0,0,0,0" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                            <Grid Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="DarkBlue" />
                        <Setter Property="BorderBrush" Value="PaleTurquoise" />
                        <Setter Property="Background" Value="PaleTurquoise" />
                    </Trigger>
                    
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Background" Value="DodgerBlue" />
                        <Setter Property="BorderBrush" Value="Blue" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="TabItem" x:Key="TabItemHeaderStyle">
                <Setter Property="Background" Value="LightBlue"/>
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="FontSize" Value="14px" />

                <!-- Add more setters for other properties as needed -->
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="250"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="450*"/>
                <ColumnDefinition Width="350*"/>
                <ColumnDefinition Width="200*"/>
                <ColumnDefinition Width="300*"/>
                <ColumnDefinition Width="150*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35*" />
                    <RowDefinition Height="62*" />
                    <RowDefinition Height="30*"/>
                    <RowDefinition  Height="55*"/>
                    <RowDefinition Height="53*" />
                    <RowDefinition Height="0*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <DatePicker Name="StartDatePicker" BorderThickness="1" BorderBrush="Black" Margin="10 5 2 2"
				            Grid.Column="0" 
				            SelectedDate="{Binding StartDate}"
				            SelectedDateFormat="Short" />
                <DatePicker Name="EndDatePicker" BorderThickness="1" BorderBrush="Black" Margin="10 5 2 2"
				             Grid.Column="1"
				            SelectedDate="{Binding EndDate}"
				            SelectedDateFormat="Short" />
                <ComboBox Name="marketComboBox"
		              Grid.Column="2" BorderThickness="1" BorderBrush="Black" Margin="10 5 15 2"
		              ItemsSource="{Binding ISOMarketList}"
		              SelectedValue="{Binding Path=MarketComboSelectedValue, Mode=TwoWay}" />
                <GroupBox Grid.Row="1" Grid.ColumnSpan="3" Header="Hours" Margin="0,0,0,1">
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>

                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <RadioButton 
				             Content="PeakWD"
				             FontWeight="Normal"  Grid.Column="0"  Width="auto"
				             GroupName="RTDA"
                             IsChecked="{Binding OnPeakChecked}"/>
                        <RadioButton 
				             Content="OFFPEAK" Grid.Column="1"   Margin="1 0 0 0"
				             FontWeight="Normal"
				             GroupName="RTDA"
                             IsChecked="{Binding OffPeakChecked}"  />
                        <RadioButton
				             Content="PEAKWE" Grid.Column="2" Margin="2 0 0 0"
                            HorizontalContentAlignment="Right"
				             FontWeight="Normal"
				             GroupName="RTDA" 
                             IsChecked="{Binding PeakWE}"/>
                        <RadioButton
				             Content="24H " Grid.Column="3"
                             Margin="6 0 0 0 "  Width="auto"
				             FontWeight="Normal" 
				             GroupName="RTDA"  
                             IsChecked="{Binding Hour24Checked}"/>
                        <Button x:Name="updateButton" Content="Refresh" Margin="0 0 2 0 "    Background="#3da3ff" Grid.Column="4" Click="Refresh_Click" Command="{Binding RunRetrieveFetchDataAndUpdateChartCommand}" FontSize="10" />
                        <Button Name="ResetButton" Grid.Column="5"
		                Command="{Binding ResetCommand}" Content="Reset"     FontSize="10" />
                    </Grid>
                </GroupBox>
                <Grid Grid.Row="2" Grid.ColumnSpan="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <RadioButton Content="RT" Grid.Column="0" Margin="2"
					          IsChecked="{Binding FilterDayComparisonRTChecked,Mode=TwoWay}" />
                    <RadioButton Content="DA" Grid.Column="1" Margin="2"
					          IsChecked="{Binding FilterDayComparisonDAChecked,Mode=TwoWay}" />
                    <RadioButton Content="CRR"  Grid.Column="2" Margin="2"
					          IsChecked="{Binding FilterDayComparisonCrrChecked,Mode=TwoWay}" />
                    <RadioButton Content="DA-CRR"  Grid.Column="3" Margin="-3"
					          IsChecked="{Binding FilterDayComparisonDACrrChecked,Mode=TwoWay}" />
                    <ComboBox Name="SpreadComboBox" Grid.Column="4"     Margin="3"
					          ItemsSource="{Binding SpreadComboList}"
					          SelectedValue="{Binding Path=SpreadComboSelectedValue,Mode=TwoWay}" />
                    
                    <Button  Grid.Column="5" Margin="2" Content="Paste" Click="Paste_Click" Background="#ffc107" Command="{Binding PasteCommand}" />
                </Grid>
                <Grid Grid.Row="3" Grid.ColumnSpan="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Header="Summary Period" >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <RadioButton 
				             HorizontalAlignment="Left"
				             Content="Daily"
				             GroupName="DailyMonthly"
				             IsChecked="{Binding DailyChecked}"   />
                            <RadioButton 
				             
				             HorizontalAlignment="Left"
				             Content="Monthly"
				             GroupName="DailyMonthly"
				             IsChecked="{Binding MonthlyChecked}" Grid.Column="1"/>
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="Hedge Type" Grid.Column="1">
                        <ComboBox Name="hedgetype"	Margin="0 0 0 2"		          
					          ItemsSource="{Binding HedgeComboList}"
					          SelectedValue="{Binding Path=HedgeComboSelectedValue,Mode=TwoWay}" />
                    </GroupBox>
                    <Button Grid.Column="3" Margin="10" Content="Load" Command="{Binding LoadCommand}" Background="#198754"/>
                </Grid>
                <Grid Grid.Row="4" Grid.ColumnSpan="3" >
                    <GroupBox Name="summaryGB"  
			          BorderBrush="#FF1D1C1C"
			          Header="Summary"  >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Name="cbTotal"
					         Grid.Column="0"
					          Content="Total"
					          IsChecked="{Binding ShowSummaryTotal,
					                              Mode=TwoWay}" />
                            <CheckBox Name="cbAvg"
					          Grid.Column="1"
					          Content="Avg"
					          IsChecked="{Binding ShowSummaryAvg,
					                              Mode=TwoWay}" />
                            <CheckBox Name="cbMinPct"
					          Grid.Column="2"
					          Content="Min"
					          IsChecked="{Binding ShowSummaryMin,
					                              Mode=TwoWay}" />
                            <CheckBox Name="cbMaxPct"
					          Grid.Column="3"
					          Content="Max"
					          IsChecked="{Binding ShowSummaryMax,
					                              Mode=TwoWay}" />
                            <CheckBox Name="cbWinPct"
					          Grid.Column="4"
					          Content="Win %"
					          IsChecked="{Binding ShowSummaryWin,
					                              Mode=TwoWay}" />
                            <CheckBox 
					          Grid.Column="5"
					          Content="Risk"
					          IsChecked="{Binding ShowSummaryRisk,
					                              Mode=TwoWay}" />
                        </Grid>
                    </GroupBox>
                </Grid>
            </Grid>
            <GroupBox Grid.Column="1" Header="Source/Sink" Margin="0 1 0 0"  >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Name="sourceComboBox"
				           Grid.Column="0" Margin="0 0 0 2"
				          DisplayMemberPath="NodeName"
				          GotFocus="sourceComboBox_GotFocus"
				          IsEditable="True"
				          IsTextSearchEnabled="True"
				          ItemsSource="{Binding SourceNodeList}"
				          SelectedValue="{Binding SourceComboSelectedItem}" >
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>
                    <ComboBox Name="sinkComboBox"
				           Grid.Column="1" Margin="0 0 0 2"
				          DisplayMemberPath="NodeName"
				          GotFocus="sinkComboBox_GotFocus"
				          IsEditable="True"
				          IsTextSearchEnabled="True"
				          ItemsSource="{Binding SinkNodeList}"
				          SelectedValue="{Binding SinkComboSelectedItem}" >
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>
                    <Grid Grid.Row="1" Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Name="addSourceSinkButton" Margin="0 0 2 0"
				        Command="{Binding AddSourceSinkCommand}" Background="#198754"
                                Click="Add_Click" Grid.Column="0"
				        Content="Add"/>
                        <Button Name="removeSourceSinkButton"  Grid.Column="1" Background="#91b7f1"
				        Command="{Binding RemoveSourceSinkCommand}" Margin="0 0 2 0"
                                Click="Remove_Click"
				        Content="Remove" />
                        <Button Name="removeAllSourceSinkButton" Grid.Column="2" Margin="0 0 2 0"
				        Command="{Binding RemoveAllSourceSinkCommand}" Background="#0dcaf0"
                                Click="RemoveALl_Click"
				        Content="Remove All" />
                        <Button Name="SwapButton" Grid.Column="3" 
				        Command="{Binding SwapCommand}"
				        Content="Swap" />
                    </Grid>
                    <DataGrid Name="sourceSinkDataGrid" Background="Azure"
				          Grid.Row="2" Grid.ColumnSpan="2"
				          HorizontalAlignment="Stretch"
				          VerticalAlignment="Stretch"
				          AutoGenerateColumns="False"
				          CanUserAddRows="False"
				          CanUserReorderColumns="False" Margin="1"
				          CanUserResizeRows="False"
                              BorderThickness="1" BorderBrush="Black"
				          IsReadOnly="True"
                         ScrollViewer.CanContentScroll="True" 
                        ScrollViewer.VerticalScrollBarVisibility="Visible"
				          ItemsSource="{Binding SourceSinkList,
				                                Mode=TwoWay}"
				          SelectedValue="{Binding Path=SourceSinkDataSelected}"
				          SelectionChanged="sourceSinkDataGrid_SelectionChanged"
				          SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*"
						                    Binding="{Binding Source}"
						                    CanUserReorder="False"
						                    Header="Source" />
                            <DataGridTextColumn Width="*"
						                    Binding="{Binding Sink}"
						                    CanUserReorder="False"
						                    Header="Sink" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
            <GroupBox Name="groupBox14"
				          Grid.Column="2"  
				          BorderBrush="#FF1D1C1C"
				          Header="Months"  >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="35*"/>
                        <RowDefinition Height="35*"/>
                        <RowDefinition Height="40*"/>
                        <RowDefinition Height="40*"/>
                        <RowDefinition Height="40*"/>
                    </Grid.RowDefinitions>
                    <CheckBox Name="JanCheckBox"
						          Grid.Row="0" Grid.Column="0"
						          Content="Jan"
						          IsChecked="{Binding JanChecked,
						                              Mode=TwoWay}"   />
                    <CheckBox Name="FebCheckBox"
						          Grid.Row="0" Grid.Column="1" 
						          Content="Feb"
						          IsChecked="{Binding FebChecked,
						                              Mode=TwoWay}"   />
                    <CheckBox Name="MarCheckBox"
						          Grid.Row="0" Grid.Column="2"  Content="Mar"
						          IsChecked="{Binding MarChecked,  Mode=TwoWay}"   />
                    <CheckBox Name="AprCheckBox"
						          Grid.Row="1" Grid.Column="0"
						          Content="Apr"
						          IsChecked="{Binding AprChecked,  Mode=TwoWay}"   />
                    <CheckBox Name="MayCheckBox"
						          Grid.Row="1" Grid.Column="1"
						          Content="May"
						          IsChecked="{Binding MayChecked,
						                              Mode=TwoWay}"  />
                    <CheckBox Name="JunCheckBox"
						            Grid.Row="1" Grid.Column="2"
						          Content="Jun"
						          IsChecked="{Binding JunChecked,
						                              Mode=TwoWay}" />
                    <CheckBox Name="JulCheckBox"  Grid.Row="2" Grid.Column="0"
						          Content="Jul"
						          IsChecked="{Binding JulChecked,
						                              Mode=TwoWay}"  />
                    <CheckBox Name="AugCheckBox"
						           Grid.Row="2" Grid.Column="1"
						          Content="Aug"
						          IsChecked="{Binding AugChecked,
						                              Mode=TwoWay}" />
                    <CheckBox Name="SepCheckBox"
						           Grid.Row="2" Grid.Column="2"
						          Content="Sep"
						          IsChecked="{Binding SepChecked,
						                              Mode=TwoWay}"/>
                    <CheckBox Name="OctCheckBox"
						           Grid.Row="3" Grid.Column="0"
						          Content="Oct"
						          IsChecked="{Binding OctChecked,
						                              Mode=TwoWay}"   />
                    <CheckBox Name="NovCheckBox"
						            Grid.Row="3" Grid.Column="1"
						          Content="Nov"
						          IsChecked="{Binding NovChecked,
						                              Mode=TwoWay}"   />
                    <CheckBox Name="DecCheckBox"
						             Grid.Row="3" Grid.Column="2"
						          Content="Dec"
						          IsChecked="{Binding DecChecked,
						                              Mode=TwoWay}"  />
                    <Button Name="WinterButton" Margin="0 0 2 2"
						          Grid.Row="4" Grid.Column="0"
						       Command="{Binding WinterClickCommand}"
						        Content="Winter"   />
                    <Button Name="SpringButton"
						           Grid.Row="4" Grid.Column="1"  Margin="0 0 2 2"
						        Command="{Binding SpringClickCommand}"
						        Content="Spring"   />
                    <Button Name="SummerButton"
						          Grid.Row="4" Grid.Column="2"  Margin="0 0 2 2"
						        Command="{Binding SummerClickCommand}"
						        Content="Summer"/>
                    <Button Name="FallButton"
						          Grid.Row="5" Grid.Column="0"  Margin="0 0 2 2"
						         Command="{Binding FallClickCommand}"
						        Content="Fall"/>
                    <Button Name="NoneMonthButton"
						           Grid.Row="5" Grid.Column="1"  Margin="0 0 2 2"
						        Command="{Binding ClearAllMonthsCommand}"
						        Content="None"   />
                    <Button Name="RefrteshButton" 
                            Content="Refresh" 
                            Command="{Binding RefreshCmd}"   Margin="0 0 2 2"
                             Grid.Row="5" Grid.Column="2" />
                    <Button Name="AllButton"   Margin="0 0 2 2"
                            Content="All" 
                            Command="{Binding AllCmd}" 
                            Grid.Row="6" Grid.Column="0"/>

                </Grid>
            </GroupBox>
            <GroupBox Header="Filter Tool" Grid.Column="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Column="0" Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <ComboBox    Margin="0 0 2 2"  
				          ItemsSource="{Binding ProductList}"
				          SelectedValue="{Binding Path=ProductComboSelectedValue,
				                                  Mode=TwoWay}" />
                        <ComboBox  Grid.Column="1"  Margin="0 0 2 2"  
				          ItemsSource="{Binding TypeList}"
				          SelectedValue="{Binding Path=TypeComboSelectedValue,
				                                  Mode=TwoWay}" />
                        <TextBox  Grid.Column="2"  Margin="0 0 2 2"   
				         Text="{Binding MinText}"
				         TextWrapping="Wrap" />
                        <TextBox  Grid.Column="3"  Margin="0 0 2 2"   
				         Text="{Binding MaxText}"
				         TextWrapping="Wrap" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Button Name="AddButton"
				        Margin="0 0 2 2" 
				        Command="{Binding AddFilterCommand}"
				        Content="Add" />
                            <Button Name="removeButton"
				         Grid.Row="1" Margin="0 0 2 2" 
				        Command="{Binding RemoveFilterCommand}"
				        Content="Remove" />
                            <Button Name="removeAllButton"
				        Grid.Row="2" Margin="0 0 2 2" 
				        Command="{Binding RemoveAllFilterCommand}"
				        Content="Remove All" />

                        </Grid>
                        <DataGrid Name="filterDataGrid"
				           Grid.Column="1" Grid.Row="1" BorderBrush="Black" BorderThickness="1"
				          AlternatingRowBackground="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}"
				          AutoGenerateColumns="False"
				          CanUserAddRows="False"
				          CanUserReorderColumns="False"
				          CanUserResizeRows="False"
				          CanUserSortColumns="False"
				          IsReadOnly="True"
				          ItemsSource="{Binding FilterList,
				                                Mode=TwoWay}"
				          SelectedValue="{Binding Path=FilterDataSelected}"
				          SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Product}"
						                    CanUserReorder="False" Width="80"
						                    Header="Product" />
                                <DataGridTextColumn Binding="{Binding Type}"
						                    CanUserReorder="False"
						                    Header="Type" />
                                <DataGridTextColumn Binding="{Binding Min}"
						                    CanUserReorder="False"
						                    Header="Min" />
                                <DataGridTextColumn Binding="{Binding Max}"
						                    CanUserReorder="False"
						                    Header="Max" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </GroupBox>
            <GroupBox Name="groupBox15"
				          Grid.Row="0"
				          Grid.Column="4"
				          BorderBrush="#FF1D1C1C"
				          Header="Crr Period Types"  >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <RadioButton 
				             Content="Monthly"
				             FontWeight="Normal"				             
                             IsChecked="{Binding MonthlyPeriodChecked}"  />

                    <RadioButton  Grid.Row="1"
				             Content="Quaterly"
				             FontWeight="Normal"
                             IsChecked="{Binding QuaterlyChecked}" />
                    <RadioButton  Grid.Row="2"
				             Content="Annualy"
				             FontWeight="Normal"
                             IsChecked="{Binding AnnualyChecked}" />
                    <RadioButton  Grid.Row="3"
				             Content="Long Term"
				             FontWeight="Normal"
                             IsChecked="{Binding LongtermChecked}" />
                </Grid>
            </GroupBox>
        </Grid>
        <Expander Name="summaryExpander"
		          Grid.Row="1"
		          HorizontalAlignment="Stretch"
		          BorderBrush="Black"
		          BorderThickness="1"
		          Header="Summary"
		          IsExpanded="True">
            <StackPanel>
                <DataGrid
