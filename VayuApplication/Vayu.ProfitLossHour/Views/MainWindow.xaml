<Window  
         x:Class="Vayu.ProfitLossHour.Views.MainWindow"
          
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
          xmlns:util="clr-namespace:Vayu.CommonControls;assembly=Vayu.CommonControls"
    xmlns:cc="clr-namespace:Vayu.ProfitLossHour.ViewModels"
    prism:ViewModelLocator.AutoWireViewModel="False"
        Title="Vayu-Hourly PNL" Height="292" Width="1340">
    <Window.Resources >
        <ResourceDictionary>
            <cc:IsGreaterConverter x:Key="greaterThanConverter" />
            <cc:IsLesserConverter x:Key="lesserThanConverter" />
            <Style x:Key="pnlTextBox" TargetType="TextBox">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PNLValue, Converter={StaticResource lesserThanConverter}}" Value="true">
                        <Setter Property="Foreground" Value="Red" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding PNLValue, Converter={StaticResource greaterThanConverter}}" Value="true">
                        <Setter Property="Foreground" Value="Green" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="LayoutRoot" Background="Teal">

        <Grid.RowDefinitions>
            <RowDefinition Height="55" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <DataGrid x:Name="pnlGrid" Grid.Row="1" AlternationCount="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" FrozenColumnCount="2" IsSynchronizedWithCurrentItem="True" 
                  ItemsSource="{Binding HourPNLList, NotifyOnSourceUpdated=True}" Sorting="pnlGrid_Sorting"
                  RowStyle="{DynamicResource rowStyle}"
                  SelectedIndex="1"
		         >
            <DataGrid.Resources>
                <Style x:Key="totalColStyle" TargetType="{x:Type DataGridCell}">
                    <Setter Property="Background" Value="BlanchedAlmond" />
                </Style>
                <Style  TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="BorderBrush" Value="LightGray" />
                </Style>
                <Style x:Key="rowStyle" TargetType="{x:Type DataGridRow}">
                    <Style.Triggers>
                        <Trigger Property="AlternationIndex" Value="0">
                            <Setter Property="Background" Value="White" />
                        </Trigger>
                        <Trigger Property="AlternationIndex" Value="1">
                            <Setter Property="Background" Value="LightGray" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Path=NodeName}" Value="TOTAL">
                            <Setter Property="Background" Value="BlanchedAlmond" />
                        </DataTrigger>
                         
                    </Style.Triggers>
                </Style>
                <Style x:Key="HeaderStyle" TargetType="DataGridColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="FontFamily" Value="Microsoft Sans Serif, 8.25pt" />
                </Style>
                <Style x:Key="lotTextStyle" TargetType="TextBox">
                    <Style.Setters>
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <!--  <Setter Property="FontWeight" Value="Bold" />  -->
                        <Setter Property="FontFamily" Value="Microsoft Sans Serif, 8.25pt" />
                    </Style.Setters>
                </Style>
                <Style x:Key="pnlTextStyle" TargetType="TextBox">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="FontFamily" Value="Microsoft Sans Serif, 8.25pt" />
                    <Setter Property="FontWeight" Value="ExtraLight" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Converter={StaticResource lesserThanConverter}}" Value="true">
                            <Setter Property="Foreground" Value="Red" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Converter={StaticResource greaterThanConverter}}" Value="true">
                            <Setter Property="Foreground" Value="Green" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
                <DataTemplate x:Key="childTemplate">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Row="0"
						         Grid.Column="0"
						         MinWidth="30"
						         AllowDrop="True"
						         Background="Transparent"
						         BorderThickness="1"
						         Style="{StaticResource pnlTextStyle}"
						         Text="{Binding Path=PNL,
						                        StringFormat={}\{0:C\}}" />
                        <TextBox Grid.Row="0"
						         Grid.Column="1"
						         MinWidth="30"
						         Background="Transparent"
						         BorderThickness="1"
						         Style="{StaticResource lotTextStyle}"
						         Text="{Binding Path=ClearedMW, StringFormat={}{0:n2}}" />
                    </Grid>
                </DataTemplate>
            </DataGrid.Resources>
            <DataGrid.Columns>

                <DataGridTextColumn MinWidth="200" Foreground="Black"
				                    Binding="{Binding NodeName,
				                                      NotifyOnSourceUpdated=True}"
				                    FontFamily="Microsoft Sans Serif, 8.25pt"
				                    Header="Node"
				                    HeaderStyle="{StaticResource HeaderStyle}" />

                <DataGridTemplateColumn CanUserSort="True"
				                        CellStyle="{StaticResource totalColStyle}"
				                        Header="Total"
				                        HeaderStyle="{StaticResource HeaderStyle}"
				                        SortMemberPath="Total" util:GridViewSort.PropertyName="PNL">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding Total, StringFormat=C}" ContentTemplate="{StaticResource childTemplate}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn CanUserSort="True"
				                        Header="H1"
				                        HeaderStyle="{StaticResource HeaderStyle}"
				                        SortMemberPath="Hour1" util:GridViewSort.PropertyName="PNL">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding Hour1, StringFormat=C}" ContentTemplate="{StaticResource childTemplate}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn CanUserSort="True"
				                        Header="H2"
				                        HeaderStyle="{StaticResource HeaderStyle}"
				                          SortMemberPath="Hour2" util:GridViewSort.PropertyName="PNL">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding Hour2, StringFormat=C}" ContentTemplate="{StaticResource childTemplate}" />
