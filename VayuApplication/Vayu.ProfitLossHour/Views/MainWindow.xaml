                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
        <Grid Width="1300"
		      Height="33"
		      Margin="20,16,0,0"
		      HorizontalAlignment="Left"
		      VerticalAlignment="Top"
              >
            <Grid.RowDefinitions>
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="65" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="55" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="65" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="65" />
                <ColumnDefinition Width="102" />
                <ColumnDefinition Width="71" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="75" />
                <ColumnDefinition Width="0*" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0"
			       Width="40"
			        Margin="0,2,0,2" Content="Date "
			          />
            <DatePicker x:Name="startDate" BorderBrush="Black"  
			            Grid.Column="1"
			             Margin="0,2,0,2"
			            
			            HorizontalAlignment="Left"
			            VerticalContentAlignment="Center"
			            BorderThickness="1"
			            SelectedDate="{Binding StartDate}" />
            <Label Grid.Column="2"
			       Width="55"
			        Margin="2,2,2,2"
			       HorizontalAlignment="Right"
			       Content="Products" />
            <ComboBox x:Name="typeDropDown"
			          Grid.Column="3"
			          Margin="2,2,2,2"
			          VerticalContentAlignment="Center"
			          ItemsSource="{Binding TypeList}"
			          SelectedItem="{Binding SelectedType}" />

            <Label Grid.Column="4"
			       Width="52"
			       Margin="0"
			       HorizontalAlignment="Right"
			       Content="Markets" />
            <ComboBox x:Name="marketDropDown"
			          Grid.Column="5"
			           Margin="2,2,2,2"
			          VerticalContentAlignment="Center"
			          ItemsSource="{Binding MarketList}"
			          SelectedItem="{Binding SelectedMarket}" />

            <Label Grid.Column="6"
			       Width="59"
			       Margin="0"
			       HorizontalAlignment="Right"
			       Content="Accounts" />
            <ComboBox x:Name="accountDropDown"
			          Grid.Column="7"
			         Margin="2,2,2,2"
			          VerticalContentAlignment="Center"
			          ItemsSource="{Binding AccountList}"
			          SelectedItem="{Binding SelectedAccount}" />

            <Label Grid.Column="8"
			       Width="61"
			       Margin="0"
			       HorizontalAlignment="Right"
			       Content="Portfolios" />
            <ComboBox x:Name="portfolioDropDown"
			          Grid.Column="9"
			          Margin="2,2,2,2"
			          VerticalContentAlignment="Center"
			          ItemsSource="{Binding PortfolioList}"
			          SelectedItem="{Binding SelectedPortfolio}" />
            <RadioButton x:Name="rRadioBtn" Grid.Column="10" Margin="2 2 2 2 "  Background="Teal" Content="Cleared" IsChecked="{Binding RealizedChecked, Mode=TwoWay}"/>
            <RadioButton x:Name="unrRadiobtn" Grid.Column="11" Margin="2 2 2 2 "  Background="Teal" Content="Uncleared" IsChecked="{Binding UnRealizedChecked, Mode=TwoWay}"/>
            <Button x:Name="calculateBtn"
			        Grid.Column="12"
			        Grid.ColumnSpan="1"
			        Margin="2,2,2,2"
			        Command="{Binding CalculateCommand}"
			        Content="Calculate" />

            <Label Grid.Column="13"
			       Width="31"
			       HorizontalAlignment="Right"
			       Content="PNL"
			       RenderTransformOrigin="0.5,0.538" />
            <TextBox x:Name="pnlTextBox2"
			         Grid.Column="14"
			         Margin="2,2,39,2"
			         Background="White"
                        Style="{StaticResource pnlTextBox}"
			         Text="{Binding PNLValue,
			                        StringFormat={}\{0:C\}}"
			         />

            <Label Grid.Column="14"
			       Width="36"
			       Margin="2,2,2,2"
			       HorizontalAlignment="Right"
			       Content="MW"
			       RenderTransformOrigin="0.469,0.423" />
            <TextBox x:Name="mwText"
			         Grid.Column="16"  
			         Text="{Binding MWValue, StringFormat={}{0:n2}}"
			         TextWrapping="Wrap" />
        </Grid>
        <ContentControl prism:RegionManager.RegionName="ContentRegion" />
    </Grid>
</Window>
