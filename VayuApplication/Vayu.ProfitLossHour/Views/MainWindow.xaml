				                      SortMemberPath="Hour21" util:GridViewSort.PropertyName="PNL">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding Hour21, StringFormat=C}" ContentTemplate="{StaticResource childTemplate}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn CanUserSort="True"
				                        Header="H22"
				                        HeaderStyle="{StaticResource HeaderStyle}"
				                        SortMemberPath="Hour22" util:GridViewSort.PropertyName="PNL">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding Hour22, StringFormat=C}" ContentTemplate="{StaticResource childTemplate}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn CanUserSort="True"
				                        Header="H23"
				                        HeaderStyle="{StaticResource HeaderStyle}"
				                         SortMemberPath="Hour23" util:GridViewSort.PropertyName="PNL">
