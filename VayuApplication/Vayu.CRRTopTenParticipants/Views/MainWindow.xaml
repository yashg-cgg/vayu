<Window x:Class="Vayu.CRRTopTenParticipants.Views.MainWindow"
                   
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:Vayu.CRRTopTenParticipants.Views"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="False"
        Title="LTC Top Participants"  
        Width="1180"
        Height="750"
        WindowState="Maximized">
    <Window.Resources>
        <ResourceDictionary>

            <local:CellBackgroundColorConverter x:Key="CellBg" />
            <local:BooleanVisibilityConverter x:Key="b2v"/>
            <!--<local:DataGridBackColorConverter x:Key="myBGColor"/>
            <Style x:Key="CenterCellStyleBG" TargetType="{x:Type DataGridCell}">
                <Setter Property="Foreground" 
                        Value="{Binding RelativeSource={RelativeSource Self},
                        Path=Content.Text, 
                        Converter={StaticResource myBGColor}}" />
            </Style>-->
        </ResourceDictionary>
    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="6,0,7,0">
            <StackPanel Height="Auto" Orientation="Horizontal">
                <StackPanel Height="Auto" Orientation="Horizontal">
                    <StackPanel   Orientation="Horizontal" Width="Auto" Margin="0,0,0,0">
                        <TextBlock Margin="4,5,0,0" Text="Market"  Width="Auto" />
                        <Border BorderBrush="Black" BorderThickness="1" Width="78" Margin="0,0,0,0">
                            <ComboBox Name="mktComboBox"
						          Margin="6,4,6,2"
                                      Width="Auto"
						          ItemsSource="{Binding MarketList}"
						          SelectedItem="{Binding MarketSelectedItem,
						                                 Mode=TwoWay}" SelectionChanged="mktComboBox_SelectionChanged" />
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="0,2,4,0" Orientation="Horizontal">
                        <TextBlock Height="26"
						           Margin="10,0,0,0"
						           Padding="0,3,0,0"
						           Text="Number" Width="44" />
                        <TextBox Width="60"
						         Height="25"
						         Margin="08,3,0,4
                                 "
						         HorizontalAlignment="Center"
						         BorderBrush="Black"
						         BorderThickness="1"
						         Text="{Binding ItemsCount,
						                        Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="10,10,0,0" />
                        </Style>
                        <Style TargetType="DatePicker">
                            <Setter Property="Width" Value="100" />
                            <Setter Property="Height" Value="25" />
                        </Style>
                    </StackPanel.Resources>
                    <StackPanel Margin="3,5,0,0" Orientation="Horizontal">
                        <TextBlock Text="From Date :" Width="65" Margin="10,6,0,0" />
                        <DatePicker Margin="4,4,0,8" SelectedDate="{Binding FromSelectedDate, Mode=TwoWay}" Width="95" Height="Auto" />
                    </StackPanel>
                    <StackPanel Margin="3,5,0,0" Orientation="Horizontal">
                        <TextBlock Text="To Date :"  Width="48" />
                        <DatePicker Margin="10,5,0,8" SelectedDate="{Binding ToSelectedDate, Mode=TwoWay}" Width="95" Height="Auto" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Width="60"
					        Command="{Binding SelectMonthCommand}"
					        Content="MTD" />
                    <Button Width="60"
					        Command="{Binding SelectYearCommand}"
					        Content="YTD" />
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Margin" Value="10,7,0,0" />
                            <Setter Property="Height" Value="25" />
                        </Style>
                    </StackPanel.Resources>
                </StackPanel>
                <StackPanel Margin="4,9,0,0" Orientation="Horizontal">
                    <StackPanel Margin="4,5,0,0" Orientation="Horizontal">
                        <TextBlock Text="Dated :" Margin="4,4,0,0" />
                        <TextBox Margin="4,-6,0,0" Width="70"
						         Height="25"
						         HorizontalContentAlignment="Left"
						         IsReadOnly="True"
						         Text="{Binding ReportDate,
						                        Mode=OneWay}" />
                    </StackPanel>
                    <Button Width="110"
					        Height="25"
					        Margin="10,2,0,0"
					        Command="{Binding GenerateReportCommand}"
					        Content="View Report" />
                </StackPanel>
            </StackPanel>
            <StackPanel.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="12,2,0,0" />
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="12,2,0,0" />
                </Style>
                <Style TargetType="ListBox">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="Height" Value="100" />
                    <Setter Property="Margin" Value="12,2,0,0" />
                </Style>
            </StackPanel.Resources>
        </StackPanel>
        
        <DataGrid Name="dgTopPNL" Grid.Row="1"
		          Grid.Column="1"
		          Margin="2,0,3,7"
		          AlternatingRowBackground="LightGray"
		          AutoGenerateColumns="False"
		          CanUserAddRows="False" 
                  CanUserSortColumns="True" Sorting="dgTopPNL_Sorting"
		          ItemsSource="{Binding PnlInfoList}" RowStyle="{DynamicResource ResourceKey=rowStyle}">
            <DataGrid.Resources>
                <Style x:Key="pnlColStyle" TargetType="{x:Type DataGridCell}">
                    <Setter Property="Background" Value="BlanchedAlmond"/>
                </Style>
                <Style x:Key="rowStyle" TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Participant}" Value="TOTAL">
                            <Setter Property="Background" Value="BlanchedAlmond"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Width="40*"
				                    Binding="{Binding Rank}"
				                    Header="Rank"
                                    CanUserSort="True"
				                    IsReadOnly="True"
                                    Foreground="Black">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Width="70*"
				                    Binding="{Binding Participant}"
				                    CanUserSort="True"
				                    Header="Participant"
				                    IsReadOnly="True"
                                    Foreground="Black">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Width="120*"
				                    Binding="{Binding Company}"
				                    CanUserSort="True"
				                    Header="Company"
				                    IsReadOnly="True"
                                    Foreground="Black">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Width="90*"
				                        CanUserSort="True"
				                        IsReadOnly="True"
				                        SortMemberPath="PNL" CellStyle="{StaticResource pnlColStyle}">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="PNL" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate >
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" Text="{Binding PNL,StringFormat={}\{0:C0\}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground">
                                            <Setter.Value>
                                                <Binding Converter="{StaticResource CellBg}"
												         ConverterParameter="PNL"
												         Path="." />
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="90*"
				                        CanUserSort="True"
				                        IsReadOnly="True"
				                        SortMemberPath="Cost" CellStyle="{StaticResource pnlColStyle}">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="Cost" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" Text="{Binding Cost, StringFormat={}\{0:C0\}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground">
                                            <Setter.Value>
                                                <Binding Converter="{StaticResource CellBg}"
												         ConverterParameter="Cost"
												         Path="." />
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="70*"
				                        CanUserSort="True"
				                        IsReadOnly="True"
				                        SortMemberPath="DAPrice" CellStyle="{StaticResource pnlColStyle}">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="DA Price" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" Text="{Binding DAPrice, StringFormat={}\{0:C0\}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground">
                                            <Setter.Value>
                                                <Binding Converter="{StaticResource CellBg}"
												         ConverterParameter="DAPrc"
												         Path="." />
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="55*"
				                        CanUserSort="True"
				                        IsReadOnly="True"
				                        SortMemberPath="MW" CellStyle="{StaticResource pnlColStyle}">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="MW" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" Text="{Binding MW}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground">
                                            <Setter.Value>
                                                <Binding Converter="{StaticResource CellBg}"
												         ConverterParameter="MW"
												         Path="." />
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="90*"
				                        CanUserSort="True"
				                        IsReadOnly="True"
				                        SortMemberPath="Monthly">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="MonthlyPNL" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate >
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" Text="{Binding Monthly,StringFormat={}\{0:C0\}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground">
                                            <Setter.Value>
                                                <Binding Converter="{StaticResource CellBg}"
												         ConverterParameter="Monthly"
												         Path="." />
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="90*"
				                        CanUserSort="True"
				                        IsReadOnly="True"
				                        SortMemberPath="Q1">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="Q1PNL" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate >
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" Text="{Binding Q1,StringFormat={}\{0:C0\}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground">
                                            <Setter.Value>
                                                <Binding Converter="{StaticResource CellBg}"
												         ConverterParameter="Q1"
												         Path="." />
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="90*"
				                        CanUserSort="True"
				                        IsReadOnly="True"
				                        SortMemberPath="Q2">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="Q2PNL" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate >
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" Text="{Binding Q2,StringFormat={}\{0:C0\}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground">
                                            <Setter.Value>
                                                <Binding Converter="{StaticResource CellBg}"
												         ConverterParameter="Q2"
												         Path="." />
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="90*"
				                        CanUserSort="True"
				                        IsReadOnly="True"
				                        SortMemberPath="Q3">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="Q3PNL" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate >
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" Text="{Binding Q3,StringFormat={}\{0:C0\}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground">
                                            <Setter.Value>
                                                <Binding Converter="{StaticResource CellBg}"
												         ConverterParameter="Q3"
												         Path="." />
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="90*"
				                        CanUserSort="True"
				                        IsReadOnly="True"
				                        SortMemberPath="Q4">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="Q4PNL" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate >
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" Text="{Binding Q4,StringFormat={}\{0:C0\}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground">
                                            <Setter.Value>
                                                <Binding Converter="{StaticResource CellBg}"
												         ConverterParameter="Q4"
												         Path="." />
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="90*"
				                        CanUserSort="True"
				                        IsReadOnly="True"
				                        SortMemberPath="Annual">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="AnnualPNL" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate >
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" Text="{Binding Annual,StringFormat={}\{0:C0\}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground">
                                            <Setter.Value>
                                                <Binding Converter="{StaticResource CellBg}"
												         ConverterParameter="Annual"
												         Path="." />
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="90*"
				                        CanUserSort="True"
				                        IsReadOnly="True"
				                        SortMemberPath="YR1">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="YR1PNL" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate >
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" Text="{Binding YR1,StringFormat={}\{0:C0\}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground">
                                            <Setter.Value>
                                                <Binding Converter="{StaticResource CellBg}"
												         ConverterParameter="YR1"
												         Path="." />
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="90*"
				                        CanUserSort="True"
				                        IsReadOnly="True"
				                        SortMemberPath="YR2">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="YR2PNL" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate >
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" Text="{Binding YR2,StringFormat={}\{0:C0\}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground">
                                            <Setter.Value>
                                                <Binding Converter="{StaticResource CellBg}"
												         ConverterParameter="YR2"
												         Path="." />
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="90*"
				                        CanUserSort="True"
				                        IsReadOnly="True"
				                        SortMemberPath="YR3">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="YR3PNL" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate >
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" Text="{Binding YR3,StringFormat={}\{0:C0\}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground">
                                            <Setter.Value>
                                                <Binding Converter="{StaticResource CellBg}"
												         ConverterParameter="YR3"
												         Path="." />
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="90*"
				                        CanUserSort="True"
				                        IsReadOnly="True"
				                        SortMemberPath="YRALL" Visibility="{Binding  ElementName=mktComboBox,
                     Path=SelectedItem,Converter={StaticResource b2v}}">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="YRALLPNL" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate >
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" Text="{Binding YRALL,StringFormat={}\{0:C0\}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground">
                                            <Setter.Value>
                                                <Binding Converter="{StaticResource CellBg}"
												         ConverterParameter="YRALL"
												         Path="." />
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
