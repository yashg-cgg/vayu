                <DataGridTextColumn Width="55*"
				                    MinWidth="40"
				                    Binding="{Binding Sum,
				                                      StringFormat={}\{0:N0\}}"
				                    CanUserReorder="False"
				                    Header="Total"
				                    IsReadOnly="True" />
                <DataGridTextColumn Width="55*"
				                    MinWidth="40"
				                    Binding="{Binding RiskType,
				                                      StringFormat={}\{0:N0\}}"
				                    CanUserReorder="False"
				                    Header="Type"
				                    IsReadOnly="True" />
                <DataGridTextColumn Width="50*"
				                    MinWidth="40"
				                    Binding="{Binding Shift}"
				                    CanUserReorder="False"
				                    Header="Shift"
				                    IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
