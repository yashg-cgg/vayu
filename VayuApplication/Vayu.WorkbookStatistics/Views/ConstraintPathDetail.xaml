<Window 
              
             x:Class="Vayu.WorkbookStatistics.Views.ConstraintPathDetail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"             
             prism:ViewModelLocator.AutoWireViewModel="True"
            Title="Vayu-ConstraintPathDetail">
    <Grid> 
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Width="140"
			        Height="25"
			        Margin="25,2,0,0"
			        Command="{Binding DeletePathsCommand}"
			        Content="Delete Selected Paths"
			        IsEnabled="True" />
        </StackPanel>
        <DataGrid x:Name="grdPathList"
		          Grid.Row="1"
		          AlternatingRowBackground="LightGray"
		          AutoGenerateColumns="False"
		          CanUserAddRows="False"
		          CellEditEnding="grdPathList_CellEditEnding"
		          ItemsSource="{Binding PathList,
		                                Mode=TwoWay}"
		          SelectedItem="{Binding PathSelectedList,
		                                 Mode=TwoWay}"
		          SelectionChanged="grdPathList_SelectionChanged_1"
		          SelectionMode="Extended"
		          SelectionUnit="Cell">
            <DataGrid.Columns> 
                <DataGridTextColumn Width="40*"
				                    Binding="{Binding Source}"
				                    Header="Source"
				                    IsReadOnly="True" />
                <DataGridTextColumn Width="40*"
				                    Binding="{Binding Sink}"
				                    Header="Sink"
				                    IsReadOnly="True" />
                <DataGridTextColumn Width="30*"
				                    Binding="{Binding AnalysisType}"
				                    Header="AnalysisType"
				                    IsReadOnly="False" />
                <DataGridTextColumn Width="30*"
				                    Binding="{Binding Price}"
				                    Header="Price"
				                    IsReadOnly="False" />
                <DataGridTextColumn Width="30*"
				                    Binding="{Binding MW}"
				                    Header="MW"
				                    IsReadOnly="False" />
                <DataGridTextColumn Width="50*"
				                    Binding="{Binding SourceZone}"
				                    Header="SourceZone"
				                    IsReadOnly="True" />
                <DataGridTextColumn Width="50*"
				                    Binding="{Binding SinkZone}"
				                    Header="SinkZone"
				                    IsReadOnly="True" />
                <DataGridTextColumn Width="70*"
				                    Binding="{Binding BidId}"
				                    Header="BidId"
				                    IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
