<Window  
               
             x:Class="Vayu.WorkbookStatistics.Views.PathErrorDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"    
             Title="Vayu-Limits Exceeded"
             ResizeMode="NoResize"
    Height="302"
    Width="311"
             WindowStartupLocation="CenterScreen"
             prism:ViewModelLocator.AutoWireViewModel="False">
    <Grid Margin="0,0,0,0" >
        
        <DataGrid HorizontalAlignment="Left" Margin="10,0,0,0" Width="272" Height="210" VerticalAlignment="Top"  CanUserAddRows="False" ItemsSource="{Binding PathErrorList}"  AreRowDetailsFrozen="True" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Days}" CanUserReorder="False" Header="Days" IsReadOnly="True" Width="50*" MinWidth="40" />
                <DataGridTextColumn Binding="{Binding AsBid, StringFormat={}\{0:N0\}}" CanUserReorder="False" Header="As Bid" IsReadOnly="True" Width="50*" MinWidth="40" />
                <DataGridTextColumn Binding="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}" CanUserReorder="False" Header="Date" IsReadOnly="True" Width="50*" MinWidth="40"  />
            </DataGrid.Columns>
        </DataGrid>
        <Button Content="Override" HorizontalAlignment="Left" Height="26" Margin="10,224,0,0" VerticalAlignment="Top" Width="70" Command="{Binding OverrideCommand}" Click="CancelButton_Click"/>
        <Button Content="Cancel" HorizontalAlignment="Left" Height="26" Margin="214,224,0,0" VerticalAlignment="Top" Width="70" Click="CancelButton_Click"/>
    </Grid>
</Window>
