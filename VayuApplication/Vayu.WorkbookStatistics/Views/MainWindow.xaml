<Window    
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vm="clr-namespace:Vayu.WorkbookStatistics.ViewModels"
                 x:Class="Vayu.WorkbookStatistics.Views.MainWindow"
                 xmlns:prism="http://prismlibrary.com/"
                 xmlns:oxy="http://oxyplot.org/wpf"
                  xmlns:GridLines="clr-namespace:Vayu.CommonControls;assembly=Vayu.CommonControls"
                 xmlns:util="clr-namespace:Vayu.CommonControls;assembly=Vayu.CommonControls"
                 xmlns:Behaviours="clr-namespace:Vayu.CommonControls;assembly=Vayu.CommonControls"
                 xmlns:local="clr-namespace:Vayu.WorkbookStatistics.Views"
                 xmlns:i="http://schemas.microsoft.com/xaml/behaviors"  
                 prism:ViewModelLocator.AutoWireViewModel="False"  
                 Title="DART Portfolio" Height="651" Width="861"  BorderThickness="1" BorderBrush="#2ECC71 ">
    <Window.Resources>
        <ResourceDictionary>
            <vm:ComparisonConverter x:Key="ComparisonConverter" />
            <local:DataGridCellForeColorConverter x:Key="myFGColor" />
            <local:DataGridCellForeColorConverterSimple x:Key="myFGColorSimple" />
            <local:DataGridCellBackColorConverter x:Key="myBGColor" />
            <local:TextBlockBackColorConverter x:Key="myTBBGColor" />
            <local:TextBlockForeColorConverter x:Key="myTBFGColor" />
            <BooleanToVisibilityConverter x:Key="b2v" />
            <local:ConvertToCurrencyFormat x:Key="D2C" />
            <local:PathMWsCellConverter x:Key="PathsMWFormat"/>
            <Style TargetType="DataGridCell" x:Key="SourceDeenergizedStyle">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SourceDeenergized}" Value="True">
                        <Setter Property="Foreground" Value="Red"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SourceDeenergized}" Value="False">
                        <Setter Property="Foreground" Value="Black"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            
            <Style TargetType="DataGridCell" x:Key="SinkDeenergizedStyle">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SinkDeenergized}" Value="True">
                        <Setter Property="Foreground" Value="Red"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SinkDeenergized}" Value="False">
                        <Setter Property="Foreground" Value="Black"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="WrappedColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Height" Value="20" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="Margin" Value="-5,0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="CenterCellStyle" TargetType="{x:Type DataGridCell}">
                <Setter Property="Margin" Value="0,0,0,0" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                            <Grid Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="DarkBlue" />
                        <Setter Property="BorderBrush" Value="PaleTurquoise" />
                        <Setter Property="Background" Value="PaleTurquoise" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Background" Value="DodgerBlue" />
                        <Setter Property="BorderBrush" Value="Blue" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            
            <Style x:Key="CenterCellStyleFGSimple" TargetType="{x:Type DataGridCell}">
                <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource Self}, Path=Content.Text, Converter={StaticResource myFGColorSimple}}" />
                <Setter Property="Margin" Value="0,0,0,0" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                            <Grid Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="HeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="20" />
            </Style>
            <Style TargetType="Window">
                
                <Style.Triggers>
                    <Trigger Property="WindowState" Value="Minimized">
                        <Setter Property="Width" Value="100"/>
                        <Setter Property="Height" Value="100"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="ComboBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
            </Style>
            <Style TargetType="TabItem" x:Key="TabItemHeaderStyle">
                <Setter Property="Background" Value="LightBlue"/>
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="FontSize" Value="12px" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
