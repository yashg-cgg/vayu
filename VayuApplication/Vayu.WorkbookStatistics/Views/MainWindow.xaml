                        <RadioButton x:Name="SourceRadioBtn" Margin="15,0,0,0" Content="Source" VerticalAlignment="Center" Checked="SourceRadioBtn_Checked" IsChecked="{Binding SourcePathChecked}"/>
                        <RadioButton x:Name="SinkRadioBtn" Margin="15,0,0,0" Content="Sink" VerticalAlignment="Center" Checked="SinkRadioBtn_Checked" IsChecked="{Binding SinkPathChecked}"/>
                        <RadioButton x:Name="NoneRadioBtn" Margin="15,0,0,0" Content="None" VerticalAlignment="Center" Checked="NoneRadioBtn_Checked" IsChecked="{Binding NonePathChecked}"/>
                        <CheckBox x:Name="Fuel" Margin="15,0,0,0" Content="Fuel Type" IsChecked="{Binding FuelChecked}"  VerticalAlignment="Center" />
                        <Button x:Name="btnPathMWs" Margin="30,0,0,0" Height="23" Content="Go" Command="{Binding ClickPathMWsCommand}" Width="50"/>
                        <Button x:Name="piechart" Margin="30,0,0,0" Height="23" Content="Chart" Command="{Binding PieChartCommand}" Width="50" />
                    </StackPanel>
                    <DataGrid x:Name="PathMWdatagrid" Grid.Row="1"  HorizontalAlignment="Stretch" IsSynchronizedWithCurrentItem="True"
                          VerticalAlignment="Stretch" AlternatingRowBackground="LightGray"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="True" Sorting="PathMW_Sorting"
                          ItemsSource="{Binding PathMWList,Mode=TwoWay}" Grid.ColumnSpan="2" >
                        <DataGrid.Resources>
                            <Style x:Key="HeaderStyle" TargetType="DataGridColumnHeader">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="FontFamily" Value="Microsoft Sans Serif, 8.25pt" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="90" Header="Portfolio" Binding="{Binding PortfolioName}" Visibility="Collapsed"  IsReadOnly="True"/>
                            <DataGridTextColumn  Width="130" Header="Source" Binding="{Binding SourceName}" Foreground="Black" IsReadOnly="True"/>
                            <DataGridTextColumn  Width="130" Header="Sink" Binding="{Binding SinkName}" Foreground="Black" IsReadOnly="True"/>
                            <DataGridTextColumn  Width="45" Header="H1" Binding="{Binding Hour1,StringFormat=N1,Converter={StaticResource PathsMWFormat}}" Foreground="Black" SortMemberPath="Hour1" HeaderStyle="{StaticResource HeaderStyle}" IsReadOnly="True"/>
                            <DataGridTextColumn Width="45" Foreground="Black" Header="H2" Binding="{Binding Hour2,StringFormat=N1,Converter={StaticResource PathsMWFormat}}" HeaderStyle="{StaticResource HeaderStyle}" IsReadOnly="True"/>
                            <DataGridTextColumn Width="45" Foreground="Black" Header="H3" Binding="{Binding Hour3,StringFormat=N1,Converter={StaticResource PathsMWFormat}}" HeaderStyle="{StaticResource HeaderStyle}" IsReadOnly="True"/>
                            <DataGridTextColumn Width="45" Foreground="Black" Header="H4" Binding="{Binding Hour4,StringFormat=N1,Converter={StaticResource PathsMWFormat}}" HeaderStyle="{StaticResource HeaderStyle}" IsReadOnly="True"/>
                            <DataGridTextColumn Width="45" Foreground="Black" Header="H5" Binding="{Binding Hour5,StringFormat=N1,Converter={StaticResource PathsMWFormat}}" HeaderStyle="{StaticResource HeaderStyle}" IsReadOnly="True"/>
                            <DataGridTextColumn Width="45" Foreground="Black" Header="H6" Binding="{Binding Hour6,StringFormat=N1,Converter={StaticResource PathsMWFormat}}" HeaderStyle="{StaticResource HeaderStyle}" IsReadOnly="True"/>
                            <DataGridTextColumn Width="45" Foreground="Black" Header="H7" Binding="{Binding Hour7,StringFormat=N1,Converter={StaticResource PathsMWFormat}}" HeaderStyle="{StaticResource HeaderStyle}" IsReadOnly="True"/>
                            <DataGridTextColumn Width="45" Foreground="Black" Header="H8" Binding="{Binding Hour8,StringFormat=N1,Converter={StaticResource PathsMWFormat}}" HeaderStyle="{StaticResource HeaderStyle}" IsReadOnly="True"/>
                            <DataGridTextColumn Width="45" Foreground="Black" Header="H9" Binding="{Binding Hour9,StringFormat=N1,Converter={StaticResource PathsMWFormat}}" HeaderStyle="{StaticResource HeaderStyle}" IsReadOnly="True"/>
                            <DataGridTextColumn Width="45" Foreground="Black" Header="H10" Binding="{Binding Hour10,StringFormat=N1,Converter={StaticResource PathsMWFormat}}" HeaderStyle="{StaticResource HeaderStyle}" IsReadOnly="True"/>
                            <DataGridTextColumn Width="45" Foreground="Black" Header="H11" Binding="{Binding Hour11,StringFormat=N1,Converter={StaticResource PathsMWFormat}}" HeaderStyle="{StaticResource HeaderStyle}" IsReadOnly="True"/>
                            <DataGridTextColumn Width="45" Foreground="Black" Header="H12" Binding="{Binding Hour12,StringFormat=N1,Converter={StaticResource PathsMWFormat}}" HeaderStyle="{StaticResource HeaderStyle}" IsReadOnly="True"/>
                            <DataGridTextColumn Width="45" Foreground="Black" Header="H13" Binding="{Binding Hour13,StringFormat=N1,Converter={StaticResource PathsMWFormat}}" HeaderStyle="{StaticResource HeaderStyle}" IsReadOnly="True"/>
                            <DataGridTextColumn Width="45" Foreground="Black" Header="H14" Binding="{Binding Hour14,StringFormat=N1,Converter={StaticResource PathsMWFormat}}" HeaderStyle="{StaticResource HeaderStyle}" IsReadOnly="True"/>
                            <DataGridTextColumn Width="45" Foreground="Black" Header="H15" Binding="{Binding Hour15,StringFormat=N1,Converter={StaticResource PathsMWFormat}}" HeaderStyle="{StaticResource HeaderStyle}" IsReadOnly="True"/>
                            <DataGridTextColumn Width="45" Foreground="Black" Header="H16" Binding="{Binding Hour16,StringFormat=N1,Converter={StaticResource PathsMWFormat}}" HeaderStyle="{StaticResource HeaderStyle}" IsReadOnly="True"/>
                            <DataGridTextColumn Width="45" Foreground="Black" Header="H17" Binding="{Binding Hour17,StringFormat=N1,Converter={StaticResource PathsMWFormat}}" HeaderStyle="{StaticResource HeaderStyle}" IsReadOnly="True"/>
                            <DataGridTextColumn Width="45" Foreground="Black" Header="H18" Binding="{Binding Hour18,StringFormat=N1,Converter={StaticResource PathsMWFormat}}" HeaderStyle="{StaticResource HeaderStyle}" IsReadOnly="True"/>
                            <DataGridTextColumn Width="45" Foreground="Black" Header="H19" Binding="{Binding Hour19,StringFormat=N1,Converter={StaticResource PathsMWFormat}}" HeaderStyle="{StaticResource HeaderStyle}" IsReadOnly="True"/>
                            <DataGridTextColumn Width="45" Foreground="Black" Header="H20" Binding="{Binding Hour20,StringFormat=N1,Converter={StaticResource PathsMWFormat}}" HeaderStyle="{StaticResource HeaderStyle}" IsReadOnly="True"/>
                            <DataGridTextColumn Width="45" Foreground="Black" Header="H21" Binding="{Binding Hour21,StringFormat=N1,Converter={StaticResource PathsMWFormat}}" HeaderStyle="{StaticResource HeaderStyle}" IsReadOnly="True"/>
                            <DataGridTextColumn Width="45" Foreground="Black" Header="H22" Binding="{Binding Hour22,StringFormat=N1,Converter={StaticResource PathsMWFormat}}" HeaderStyle="{StaticResource HeaderStyle}" IsReadOnly="True"/>
                            <DataGridTextColumn Width="45" Foreground="Black" Header="H23" Binding="{Binding Hour23,StringFormat=N1,Converter={StaticResource PathsMWFormat}}" HeaderStyle="{StaticResource HeaderStyle}" IsReadOnly="True"/>
                            <DataGridTextColumn Width="45" Foreground="Black" Header="H24" Binding="{Binding Hour24,StringFormat=N1,Converter={StaticResource PathsMWFormat}}" HeaderStyle="{StaticResource HeaderStyle}" IsReadOnly="True"/>
                            <DataGridTextColumn Width="45" Foreground="Black" Header="Total" Binding="{Binding Total,StringFormat=N1,Converter={StaticResource PathsMWFormat}}" HeaderStyle="{StaticResource HeaderStyle}" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Name="ClearingHistory" Header="ClearingHistory" Style="{StaticResource TabItemHeaderStyle}"    >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14*"/>
                        <ColumnDefinition Width="14*"/>
                        <ColumnDefinition Width="17*"/>
                        <ColumnDefinition Width="11*"/>
                        <ColumnDefinition Width="14*"/>
                        <ColumnDefinition Width="597*"/>
                        <ColumnDefinition Width="1100*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="66" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" VerticalAlignment="Stretch" Grid.ColumnSpan="7">
                        <GroupBox Header="DateRange" HorizontalAlignment="Left" Width="600"   VerticalAlignment="Center" Height="65">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Label Content="StartDate" Grid.Row="0" Grid.Column="0" Width="60"  HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <DatePicker Name="StartDatePick" Width="100"    Margin="70,0,0,0" VerticalAlignment="Center" SelectedDate="{Binding ClearingStartDate}" HorizontalAlignment="Left"/>
                                <Label Content="EndDate"   Grid.Column="1" Grid.Row="0"  HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <DatePicker Name="EndDAtePick"  Margin="70,0,0,0" Grid.Column="1" Grid.Row="0"   VerticalAlignment="Center"  HorizontalAlignment="Left" SelectedDate="{Binding ClearingEndDate}" />
                                <Button Content="GetPaths" Grid.Column="2" Grid.Row="0" Margin="10 0 0 0" Command="{Binding GetCleredPathsCmd}" />
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                    <DataGrid Grid.Row="1" Name="ClearedPathsataGrid" ItemsSource="{Binding ClearedPathList}" Grid.ColumnSpan="7" AlternatingRowBackground="LightGray" 
                              IsSynchronizedWithCurrentItem="True" AutoGenerateColumns="False" ScrollViewer.VerticalScrollBarVisibility="Visible" VerticalAlignment="Stretch" >
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Source}" 
                                                Width="*" CanUserSort="True"
                                                Header="Source"/>
                            <DataGridTextColumn Binding="{Binding Sink}"
                                                Width="*" CanUserSort="True" 
                                                Header="Sink"/>
                            <DataGridTextColumn Binding="{Binding Hours}"
                                                Width="*" CanUserSort="True" 
                                                Header="SubmittedHours"/>
                            <DataGridTextColumn Binding="{Binding Price}"
                                                Width="*" CanUserSort="True" 
                                                Header="BidPrice"/>
                            <DataGridTextColumn Binding="{Binding ClearedDate}"
                                                Width="*" CanUserSort="True" 
                                                Header="LastClearingDate"/>
                            <DataGridTextColumn Binding="{Binding Days }"
                                                Width="*" CanUserSort="True" 
                                                CellStyle="{StaticResource  CenterCellStyleFGSimple}"
                                                Header="Num Of Days Since Last Cleared"/>
                        </DataGrid.Columns>

                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>

        <CheckBox x:Name="chkPnodeMarket"
		          IsChecked="{Binding IsPnodeMarket,
		                              Mode=TwoWay}"
		          Visibility="Collapsed" />
        <CheckBox x:Name="chkSinkPjm"
		          IsChecked="{Binding IsPjmUptoSink,
		                              Mode=TwoWay}"
		          Visibility="Collapsed" />
        <ContentControl prism:RegionManager.RegionName="ContentRegion" />
    </Grid>
</Window>
