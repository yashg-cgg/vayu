<Window  x:Class="Vayu.ConstraintSensitivityAlgorithm.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
                 xmlns:my1="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls.Input.Toolkit" xmlns:vm="clr-namespace:Vayu.ConstraintSensitivityAlgorithm.ViewModels" xmlns:local="clr-namespace:Vayu.ConstraintSensitivityAlgorithm.Views"
                 prism:ViewModelLocator.AutoWireViewModel="False"
        Title="VAYU - Constraint Sensitivity Analyzer" Width="1352.299" Height="783">
    <Window.Resources>
        <ResourceDictionary>
            <local:DataGridCellForeColorConverter x:Key="myFGColor" />
            <Style x:Key="CenterCellStyleFGSimple" TargetType="{x:Type DataGridCell}">
                <Setter Property="Margin" Value="0,0,0,0" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                            <Grid Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="HeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="25" />
            </Style>
            <Style x:Key="defCStyle" TargetType="{x:Type DataGridCell}">
                <Setter Property="Foreground">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource myFGColor}">
                            <MultiBinding.Bindings>
                                <Binding RelativeSource="{RelativeSource Self}" />
                                <Binding Path="." />
                            </MultiBinding.Bindings>
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
            </Style>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <vm:InverseBooleanToVisibilityConverter x:Key="inverseBooleanToVisibilityConverter" />

        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32*"/>
            <RowDefinition Height="250*"/>
            <RowDefinition Height="451*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="105*"/>
                <ColumnDefinition Width="105*"/>
                <ColumnDefinition Width="76*"/>
                <ColumnDefinition Width="80*"/>
                <ColumnDefinition Width="90*"/>
                <ColumnDefinition Width="105*"/>
                <ColumnDefinition Width="95*"/>
                <ColumnDefinition Width="115*"/>
                <ColumnDefinition Width="98*"/>
                <ColumnDefinition Width="109*"/>
                <ColumnDefinition Width="200*"/>
                <ColumnDefinition Width="200*"/>

            </Grid.ColumnDefinitions>
            <ComboBox x:Name="marketListBox" Margin="4,2,10,2" 
									          Grid.Column="0" 							         
									          ItemsSource="{Binding MarketList}" 
									          SelectedItem="{Binding SelectedMarket , Mode=TwoWay }" />
            <ComboBox Grid.Column="1"  Margin="2,2,10,2"  ItemsSource="{Binding ProductList}" SelectedItem="{Binding ProductSelectedItem}" x:Name="typeCombo" />
            <Label Content="Sensitivity"  Grid.Column="2" VerticalAlignment="Center" Margin="2,4,10,3" Height="26" />
            <TextBox Grid.Column="3" Text="{Binding Sensitivity}" Margin="2,2,10,2" />
            <Button Grid.Column="4" Margin="2,2,10,2"  Command="{Binding RunRunCommand}" Content="Run" />
            <TextBlock VerticalAlignment="Center" Grid.Column="5"   Text="ConstraintSearch:" Margin="2,8,10,9" Height="16" />
            <my1:AutoCompleteBox x:Name="Constraint_AutoCompleteBox"  Grid.Column="6" FilterMode="Contains" Text="{Binding ConstraintTextItem}" ItemsSource="{Binding ConstraintListItems}" MaxDropDownHeight="150" SelectionChanged="Constraint_AutoCompleteBox_SelectionChanged" Margin="2,2,10,2" />
            <TextBlock Grid.Column="7" VerticalAlignment="Center" Text="ContingencySearch:" Margin="2,8,10,7" Height="18" />
            <my1:AutoCompleteBox x:Name="Contingency_AutoCompleteBox" Grid.Column="8"  FilterMode="Contains" ItemsSource="{Binding ContigencyListItems}" MaxDropDownHeight="50" SelectionChanged="Contingency_AutoCompleteBox_SelectionChanged" Margin="2,2,10,2" />
            <TextBlock Grid.Column="9" Margin="2,6,10,2"  Text="Constraint Family:" />
            <ComboBox Grid.Column="10" Margin="2,2,10,2" ItemsSource="{Binding FamilyListItems}" SelectedItem="{Binding FamilySelectedItem}" />
            <Button  Grid.Column="11" Margin="2,2,60,2"  Command="{Binding RunExportCommand}" Content="Export" />
        </Grid>
        <Grid Grid.Row="1">
            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="605*"/>
                    <ColumnDefinition Width="134*"/>
                    <ColumnDefinition Width="466*"/>
                    <ColumnDefinition Width="139*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="40*"/>
                    <RowDefinition Height="40*"/>
                    <RowDefinition Height="40*"/>
                    <RowDefinition Height="40*"/>
                    <RowDefinition Height="40*"/>
                    <RowDefinition Height="40*"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="ConstraintTable"   Grid.Column="0"   Margin="5,5,5,0" AlternatingRowBackground="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}" AutoGenerateColumns="False" CanUserAddRows="False"  GridLinesVisibility="All" HorizontalScrollBarVisibility="Visible" ItemsSource="{Binding ConstraintList}" SelectionChanged="ConstraintTable_SelectionChanged" SelectionMode="Extended" Grid.RowSpan="6"  BorderThickness="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="250*" MinWidth="250" Foreground="Black" Binding="{Binding Constraint}" CanUserReorder="True" Header="Constraint" IsReadOnly="True">
                            <!--
							<DataGridTextColumn.CellStyle>
							<Style TargetType="DataGridCell">
							<Style.Triggers>
							<DataTrigger Binding="{Binding IsSelected}" Value="True">
							<Setter Property="Background" Value="LightBlue" />
							</DataTrigger>
							<DataTrigger Binding="{Binding IsSelected}" Value="false">
							<Setter Property="Background" Value="White" />
							</DataTrigger>
							</Style.Triggers>
							
							</Style>
							</DataGridTextColumn.CellStyle>
						-->
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="120*" MinWidth="120" Binding="{Binding Contingency}" CanUserReorder="True" Header="Contingency" Foreground="Black" IsReadOnly="True" />
                        <DataGridTextColumn Width="200*" Foreground="Black" MinWidth="200" Binding="{Binding Family}" CanUserReorder="True" Header="Family" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>

                <Button  Grid.Column="1" Grid.Row="1" Command="{Binding RunAddCommand}" Content="Add" Margin="0,8,0,7" />
                <Button Grid.Column="1" Grid.Row="2" VerticalAlignment="Stretch" Command="{Binding RunAddAllCommand}" Content="Add All" Margin="0,8,0,7"  />
                <Button  Grid.Column="1" Grid.Row="3"  VerticalAlignment="Stretch" Command="{Binding RunRemoveCommand}" Content="Remove" Margin="0,8,0,7"  />
                <Button  Grid.Column="1" Grid.Row="4" Command="{Binding RunRemoveAllCommand}" Content="Remove All" Margin="0,8,0,7"/>

                <DataGrid x:Name="AddedConstraintTable"  Grid.Column="2" Margin="5,5,5,0" AlternatingRowBackground="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}" AreRowDetailsFrozen="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="All" HorizontalScrollBarVisibility="Visible" ItemsSource="{Binding AddedConstraintList}" SelectionChanged="AddedConstraintTable_SelectionChanged" SelectionMode="Extended" Grid.RowSpan="6" BorderThickness="2" Grid.ColumnSpan="2">

                    <DataGrid.Columns>
                        <DataGridTextColumn Width="250*" MinWidth="250" Foreground="Black" Binding="{Binding Constraint}" CanUserReorder="False" Header="Constraint" IsReadOnly="True" />
                        <DataGridTextColumn Width="120*" MinWidth="120" Foreground="Black" Binding="{Binding Contingency}" CanUserReorder="False" Header="Contingency" IsReadOnly="True" />

                        <DataGridTextColumn Width="200*" MinWidth="200" Foreground="Black" Binding="{Binding Family}" CanUserReorder="True" Header="Family" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <DataGrid Name="resultsDataGrid" Margin="0" AlternatingRowBackground="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}" 
					  AreRowDetailsFrozen="True" AutoGenerateColumns="False" CanUserAddRows="False" CellStyle="{StaticResource defCStyle}" 
					  GridLinesVisibility="All" ItemsSource="{Binding VectorList}" 
					  SelectedCellsChanged="DataGrid_SelectedCellsChanged" BorderThickness="2" >
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="LMPGraph_Click" Header="Show LMP Graphs" />
                        <MenuItem Click="NodeAnalyzer_Click" Header="Node Spread Analyzer " />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Width="170*" Binding="{Binding Source}" CanUserReorder="False" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{Binding DataContext.SourceHeaderName,RelativeSource={RelativeSource AncestorType=Window}}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Width="170*" Binding="{Binding Sink}" Visibility="{Binding Source={x:Reference typeCombo}, 
						Path=SelectedItem, Converter={StaticResource inverseBooleanToVisibilityConverter}}" CanUserReorder="False" Header="Sink" IsReadOnly="True"  />
                    <DataGridTextColumn Width="170*" Binding="{Binding SourceSensitivity,
					                                      StringFormat=0.000}" CanUserReorder="False" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{Binding DataContext.SourceSensitivityHeaderName,RelativeSource={RelativeSource AncestorType=Window}}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Width="170*" Binding="{Binding SinkSensitivity,
					                                      StringFormat=0.000}" CanUserReorder="False" Header="Sink Sensitivity" IsReadOnly="True" Visibility="{Binding Source={x:Reference typeCombo}, 
						Path=SelectedItem, Converter={StaticResource inverseBooleanToVisibilityConverter}}" />
                    <DataGridTextColumn Width="170*" Binding="{Binding Sensitivity,
					                                      StringFormat=0.000}" CanUserReorder="False" Header="Sensitivity" IsReadOnly="True"
										Visibility="{Binding Source={x:Reference typeCombo}, 
						Path=SelectedItem, Converter={StaticResource inverseBooleanToVisibilityConverter}}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <ContentControl prism:RegionManager.RegionName="ContentRegion" />
    </Grid>
</Window>
