<Window x:Class="Vayu.Actualvs7DayLoad.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="False"
        Title="Actual vs 7 Day Load" Height="900" Width="955">
    <Grid Background="Teal">
        <Grid.RowDefinitions>
            <RowDefinition Height="75" />
            <RowDefinition Height="700" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0"
		            Margin="3"
		            Orientation="Horizontal">
            <StackPanel Orientation="Vertical">
                <StackPanel Margin="2" Orientation="Horizontal">
                    <TextBlock Margin="5,4,0,0"
					           VerticalAlignment="Center"
					           Text="From" />
                    <DatePicker Margin="15,4,0,0" SelectedDate="{Binding FromSelectedDate, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Margin="2" Orientation="Horizontal">
                    <TextBlock Margin="5,4,0,0"
					           VerticalAlignment="Center"
					           Text="To    " />
                    <DatePicker Margin="15,4,0,0" SelectedDate="{Binding EndSelectedDate, Mode=TwoWay}" />
                </StackPanel>

            </StackPanel>
            <StackPanel Orientation="Vertical">
                <ComboBox Width="120"
				          Height="25"
				          Margin="8,3,0,0"
				          VerticalContentAlignment="Center"
				          IsEditable="True"
				          ItemsSource="{Binding ZoneList}"
				          SelectedItem="{Binding ZoneSelectedItem,
				                                 Mode=TwoWay}" />
                <Button Width="120"
				        Height="27"
				        Margin="8,4,0,0"
				        Command="{Binding RefreshCommand}"
				        Content="Refresh" />
            </StackPanel>
            <StackPanel Orientation="Vertical">

                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="ISO" IsChecked="{Binding CURRENTChecked, Mode=TwoWay}" />
                    <CheckBox Content="ISO Forecast" IsChecked="{Binding ISOChecked, Mode=TwoWay}" />
                    <CheckBox Content="ISO 5DAY AVG" IsChecked="{Binding ISO5DAYAvgChecked, Mode=TwoWay}" />
                    <CheckBox Content="ISO 8DAY AVG" IsChecked="{Binding ISO8DAYAvgChecked, Mode=TwoWay}" />
                    <CheckBox Content="ISO 13DAY AVG" IsChecked="{Binding ISO13DAYAvgChecked, Mode=TwoWay}" />
                    <CheckBox Content="ISO 21DAY AVG" IsChecked="{Binding ISO21DAYAvgChecked, Mode=TwoWay}" />
                    <StackPanel.Resources>
                        <Style TargetType="CheckBox">
                            <Setter Property="Margin" Value="20,2,0,0" />
                        </Style>
                    </StackPanel.Resources>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <StackPanel Width="180"
					            Margin="25,20,0,0"
					            Orientation="Horizontal">
                        <TextBlock Text="Update Time:" ToolTip="Updated only on Callback" />
                        <TextBlock Margin="5,0,0,0" Text="{Binding UpdateTime, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <oxy:PlotView Grid.Row="1"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
		          Height="Auto"
		          Margin="0,2,10,188"
		          VerticalContentAlignment="Stretch"
		          Background="Black"
		          BorderBrush="Gray"
		          BorderThickness="1"
		          Model="{Binding PlotDataModel}"  />
        <oxy:PlotView Grid.Row="1" ScrollViewer.VerticalScrollBarVisibility="Auto"
					          BorderBrush="Gray"
					          BorderThickness="1"
					          Model="{Binding PlotModelUpper}" Height="250" VerticalAlignment="Bottom" Margin="5,0,0,-65">
        </oxy:PlotView>
        <ContentControl prism:RegionManager.RegionName="ContentRegion" />
    </Grid>
</Window>
