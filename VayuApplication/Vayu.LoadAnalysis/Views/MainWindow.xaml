<Window  
        x:Class="Vayu.LoadAnalysis.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
    xmlns:oxplot="http://oxyplot.org/wpf"
        prism:ViewModelLocator.AutoWireViewModel="False"
       Title="VAYU- Load Analysis"  Height="750" Width="825">
    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="HeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="22" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="250"/>
            <RowDefinition Height="20"/> 
            <RowDefinition/> 
        </Grid.RowDefinitions>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top"   FontWeight="Bold" FontSize="14" Grid.Row="1"  TextAlignment="Left" Text="Hour :" />
        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Label   HorizontalContentAlignment="Center" Grid.Row="0" Grid.Column="1" BorderBrush="LightGray">Source</Label>
                <Label   HorizontalContentAlignment="Center" Grid.Row="0" Grid.Column="2" BorderBrush="LightGray">Sink</Label>
                <TextBlock  HorizontalAlignment="Stretch"  Grid.Row="1" Grid.Column="0" TextAlignment="Center"  Text="Zone" />
                <TextBlock  HorizontalAlignment="Stretch"  Grid.Row="2" Grid.Column="0" TextAlignment="Center"  Text="Cong" />
                <TextBlock  HorizontalAlignment="Stretch"  Grid.Row="3" Grid.Column="0" TextAlignment="Center"  Text="LMP" />
                <TextBlock  HorizontalAlignment="Stretch"  Grid.Row="5" Grid.Column="0" TextAlignment="Center"  Text="Spread" />
                <TextBlock   HorizontalAlignment="Stretch" Grid.Column="1" Grid.Row="1" TextAlignment="Center"  Text="{Binding SourceSink.Source.Zone}" />
                <TextBlock   HorizontalAlignment="Stretch" Grid.Column="2" Grid.Row="1" TextAlignment="Center" Text="{Binding SourceSink.Sink.Zone}" />
                <TextBlock   HorizontalAlignment="Stretch" Grid.Column="1" Grid.Row="2"   TextAlignment="Center"  Text="{Binding SourceCong, StringFormat={}\{0:N\}}" />
                <TextBlock   HorizontalAlignment="Stretch" Grid.Column="2" Grid.Row="2"  TextAlignment="Center" 
                                   Text="{Binding SinkCong, StringFormat={}\{0:N\}}" />
                <TextBlock  HorizontalAlignment="Stretch" Grid.Column="1" Grid.Row="4" TextAlignment="Center" Text="MAX" />
                <TextBlock  HorizontalAlignment="Stretch" Grid.Column="2" Grid.Row="4" TextAlignment="Center" 
                                       Text="Min" />
                <TextBlock   HorizontalAlignment="Stretch" TextAlignment="Center"  Grid.Column="1" Grid.Row="3"
                                       Text="{Binding SourcePrice, StringFormat={}\{0:N\}}" />
                <TextBlock   HorizontalAlignment="Stretch"   TextAlignment="Center" Grid.Column="2" Grid.Row="3"
                                   Text="{Binding SinkPrice, StringFormat={}\{0:N\}}" />
                <TextBlock   HorizontalAlignment="Stretch" Grid.Column="1" Grid.Row="5" TextAlignment="Center" 
                                       Text="{Binding MaxDart, StringFormat={}\{0:N\}}" />
                <TextBlock   HorizontalAlignment="Stretch" Grid.Column="2" Grid.Row="5" TextAlignment="Center" 
                                   Text="{Binding MinDart, StringFormat={}\{0:N\}}" />
                <DataGrid HorizontalAlignment="Stretch" AlternatingRowBackground="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}" ItemsSource="{Binding ZoneLoads}" ColumnHeaderStyle="{StaticResource HeaderStyle}"
                              AutoGenerateColumns="False" CanUserDeleteRows="False" CanUserAddRows="False" 
                      VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto"  Grid.Row="6" Grid.ColumnSpan="3" Margin="0,0,-0.333,-69">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="" Width="95*" Binding="{Binding ZoneType}" CanUserReorder="False" IsReadOnly="True" />
                        <DataGridTextColumn Header="Name" Width="120*" Binding="{Binding ZoneName}" CanUserReorder="False" IsReadOnly="True" />
                        <DataGridTextColumn Header="Load" Width="100*" Binding="{Binding MegaWatts}" CanUserReorder="False" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <oxplot:PlotView Grid.Row="1" Grid.Column="1"   Background="AliceBlue" Model="{Binding PlotModel}" BorderThickness="1" BorderBrush="Gray"  />
        </Grid>
        <DataGrid  Grid.Row="2" HorizontalAlignment="Stretch" ItemsSource="{Binding ConstraintContingencyList, Mode=TwoWay}" AlternatingRowBackground="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}"
                              AutoGenerateColumns="False" CanUserDeleteRows="False" CanUserAddRows="False" VerticalScrollBarVisibility="Visible" 
                   HorizontalScrollBarVisibility="Visible" RowHeight="21" >
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Constraint}" CanUserReorder="False" Header="Constraint" IsReadOnly="True" 
                                                Width="150*"  />
                <DataGridTextColumn Binding="{Binding Contingency}" CanUserReorder="False" Header="Contingency" IsReadOnly="True"
                                                Width="300*" />
                <DataGridTextColumn Binding="{Binding ShadowPrice, StringFormat={}\{0:N\}}" CanUserReorder="False" Header="Shadow Price" IsReadOnly="True" 
                                                Width="Auto" MinWidth="70" />
            </DataGrid.Columns>
        </DataGrid>
        <ContentControl prism:RegionManager.RegionName="ContentRegion" />
    </Grid>
</Window>
