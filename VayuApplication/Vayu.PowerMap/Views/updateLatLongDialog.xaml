<Window x:Class="Vayu.PowerMap.Views.updateLatLongDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"             
             prism:ViewModelLocator.AutoWireViewModel="False">
    <Grid> 
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100*"></ColumnDefinition>
            <ColumnDefinition Width="100*"/>
            <ColumnDefinition Width="100*"/>
            <ColumnDefinition Width="100*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="49*"/>
            <RowDefinition Height="47*"/>
            <RowDefinition Height="53*"/>
        </Grid.RowDefinitions>
        <Label Content="Node" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="0" Grid.Column="0" Height="23" Width="42" Padding="0" />
        <Label Content="Zone" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="0" Grid.Column="2" Height="20" Width="31" Padding="0" />

        <TextBox Name="nodeNameTextBox" Text="" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="0" Grid.Column="1" IsReadOnly="True" Height="23" Width="90" Padding="0" />
        <TextBox Name="nodeZoneTextBox" Text="" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="0" Grid.Column="3" IsReadOnly="True" Height="20" Width="90" Padding="0" />

        <Label Content="Old Latitude" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="1" Grid.Column="0" Height="23" Width="90" Padding="0" />
        <Label Content="Old Longitude" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="1" Grid.Column="2" Height="23" Width="90" Padding="0" />

        <TextBox Name="oldLatitudeTextBox" Text="" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Height="23" Width="90" Padding="0" />
        <TextBox Name="oldLongitudeTextBox" Text="" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="1" Grid.Column="3" IsReadOnly="True" Height="20" Width="90" Padding="0" />

        <Label Content="New Latitude" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="2" Grid.Column="0" Height="23" Width="90" Padding="0" />
        <Label Content="New Longitude" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="2" Grid.Column="2" Height="23" Width="90" Padding="0" />

        <TextBox Name="newLatitudeTextBox" Text="" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="2" Grid.Column="1" Height="23" Width="90" Padding="0" />
        <TextBox Name="newLongitudeTextBox"  Text="" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="2" Grid.Column="3" Height="20" Width="90" Padding="0" />

        <Button Content="Save" Name="saveButton" Grid.Column="1" HorizontalAlignment="Left" Margin="13,10.276,0,0" Grid.Row="3" VerticalAlignment="Top" Width="75"
                 Click="Button_Click" />
        <Button Content="Cancel" Name="cancelButton" Grid.Column="2" HorizontalAlignment="Left" Margin="10,10.276,0,0" Grid.Row="3" VerticalAlignment="Top" Width="75"
                  IsCancel="True" />
    </Grid>
</Window>
