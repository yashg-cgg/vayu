<Window   
                 x:Class="Vayu.PowerMap.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:Usercontrol="clr-namespace:Vayu.PowerMap.Model"
        xmlns:prism="http://prismlibrary.com/"
      xmlns:my1="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls.Input.Toolkit"
    xmlns:local="clr-namespace:Vayu.PowerMap.Views" 
                 xmlns:xm="clr-namespace:Vayu.PowerMap.ViewModels"
    xmlns:uc="clr-namespace:Vayu;assembly=Vayu.CommonControls" xmlns:uc1="clr-namespace:Vayu.PowerMap.Controls"
                 prism:ViewModelLocator.AutoWireViewModel="True"
                  DataContext="{Binding RelativeSource={RelativeSource Self}}"  
        Title="Power Map" Height="900" Width="1600" WindowState="Maximized"  WindowStyle="SingleBorderWindow">
    <Window.Resources>
        <ResourceDictionary>
            <local:ComparisonConverter x:Key="ComparisonConverter"/>
            <SolidColorBrush x:Key="textFourground" Color="Black"/>
            <ContextMenu x:Key="outage_contextMenu"
			             Background="Lavender"
			             FontWeight="DemiBold">
                <MenuItem Click="navigateMenuItem_Click" Header="Navigate" />
                <MenuItem Click="history_MenuItem_Click" Header="Show History" />
                <MenuItem Click="Constraints_MenuItem_Click" Header= "Historical Constraints" />
                <MenuItem Click="congestion_MenuItem_Click" Header="Congestion" />
            </ContextMenu>
            <ContextMenu x:Key="contextMenu"
			             Background="Lavender"
			             FontWeight="DemiBold">
                <MenuItem Click="navigateMenuItem_Click" Header="Navigate" />
                <MenuItem Click="PlaceMarkClear_MenuItem_Click" Header="ClearMarks" />
                <!--<MenuItem Header="Node Spread Analysis" Click="NodeSpreadAnalysis_MenuItem_Click" />-->
            </ContextMenu>
            <ContextMenu x:Key="iirOutage_contextMenu"
                         Background="Lavender"
                         FontWeight="DemiBold">
                <MenuItem Click="navigateMenuItem_Click" Header="Navigate"/>
                <MenuItem Click="iirHistory_MenuItem_Click" Header="Show History"/>
            </ContextMenu>
            <xm:MainWindowViewModel x:Key="mMakert" />


            <Style TargetType="TabItem" x:Key="TabItemHeaderStyle">
                <Setter Property="Background" Value="LightBlue"/>
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="FontSize" Value="11.5px" />

                <!-- Add more setters for other properties as needed -->
            </Style>


            <Style TargetType="TabItem" x:Key="TabItemHeaderStyle1">
                <Setter Property="Background" Value="LightBlue"/>
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="FontSize" Value="12px" />

                <!-- Add more setters for other properties as needed -->
            </Style>

        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="LayoutRoot" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="3.5*" />
            <RowDefinition Height="5*" />
        </Grid.RowDefinitions>
        <Expander Grid.Row="0" IsExpanded="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="0.15*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Row="0" Grid.Column="0" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.8*"/>
                        <RowDefinition Height="0.8*"/>
                        <RowDefinition Height="6*"/>
                        <RowDefinition Height="0.1*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Markets" HorizontalAlignment="Left" VerticalAlignment="Center"  Width="83px"/>
                    <ComboBox Grid.Column="1" x:Name="MarketlistBox" SelectionChanged="MarketlistBox_SelectionChanged"
                                           ItemsSource="{Binding Markets.Keys}" Width="89px"   HorizontalAlignment="Left" Margin="-15 0 0 0">
                        <ComboBox.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}">LightGreen</SolidColorBrush>
                        </ComboBox.Resources>
                        <ComboBox.DataContext>
                            <StaticResource ResourceKey="mMakert"/>
                        </ComboBox.DataContext>
                    </ComboBox>
                    <Button x:Name="Refreshbutton"  Grid.Column="2" Click="Refreshbutton_Click" Content="Refresh" FontWeight="Bold"  Width="80px" 
                            HorizontalAlignment="Left" Margin="-25 0 0 0"/>
                    <Button Name="PlayButton" Content="Play"  Grid.Column="0" Grid.Row="1" Click="Play" Width="83px" HorizontalAlignment="Left" Margin="2 0 0 -1"/>

                    <Button Name="PauseButton" Content="Pause"   Grid.Column="1" Grid.Row="1" Click="Pause"  Width="89px" HorizontalAlignment="Left" Margin="-15 1 0 -1"/>
                    <Button Name="StopButton" Content="Stop" Grid.Column="2" Grid.Row="1"  Click="Stop"  Width="80px" HorizontalAlignment="Left" Margin="-25 1 0 0"/>
                    <uc:CalendarSlider Grid.Row="2" Grid.ColumnSpan="3" Background="Azure" x:Name="MainCalendarSilder"
						PropertyChanged="MainCalendarSilderPropertyChanged" Height="120px"  Margin="0 1 0 1"/>
                </Grid>
                <Grid Grid.Column="1">
                    <GroupBox Name="groupBox1" 
					          BorderBrush="#FF030303"
					          Header="Zone"
                              Margin="-50 0 0 0 ">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="4*"/>
                                <RowDefinition Height="0.8*"/>
                                <RowDefinition Height="0.8*"/>
                            </Grid.RowDefinitions>
                            <ListBox Name="ZoneListBox" Background="Azure"
							         VerticalAlignment="Stretch"
							         ItemsSource="{Binding ZoneList}"
							         SelectionChanged="ZoneListBox_SelectionChanged"
							         SelectionMode="Multiple">
                                <ListBox.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}">LightGreen</SolidColorBrush>
                                </ListBox.Resources>
                            </ListBox>
                            <Button Name="ZoneSelectAllButton"   Grid.Row="1" Margin="0 0 0 2"
								        Click="ZoneSelectAllButton_Click"
								        Content="Select All" />
                            <Button Name="ZoneUnSelectAllButton" Grid.Row="2" Margin="0 0 0 2"
								        Click="ZoneUnSelectAllButton_Click"
								        Content="UnSelect All" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                            </Grid>
                        </Grid>
                    </GroupBox>
                </Grid>
                <Grid Grid.Column="2" Grid.ColumnSpan="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="0.39*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="LMP Prices">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <GroupBox Header="Type">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <ListBox x:Name="LMPEquipmentTypeListBox" 
                                                 ItemsSource="{Binding LmpEquipmentList}"
										         SelectionChanged="LMPEquipmentTypeListBox_SelectionChanged"
										         SelectionMode="Multiple">
                                            <ListBox.Resources>
                                                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}">LightGreen</SolidColorBrush>
                                            </ListBox.Resources>
                                        </ListBox>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button  Grid.Column="0" Margin="2 0 2 0 "
											        Click="LMPEquipmentTypeSelectAllButton_Click"
											        Content="Select All" />
                                            <Button  Grid.Column="1" Margin="0 0 0 -1"
											        Click="LMPEquipmentTypeUnSelectAllButton_Click"
											        Content="UnSelect All" />
                                        </Grid>
                                    </Grid>

                                </GroupBox>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <RadioButton x:Name="LMP_RT_radioButton"
								             Grid.Column="0" Grid.Row="1"
								             Content="RT" Margin="3" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
								             IsChecked="{Binding SelectedLMPPriceType,
								                                 ConverterParameter={x:Static Usercontrol:LMPPriceType.RT},
								                                 Converter={StaticResource ResourceKey=ComparisonConverter}}"
								             Style="{StaticResource {x:Type ToggleButton}}"  />
                                    <RadioButton x:Name="LMP_DA_radioButton"  Grid.Column="1" Grid.Row="1"
								             Content="DA" Margin="3" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
								             IsChecked="{Binding SelectedLMPPriceType,
								                                 ConverterParameter={x:Static Usercontrol:LMPPriceType.DA},
								                                 Converter={StaticResource ResourceKey=ComparisonConverter}}"
								             Style="{StaticResource {x:Type ToggleButton}}"   />
                                    <RadioButton x:Name="LMP_DART_radioButton"  Grid.Column="2" Grid.Row="1"
								             Content="DART" Margin="3" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
								             IsChecked="{Binding SelectedLMPPriceType,
								                                 ConverterParameter={x:Static Usercontrol:LMPPriceType.DART},
								                                 Converter={StaticResource ResourceKey=ComparisonConverter}}"
								             Style="{StaticResource {x:Type ToggleButton}}" />
                                    <CheckBox x:Name="RT5Latest" Margin="1.5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
								          Grid.Column="0" Grid.Row="2"
								          Content="RT-5 Latest"
								          IsChecked="{Binding SelectedLMPPriceType,
								                              ConverterParameter={x:Static Usercontrol:LMPPriceType.RT5},
								                              Converter={StaticResource ResourceKey=ComparisonConverter}}"
								          Style="{StaticResource {x:Type ToggleButton}}" />
                                    <CheckBox x:Name="RT5Max"  Grid.Column="1" Grid.Row="2"
								          Content="RT-5 Max" Margin="2 2 2 2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
								          IsChecked="{Binding SelectedLMPPriceType,
								                              ConverterParameter={x:Static Usercontrol:LMPPriceType.RT5Max},
								                              Converter={StaticResource ResourceKey=ComparisonConverter}}"
								          Style="{StaticResource {x:Type ToggleButton}}"   />
                                    <CheckBox x:Name="RT5Min"  Grid.Column="2" Grid.Row="2"
								          Content="RT-5 Min" Margin=" 0 0 0 2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
								          IsChecked="{Binding SelectedLMPPriceType,
								                              ConverterParameter={x:Static Usercontrol:LMPPriceType.RT5Min},
								                              Converter={StaticResource ResourceKey=ComparisonConverter}}"
								          Style="{StaticResource {x:Type ToggleButton}}"   />

                                    <CheckBox x:Name="LiveCheckBox"  Grid.Row="0" Grid.Column="2" Margin="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
								          Checked="LiveCheckBox_Checked" Content="Live"/>
                                    <CheckBox x:Name="UptoCheckBox"   HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
									 Grid.Row="0" Grid.ColumnSpan="2"	 Margin=" 0 0 0 -1"						         
									Content="{Binding LMPFilterToggle}"
									IsChecked="{Binding LMPPJMUpTo}"
									Style="{StaticResource {x:Type ToggleButton}}" />
                                </Grid>
                            </Grid>
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="Temp Range">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <RadioButton x:Name="Temp_Avg_radioButton"   Content="Avg" Margin="3" HorizontalContentAlignment="Center"
 VerticalContentAlignment="Center"                                                Style="{StaticResource {x:Type ToggleButton}}" Checked="Temp_radioButton_Checked"/>
                                <RadioButton x:Name="Temp_Max_radioButton"  Grid.Row="1" IsEnabled="False"  Checked="Temp_radioButton_Checked" Content="Max"  Margin="3" HorizontalContentAlignment="Center"
 VerticalContentAlignment="Center"  
                                               Style="{StaticResource {x:Type ToggleButton}}"/>
                                <RadioButton x:Name="Temp_Min_radioButton"  Grid.Row="2"  IsEnabled="False" Checked="Temp_radioButton_Checked" Content="Min"  Margin="3" HorizontalContentAlignment="Center"
 VerticalContentAlignment="Center"    Style="{StaticResource {x:Type ToggleButton}}"/>

                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Constraints" Grid.Column="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <GroupBox Header="Type">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <ListBox x:Name="ConstraintEquipmentTypeListBox"
										         ItemsSource="{Binding ConstraintEquipmentTypeList}"
										         
										         SelectionChanged="ConstraintEquipmentTypeListBox_SelectionChanged"
										         SelectionMode="Multiple">
                                            <ListBox.Resources>
                                                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}">LightGreen</SolidColorBrush>
                                            </ListBox.Resources>
                                        </ListBox>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button  		 Margin="0 0 2 0"									        Click="ConstraintEquipmentTypeSelectAllButton_Click"
											        Content="Select All" />
                                            <Button  Grid.Column="1" Margin="0 0 2 0"
											        Click="ConstraintEquipmentTypeUnSelectAllButton_Click"
											        Content="UnSelect All" />
                                        </Grid>
                                    </Grid>
                                </GroupBox>
                                <GroupBox Header="Price" Grid.Column="2">
                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                          
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="Constraint_MinPrice_textBox" Grid.Row="0"  Grid.Column="0"  Width="45px" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"  Margin="0 0 2 1"  Text="Min" />
                                        <TextBox x:Name="Constraint_MaxPrice_textBox" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Column="1"  Margin="0 0 2 1" Text="Max" />
                                        <RadioButton x:Name="Constraint_5M_radioButton"  Grid.Column="0" Grid.Row="1"
								                 Content="RT-5" Margin="1.5"
								                 IsChecked="{Binding SelectedConstraintPriceType,
								                                     ConverterParameter={x:Static Usercontrol:ConstraintPriceType.RT5Min},
								                                     Converter={StaticResource ResourceKey=ComparisonConverter}}"
								                 IsEnabled="False"
								                 Style="{StaticResource {x:Type ToggleButton}}"  Width="39px" HorizontalAlignment="Left"/>
                                        <RadioButton x:Name="Constraint_RT_radioButton"  Grid.Column="1" Grid.Row="1"
								                 Content="RT" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"  Margin="1.5"
								                 IsChecked="{Binding SelectedConstraintPriceType,
								                                     ConverterParameter={x:Static Usercontrol:ConstraintPriceType.RT},
								                                     Converter={StaticResource ResourceKey=ComparisonConverter}}"
								                 Style="{StaticResource {x:Type ToggleButton}}"  Width="39px"/>
                                        <RadioButton x:Name="Constraint_DA_radioButton"  Grid.Column="2" Grid.Row="1"
								                 Content="DA"  Margin="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
								                 IsChecked="{Binding SelectedConstraintPriceType,
								                                     ConverterParameter={x:Static Usercontrol:ConstraintPriceType.DA},
								                                     Converter={StaticResource ResourceKey=ComparisonConverter}}"
								                 Style="{StaticResource {x:Type ToggleButton}}"  Width="39px" />
                                    </Grid>
                                </GroupBox>
                            </Grid>
                        </GroupBox>
                        <GroupBox HorizontalAlignment="Left" Grid.Column="3"
						          VerticalAlignment="Stretch"
						          BorderBrush="#FF030303"
						          Header="Transmission">
                            <Grid VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="AUTO" />
                                    <RowDefinition Height="40" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <TextBox x:Name="Transmisson_MaxKV_Textbox"
									                       Width="44"
									                       Height="23"
									                       Margin="0,0,0,0"
									                       HorizontalAlignment="Left"
									                       VerticalAlignment="Top"
									                       Text="765kv" />
                                    <Label x:Name="label17"
									       Width="15"
									       Height="24"
									       Margin="0,0,0,0"
									       HorizontalAlignment="Center"
									       VerticalAlignment="Center"
									       Content="-" />
                                    <TextBox x:Name="Transmisson_MinKV_Textbox"
									                       Width="42"
									                       Height="23"
									                       Margin="0,0,0,0"
									                       HorizontalAlignment="Left"
									                       VerticalAlignment="Top"
									                       Text="69kv" />
                                </StackPanel>
                                <CheckBox x:Name="checkBox1"
								          Grid.Row="1"
								          Margin="1,0,0,0"
								          HorizontalAlignment="Center"
								          VerticalAlignment="Center"
								          Content="Show Stations"
								          IsChecked="{Binding Transmissionshowstation}"
								          Style="{StaticResource {x:Type ToggleButton}}" />
                            </Grid>
                        </GroupBox>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <GroupBox BorderBrush="#FF030303"
						          Header="Outages">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <GroupBox Header="Type" BorderBrush="#FF030303">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>
                                            
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <ListBox x:Name="OutageEquipmentTypeListBox" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
										           ItemsSource="{Binding OutageEquipmentList}"
										         SelectionChanged="OutageEquipmentTypeListBox_SelectionChanged"
										         SelectionMode="Multiple">
                                            <ListBox.Resources>
                                                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" >LightGreen</SolidColorBrush>
                                            </ListBox.Resources>
                                        </ListBox>

                                        <Button  Click="OutageEquipmentTypeSelectAllButton_Click"
											        Content="Select All"  Grid.Row="0" Grid.Column="1" />
                                        <Button Grid.Row="1" Grid.Column="1"  Margin="0 0 0 2"
											        Click="OutageEquipmentTypeUnSelectAllButton_Click"
											        Content="UnSelect All" />
                                        
                                        <!--<Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button  Grid.Column="0" Margin="0 0 2 2"
											        Click="OutageEquipmentTypeSelectAllButton_Click"
											        Content="Select All" />
                                            <Button  Grid.Column="1"  Margin="0 0 0 2"
											        Click="OutageEquipmentTypeUnSelectAllButton_Click"
											        Content="UnSelect All" />
                                        </Grid>-->
                                    </Grid>
                                </GroupBox>
                                <GroupBox Header="" Grid.Column="1" BorderBrush="#FF030303">

                                    <Grid >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            
                                        </Grid.RowDefinitions>

                                        <Label x:Name="label9" Grid.Column="0" Grid.Row="0"  Content="Volt" HorizontalAlignment="Center" />
                                        <TextBox x:Name="OutageMinKVTextBox"  Grid.Column="1" Grid.Row="0"  Text="{Binding MinVoltText, Mode=TwoWay}"  BorderBrush="Black" HorizontalAlignment="Center" VerticalAlignment="Center" MinHeight="0" MinWidth="0" Width="32px" />

                                        <Label x:Name="label8" Grid.Column="2" Grid.Row="0" Content="-"  HorizontalAlignment="Center"/>

                                        <TextBox x:Name="OutageMaxKVTextBox"  Grid.Column="3" Grid.Row="0"   Text="{Binding MaxVoltText, Mode=TwoWay}"  BorderBrush="Black" HorizontalAlignment="Center" VerticalAlignment="Center" MinHeight="0" MinWidth="0" Width="32px" />

                                        <Label x:Name="label2" Grid.Row="1" Grid.Column="0"  Content="Dur" HorizontalAlignment="Center" VerticalAlignment="Center" MinHeight="0" MinWidth="0" />

                                        <TextBox x:Name="OutageDurationMinWatermarkTextBox"  Grid.Row="1" Grid.Column="1"    Text="{Binding MinText,Mode=TwoWay}"  BorderBrush="Black"  HorizontalAlignment="Center" VerticalAlignment="Center" MinHeight="0" MinWidth="0" Width="32px"/>

                                        <Label x:Name="label1"  Grid.Row="1" Grid.Column="2" Content="-"  HorizontalAlignment="Center"/>

                                        <TextBox x:Name="OutageDurationMaxWatermarkTextBox"  Grid.Row="1" Grid.Column="3"  Text="{Binding MaxText,Mode=TwoWay}"    BorderBrush="Black" HorizontalAlignment="Center" VerticalAlignment="Center" MinHeight="0" MinWidth="0" Width="32px">

                                            <TextBox.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform />
                                                    <SkewTransform />
                                                    <RotateTransform Angle="0.333" />
                                                    <TranslateTransform />
                                                </TransformGroup>
                                            </TextBox.RenderTransform>
                                        </TextBox>

                                        <!--<Label x:Name="label12" Grid.Row="2" Grid.Column="0"   Content="Status"  HorizontalAlignment="Center" VerticalAlignment="Center" MinHeight="0" MinWidth="0"/>
                                        <Label x:Name="label11"  Grid.Row="2" Grid.Column="1" Content=""  HorizontalAlignment="Center"/>
                                        <CheckBox x:Name="Outage_Excludecomplete_checkBox"
									              Content="Completed"
									              IsChecked="{Binding OutagesIncludeComplete,
									                                  Mode=TwoWay}"  Grid.Row="2" Grid.Column="2"   Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Center" MinHeight="0" MinWidth="0"/>-->
                                    </Grid>

                                </GroupBox>

                                <GroupBox BorderBrush="#FF030303" Header="Type" Grid.Row="0" Grid.Column="2" Margin="10,1,10,1">
                                    <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                   
                                        
                                            <CheckBox x:Name="Outage_Forced_checkBox"
										              
										              Content="Forced"
										              IsChecked="{Binding OutagesStatusForced,
										                                  Mode=TwoWay}" 
                                                      Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"/>
                                            
                                            
                                            <CheckBox x:Name="Outage_Planned_checkBox"
										              Content="Planned"    
										              IsChecked="{Binding OutagesStatusPlanned,
										                                  Mode=TwoWay}"   Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"/>


                                        <Label x:Name="label12" Grid.Row="2"  Grid.Column="0"  Content="Status"  HorizontalAlignment="Left" VerticalAlignment="Center" Margin=" -8 -1 0 -4"/>
                                        <CheckBox x:Name="Outage_Excludecomplete_checkBox"    Grid.Row="2"  Grid.Column="1" Content="Completed" IsChecked="{Binding OutagesIncludeComplete,
									                                  Mode=TwoWay}"  HorizontalAlignment="Left" Margin="-8" Grid.ColumnSpan="2"/>

                                   
                                    </Grid>
                                </GroupBox>


                                <GroupBox    BorderBrush="#FF030303"   Header="Planned Open/Close" Grid.Column="3">
                                    <Grid >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                   
                                        
                                        
                                            <CheckBox x:Name="Outage_Open_checkBox"
                                                      Grid.Row="0"
										              Height="22"
										              HorizontalAlignment="Left"
										              Content="Open"
										              IsChecked="{Binding OutageOpen,
										                                  Mode=TwoWay}" />
                                            <CheckBox x:Name="Outage_Close_checkBox"
                                                       Grid.Row="1"
										              Height="22"
										              
										              HorizontalAlignment="Left"
										              Content="Close"
										              IsChecked="{Binding OutageClose,
										                                  Mode=TwoWay}" />
                                       
                                  
                                   
                                </Grid>
                                </GroupBox>
                                <GroupBox   Grid.Column="4" Header="Type"
								              BorderBrush="#FF030303" >
                                    <Grid>
                                        <!--<Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>-->
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        
                                        <RadioButton x:Name="Outage_Actual_radioButton"
										                  Grid.Row="0"
										                 Checked="Outage_Actual_radioButton_Checked"
										                 Content="Actual"
										                 GroupName="OutageActualPlanned"
