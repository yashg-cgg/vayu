<Window    x:Class="Vayu.PowerMap.Views.Congestion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"             
             prism:ViewModelLocator.AutoWireViewModel="False">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <DataGrid Grid.Column="0" Margin="0,0,0,0" VerticalAlignment="Stretch" ItemsSource="{Binding CongestionList, Mode=TwoWay}" 
                  AutoGenerateColumns="False" CanUserAddRows="False" HorizontalScrollBarVisibility="Visible" HorizontalContentAlignment="Stretch" ScrollViewer.CanContentScroll="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Visible" SelectionUnit="Cell" AlternatingRowBackground="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Equipment}" CanUserReorder="False" Header="Equipment" IsReadOnly="True" Width="150" />
                <DataGridTextColumn Binding="{Binding Zone}" CanUserReorder="False" Header="Zone" IsReadOnly="True" Width="150" />
                <DataGridTextColumn Binding="{Binding MarketDate, StringFormat=MMM-dd-yy}" CanUserReorder="False" Header="Market Date" IsReadOnly="True" Width="120" MinWidth="80" />
                <DataGridTextColumn Binding="{Binding ShadowPrice, StringFormat={}\{0:N0\}}" CanUserReorder="False" Header="Shadow Price" IsReadOnly="True" Width="120" MinWidth="80" />
                <DataGridTextColumn Binding="{Binding MaxLoad, StringFormat={}\{0:N0\}}" CanUserReorder="False" Header="Max Load" IsReadOnly="True" Width="120" MinWidth="80" />
                <DataGridTextColumn Binding="{Binding ConstraintName}" CanUserReorder="False" Header="Constraint" IsReadOnly="True" Width="200" />
                <DataGridTextColumn Binding="{Binding ContingencyName}" CanUserReorder="False" Header="Contingency" IsReadOnly="True" Width="800" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
