<Window x:Class="Vayu.CRRPNLDetails.Views.MainWindow"
                  
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:vm="clr-namespace:Vayu.CRRPNLDetails.ViewModels"
       
        xmlns:local="clr-namespace:Vayu.CRRPNLDetails.Views"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="False"
          Width="1470"
        Title="LTC PNL"   WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Window.Resources>
        <ResourceDictionary>

            <vm:DataGridBackColorConverter x:Key="myBGColor"/>
            <vm:ValueToForegroundColorConverter x:Key="ValueToForeground"/>
            <local:TextColumnConverter x:Key="textColumnConverter"/>
            <Style x:Key="CenterCellStyleBG" TargetType="{x:Type DataGridCell}">
                <Setter Property="Foreground" 
                        Value="{Binding RelativeSource={RelativeSource Self},
                        Path=Content.Text, 
                        Converter={StaticResource myBGColor}}" />
            </Style>


        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,5,5,5">
            <GroupBox Header="Participants" Margin="0,0,10,0" BorderBrush="#FF1D1C1C">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Market" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center"/>
                    <Border BorderBrush="Black" BorderThickness="1" Grid.Row="1" Grid.Column="0">
                    <ListBox Height="80" Width="120"  ItemsSource="{Binding MarketList}" SelectedItem="{Binding MarketSelected}" />
                    </Border>
                    <TextBlock Text="Type" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center"/>
                    <Border BorderBrush="Black" BorderThickness="1"  Grid.Row="1" Grid.Column="1">
                        <ListBox Height="80" Width="120"  ItemsSource="{Binding IntExtList}" SelectedItem="{Binding IntExtSelected}"/>
                    </Border>
                    <TextBlock Text="Account" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center"/>
                    <Border BorderBrush="Black" BorderThickness="1"  Grid.Row="1" Grid.Column="2">
                    <ListBox Height="80" ItemsSource="{Binding ParticipantsList}" SelectionMode="Multiple" Name="ParticipantList" SelectionChanged="ParticipantList_SelectionChanged" Margin="0,10,5,11"/>
                    </Border>
                    <Button Content="All" Height="25" Width="55" Grid.Row="2" Grid.Column="2" Click="Button_Click" />
                    <Button Content=">>>" Height="30" Width="50" Grid.Row="1" Grid.Column="3" Command="{Binding MovePaticipantCommand}"/>
                    <Border BorderBrush="Black" BorderThickness="1" Grid.Row="1" Grid.Column="4">
                    <ListBox Height="80"  ItemsSource="{Binding ParticipantsSelectedList}" SelectionChanged="ListBox_SelectionChanged" Name="ParticipantsSelectedList" SelectionMode="Multiple" Margin="0,10,0,11"/>
                    </Border>
                    <Button Content="Delete" Height="25" Width="55" Grid.Row="2" Grid.Column="4" Command="{Binding DeleteParticipantCommand}"/>
                </Grid>
            </GroupBox>
            <GroupBox Header="Month" Margin="0,0,10,0" Width="350" BorderBrush="#FF1D1C1C">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="25"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="90"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Year" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ComboBox Width="120" Height="25" Grid.Column="1" ItemsSource="{Binding DateList}" SelectedItem="{Binding SelectedDate}"/>
                    <Button Content="All" Grid.Row="2" Grid.Column="1" Height="25" Width="55" Click="Button_Click_1"/>
                    <Border BorderBrush="Black" BorderThickness="1" Grid.Row="1" Grid.Column="1">
                    <ListBox  ItemsSource="{Binding SelectedMonthList}" Name="SelectedMonthList" SelectionMode="Multiple" SelectionChanged="SelectedMonthList_SelectionChanged"/>
                    </Border>
                    <Button Content=">>>" Grid.Row="1" Grid.Column="2" Height="30" Width="50" Command="{Binding MoveDateCommand}"/>
                    <Button Content="YTD" Grid.Row="0" Grid.Column="3" Height="25" Width="55" Margin="-75,0,10,0" Command="{Binding TYDCommand}"/>
                    <Button Content="MTD" Grid.Row="0" Grid.Column="3" Height="25" Width="55" Margin="1,0,-85,0" Command="{Binding MTDCommand}"/>
                    <Border BorderBrush="Black" BorderThickness="1" Grid.Row="1" Grid.Column="3">
                    <ListBox  ItemsSource="{Binding DateSelectedList}" SelectionChanged="ListBox_SelectionChanged_1" SelectionMode="Multiple" Name="DateSelectedList"/>
                    </Border>
                    <Button Content="Delete" Grid.Row="2" Grid.Column="3" Height="25" Width="55" VerticalAlignment="Center" Margin="0,2,0,0" Command="{Binding DeleteDateCommand}"/>
                    <GroupBox Header="Sequence" Grid.Row="3" Grid.ColumnSpan="4" Margin="0,2,0,0">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox  Content="1" Margin="0,0,10,0" IsChecked="{Binding Seq1checked,Mode=TwoWay}"/>
                            <CheckBox  Content="2" Margin="0,0,10,0" IsChecked="{Binding Seq2checked,Mode=TwoWay}"/>
                            <CheckBox  Content="3" Margin="0,0,10,0" IsChecked="{Binding Seq3checked,Mode=TwoWay}"/>
                            <CheckBox  Content="4" Margin="0,0,10,0" IsChecked="{Binding Seq4checked,Mode=TwoWay}"/>
                            <CheckBox  Content="5" Margin="0,0,10,0" IsChecked="{Binding Seq5checked,Mode=TwoWay}"/>
                            <CheckBox  Content="6" Margin="0,0,10,0" IsChecked="{Binding Seq6checked,Mode=TwoWay}"/>
                        </StackPanel>
                        
                        
                        
                    </GroupBox>
                </Grid>
            </GroupBox>
            <GroupBox Header="Period Type" Margin="0,0,10,0" BorderBrush="#FF1D1C1C" BorderThickness="1">
                <StackPanel Orientation="Vertical">
                    
                    <CheckBox Content="Month" Margin="7,55,5,5" IsChecked="{Binding MonthChecked}"/>
                    <CheckBox Content="6 Month" Margin="7,25,5,5" IsChecked="{Binding LongTermChecked}"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Daily Type" Margin="0,0,10,0" BorderBrush="#FF1D1C1C">
                <StackPanel Orientation="Vertical">
                    <RadioButton x:Name="DApric" Content="DA Price" Margin="7,25,5,5" IsChecked="{Binding DAPriceChecked,Mode=TwoWay}" />
                    <RadioButton x:Name="RTpric" Content="RT Price" Margin="7,25,5,5" IsChecked="{Binding RTPriceChecked,Mode=TwoWay}" />
                    <RadioButton x:Name="PNLpric" Content="PNL" Margin="7,15,5,5" IsChecked="{Binding PNLChecked,Mode=TwoWay}"/>
                    <RadioButton x:Name="Costpric" Content="Cost" Margin="7,15,5,5" IsChecked="{Binding CostChecked,Mode=TwoWay}"/>
                    <RadioButton x:Name="MWhpric" Content="MWh" Margin="7,15,5,5" IsChecked="{Binding MWhChecked,Mode=TwoWay}" />
                </StackPanel>
            </GroupBox>
            <GroupBox Header="" Width="120" BorderBrush="#FF1D1C1C">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                    </Grid.RowDefinitions>
                    <Button Height="40" Grid.Row="0" Width="38" Command="{Binding ExportCSVCommand}">

                    </Button>
                    <Button Content="{Binding CombineButtonText}" Grid.Row="1" Height="30" Margin="4,0,4,0" Command="{Binding CombineCommand}" IsEnabled="{Binding CombineEnable, Mode=TwoWay}"/>
                    <Button Content="Generate Report" Grid.Row="2" Margin="4,5,4,1" Command="{Binding GenerateReportCommand}" IsEnabled="{Binding GenerateEnabled}"/>
                    <Button Content="Check Exposures" Grid.Row="3" Margin="4,5,4,1" Command="{Binding CheckExposureCommand}" IsEnabled="{Binding CheckExposureEnabled}"/>

                </Grid>
            </GroupBox>
            <GroupBox Header="Summary" Width="170" Margin="9,0,0,0" BorderBrush="#FF1D1C1C">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Cost" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" Margin="5,5,0,0"></TextBlock>
                    <TextBlock Text="RT Total" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" Margin="5,5,0,0"></TextBlock>
                    <TextBlock Text="DA Total" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" Margin="5,5,0,0"></TextBlock>
                    <TextBlock Text="PNL" Grid.Row="3" Grid.Column="0" HorizontalAlignment="Left" Margin="5,5,0,0"></TextBlock>
                    <TextBlock Text="MWTotal" Grid.Row="4" Grid.Column="0" HorizontalAlignment="Left" Margin="5,5,0,0"></TextBlock>
                    <TextBlock Text="Count" Grid.Row="5" Grid.Column="0" HorizontalAlignment="Left" Margin="5,5,0,0"></TextBlock>
                    <TextBox Text="{Binding CostTotal, StringFormat={}\{0:C0\}}" Grid.Row="0" Grid.Column="1" Height="25" Width="90" Foreground="{Binding CostTotal, Converter={StaticResource  ValueToForeground}}"/>
                    <TextBox Text="{Binding RTTotal,StringFormat={}\{0:C0\}}" Grid.Row="1" Grid.Column="1" Height="25" Width="90" Foreground="{Binding RTTotal, Converter={StaticResource  ValueToForeground}}"/>
                    <TextBox Text="{Binding DATotal,StringFormat={}\{0:C0\}}" Grid.Row="2" Grid.Column="1" Height="25" Width="90" Foreground="{Binding DATotal, Converter={StaticResource  ValueToForeground}}"/>
                    <TextBox Text="{Binding PNLTotal,StringFormat={}\{0:C0\}}" Grid.Row="3" Grid.Column="1" Height="25" Width="90" Foreground="{Binding PNLTotal, Converter={StaticResource  ValueToForeground}}"/>
                    <TextBox Text="{Binding MWTotal, StringFormat={}{0:0.0}}" Grid.Row="4" Grid.Column="1" Height="25" Width="90" Foreground="{Binding MWTotal, Converter={StaticResource  ValueToForeground}}"/>
                    <TextBox Text="{Binding Count}" Grid.Row="5" Grid.Column="1" Height="25" Width="90"/>
                </Grid>
            </GroupBox>
            <Button Command="{Binding GenerateXML}" Width="50" Height="30" Content="XML" VerticalAlignment="Top" Visibility="Hidden"/>
        </StackPanel>
        <DataGrid Grid.Row="1" Margin="5,0,0,5" FrozenColumnCount="16" Width="Auto" ItemsSource="{Binding FTRDetailsDataList}" AutoGenerateColumns="False" VerticalAlignment="Stretch" AreRowDetailsFrozen="True" HorizontalScrollBarVisibility="Visible"
                    IsReadOnly="False" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.IsDeferredScrollingEnabled="True" FontFamily="Microsoft Sans Serif, 8.25pt" FontWeight="ExtraLight"
                  HorizontalAlignment="Stretch"  ScrollViewer.CanContentScroll="True" AlternationCount="2" SelectionMode="Extended" SelectionUnit="Cell" CanUserAddRows="False" Sorting="DataGrid_Sorting">
            <DataGrid.RowStyle>
                <Style TargetType="{x:Type DataGridRow}">
                    <Style.Triggers>
                        <Trigger Property="AlternationIndex" Value="0">
                            <Setter Property="Background" Value="White" />
                        </Trigger>
                        <Trigger Property="AlternationIndex" Value="1">
                            <Setter Property="Background" Value="Lavender" />

                        </Trigger>
                        <DataTrigger Binding="{Binding Path=Participant}" Value="TOTAL">
                            <Setter Property="Background" Value="BlanchedAlmond"/>
                        </DataTrigger>
                    </Style.Triggers>
                    <Setter Property="Height" Value="23"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Participant" Binding="{Binding Participant, Mode=TwoWay}" IsReadOnly="True" Width="40" FontWeight="SemiBold" CellStyle="{StaticResource CenterCellStyleBG}">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Month"  Binding="{Binding Month, Mode=TwoWay}" IsReadOnly="True" Width="75" CellStyle="{StaticResource CenterCellStyleBG}">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>

                </DataGridTextColumn>
                <DataGridTextColumn Header="Auction" Binding="{Binding Auction, Mode=TwoWay}" IsReadOnly="True" Width="85" CellStyle="{StaticResource CenterCellStyleBG}">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="PeriodType"  Binding="{Binding PeriodType, Mode=TwoWay}" IsReadOnly="True" Width="40" Visibility="{Binding PeriodTypeVisibility}" CellStyle="{StaticResource CenterCellStyleBG}">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="TradeType"  Binding="{Binding TradeType, Mode=TwoWay}" IsReadOnly="True" Width="30" CellStyle="{StaticResource CenterCellStyleBG}">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="HedgeType"  Binding="{Binding HedgeType, Mode=TwoWay}" IsReadOnly="True" Width="30" CellStyle="{StaticResource CenterCellStyleBG}">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="ClassType"  Binding="{Binding ClassType, Mode=TwoWay}" IsReadOnly="True" Width="60" CellStyle="{StaticResource CenterCellStyleBG}">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Source"  Binding="{Binding Source, Mode=TwoWay}" IsReadOnly="True" Width="80" CellStyle="{StaticResource CenterCellStyleBG}">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Sink"  Binding="{Binding Sink, Mode=TwoWay}" IsReadOnly="True" Width="80" CellStyle="{StaticResource CenterCellStyleBG}">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="SourceZone"  Binding="{Binding SourceZone, Mode=TwoWay}" IsReadOnly="False" Visibility="{Binding SourceZoneVisible, Mode=TwoWay}"  Width="60" CellStyle="{StaticResource CenterCellStyleBG}">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="SinkZone"  Binding="{Binding SinkZone, Mode=TwoWay}" IsReadOnly="False" Visibility="{Binding SinkZoneVisible, Mode=TwoWay}"  Width="60" CellStyle="{StaticResource CenterCellStyleBG}">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="MWTotal"  Binding="{Binding MWTotal, Mode=TwoWay, StringFormat=0.00}" IsReadOnly="True" CellStyle="{StaticResource CenterCellStyleBG}" Width="30" >
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="MWHTotal"  Binding="{Binding MWHTotal, Mode=TwoWay, StringFormat=0.00}" IsReadOnly="True" CellStyle="{StaticResource CenterCellStyleBG}" Width="50" >
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Cost"  Binding="{Binding Cost, Mode=TwoWay,StringFormat=0.00}" IsReadOnly="True"  CellStyle="{StaticResource CenterCellStyleBG}" Width="50">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="ClearingPrice"  Binding="{Binding ClearingPrice, Mode=TwoWay,StringFormat=0.00}" IsReadOnly="True" CellStyle="{StaticResource CenterCellStyleBG}" Width="60" Visibility="{Binding ClearingPriceVisible,Mode=TwoWay}">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="PricePerMWh"  Binding="{Binding FTRPricePerHour, Mode=TwoWay,StringFormat=0.00}" IsReadOnly="True" CellStyle="{StaticResource CenterCellStyleBG}" Width="60" Visibility="{Binding ClearingPriceVisible,Mode=TwoWay}">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="RTPrice"  Binding="{Binding RTPrice, Mode=TwoWay,StringFormat=0.00}" IsReadOnly="True" CellStyle="{StaticResource CenterCellStyleBG}" Width="50">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="DAPrice"  Binding="{Binding DAPrice, Mode=TwoWay,StringFormat=0.00}" IsReadOnly="True" CellStyle="{StaticResource CenterCellStyleBG}" Width="50">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="PNL"  Binding="{Binding PNL, Mode=TwoWay,StringFormat=0.00}" IsReadOnly="True" CellStyle="{StaticResource CenterCellStyleBG}" Width="40">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <!--<DataGridTextColumn Header="Day:1"  Binding="{Binding Day1,ConverterCulture=en-US,Converter={StaticResource textColumnConverter}}"   IsReadOnly="True" CellStyle="{StaticResource CenterCellStyleBG}" Width="40">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>-->
                <DataGridTextColumn Header="Day:1" Binding="{Binding Day1, Mode=TwoWay, StringFormat=0.00}"  IsReadOnly="True" CellStyle="{StaticResource CenterCellStyleBG}" Width="37">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Day:2" Binding="{Binding Day2, Mode=TwoWay, StringFormat=0.00}"  IsReadOnly="True" CellStyle="{StaticResource CenterCellStyleBG}" Width="37">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Day:3" Binding="{Binding Day3, Mode=TwoWay,StringFormat=0.00}"  IsReadOnly="True" CellStyle="{StaticResource CenterCellStyleBG}" Width="37">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Day:4" Binding="{Binding Day4, Mode=TwoWay,StringFormat=0.00}"  IsReadOnly="True" CellStyle="{StaticResource CenterCellStyleBG}" Width="37">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Day:5" Binding="{Binding Day5, Mode=TwoWay,StringFormat=0.00}"  IsReadOnly="True" CellStyle="{StaticResource CenterCellStyleBG}" Width="37">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Day:6" Binding="{Binding Day6, Mode=TwoWay,StringFormat=0.00}"  IsReadOnly="True" CellStyle="{StaticResource CenterCellStyleBG}" Width="37">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Day:7" Binding="{Binding Day7, Mode=TwoWay,StringFormat=0.00}"   IsReadOnly="True" CellStyle="{StaticResource CenterCellStyleBG}" Width="37">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Day:8" Binding="{Binding Day8, Mode=TwoWay,StringFormat=0.00}"  IsReadOnly="True" CellStyle="{StaticResource CenterCellStyleBG}" Width="37">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Day:9" Binding="{Binding Day9, Mode=TwoWay,StringFormat=0.00}"  IsReadOnly="True" CellStyle="{StaticResource CenterCellStyleBG}" Width="37">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Day:10" Binding="{Binding Day10, Mode=TwoWay,StringFormat=0.00}"  IsReadOnly="True" CellStyle="{StaticResource CenterCellStyleBG}" Width="37">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Day:11" Binding="{Binding Day11, Mode=TwoWay,StringFormat=0.00}"  IsReadOnly="True" CellStyle="{StaticResource CenterCellStyleBG}" Width="37">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
