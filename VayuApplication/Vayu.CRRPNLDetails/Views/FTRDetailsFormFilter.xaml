<Window x:Class="Vayu.CRRPNLDetails.Views.FTRDetailsFormFilter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vayu.CRRPNLDetails.Views"
        mc:Ignorable="d"
     Height="310"
        Width="360"
         Title="VAYU - PNLDetails Form Filter"  >
    <Grid>
       
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="200"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Text="Combined Parameters" Grid.Row="0"  Grid.Column="0" VerticalAlignment="Center" Margin="10,0,0,0"/>
        <ListBox Height="Auto" Width="120" Grid.Row="1" Grid.Column="0"  ItemsSource="{Binding CombinedParameterList}" SelectionChanged="ListBox_SelectionChanged" Name="CombinedParameterList" SelectionMode="Multiple"/>
        <StackPanel Orientation="Vertical" Grid.Row="1" Grid.Column="1">
            <Button Content="Add" Height="30" Width="50"  Command="{Binding MovePaticipantCommand}" Margin="0,70,0,0"/>
            <Button Content="Remove" Height="30" Width="50" Command="{Binding DeleteParticipantCommand}" Margin="0,5,0,0"/>
        </StackPanel>
        <TextBlock Text="Selected Parameters" Grid.Row="0"  Grid.Column="2" VerticalAlignment="Center" Margin="20,0,0,0"/>
        <ListBox Height="Auto" Width="120" Grid.Row="1" Grid.Column="2" ItemsSource="{Binding SelectedList}" SelectionChanged="ListBox_SelectionChanged_1" Name="SelectedParameterList" SelectionMode="Multiple" />
        <Button Content="Combine" Height="30" Width="55"  Grid.Row="2" Grid.Column="2" Command="{Binding CombineTradesCommand}" HorizontalAlignment="Right" Margin="0,0,15,0" Click="Button_Click"/>

    </Grid>
</Window>
