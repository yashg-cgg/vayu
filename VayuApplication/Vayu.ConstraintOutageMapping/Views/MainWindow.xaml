<Window x:Class="Vayu.ConstraintOutageMapping.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 
        xmlns:prism="http://prismlibrary.com/"
                 Height="750"  
        Width="1830" WindowState="Maximized"
       Title="VAYU - Constraint Outage Mapping"
        prism:ViewModelLocator.AutoWireViewModel="False"
       >

    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="MyStyle" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource {x:Type ToggleButton}}" />
            <ResourceDictionary.MergedDictionaries>

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="LayoutRoot" Margin="0,0,0,0">
        <Grid.Background>
            <ImageBrush />
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="85" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0"
		            Margin="0,5,0,0"
		            Orientation="Horizontal">
            <GroupBox Width="350"
			          Height="72"
			          Margin="10,0,0,0"
			          VerticalAlignment="Top"
			          BorderBrush="#FF1D1C1C"
			          Header="Date">
                <StackPanel Orientation="Horizontal">
                    <!--<CheckBox x:Name="DateRangeCheckBox"
					          Margin="3,10,3,0"
					          Content="Range?"
					          IsChecked="{Binding DateRangeCheckBoxChecked,
					                              Mode=TwoWay}" />-->
                    <TextBlock Margin="10,8,3,0" Text="Start Date:" />
                    <!--<DatePicker Width="100"
					            Margin="15,7,3,0"
					            SelectedDate="{Binding FromDate,
					                                   Mode=TwoWay}" />-->
                    <DatePicker x:Name="FromDate" Width="100" Height="30"  Margin="3,4,3,0"  SelectedDate="{Binding StartDate}"  />
                    <TextBlock Margin="5,8,3,0" Text="End Date:" />
                    <DatePicker x:Name="ToDate" Width="100" Height="30"  Margin="3,4,3,0"  SelectedDate="{Binding EndDate}" VerticalAlignment="Top"   />
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal">

                <CheckBox x:Name="sppCheckBox"
				          IsChecked="{Binding IsSpp,
				                              Mode=TwoWay}"
				          Visibility="Collapsed" />

            </StackPanel>
            <GroupBox Header="Constraint" BorderBrush="#FF1D1C1C" Margin="5,0,0,3">
                <StackPanel Orientation="Horizontal" Margin="12,10,0,0" Height="25">
                    <CheckBox x:Name="AllConstraint" Content="All Constraint" IsChecked="{Binding isAllConstaintchecked}"></CheckBox>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Constraint/Contigency" BorderBrush="#FF1D1C1C" Margin="5,-1,0,3" IsEnabled="{Binding grpConstContig}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Name="ConstraintSearch" Width="60" Margin="12,8,0,0" Text="Constraint" />
                    <ComboBox Name="ConstraintSearchBox" Width="250" Height="25" IsEditable="True" IsTextSearchEnabled="True" IsTextSearchCaseSensitive="False" ItemsSource="{Binding ConstraintSearchList}" SelectedValue="{Binding SelectedConstraintItem}"  Text="{Binding SearchTypedText}" SelectionChanged="ConstraintSearchBox_SelectionChanged">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Height" Value="22"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <CheckBox Name="ConstraintChk" IsChecked="{Binding isConstraintChecked}" Visibility="Collapsed" >
                    </CheckBox>

                    <TextBlock Name="ContingencySearch" Width="70" Margin="15,8,0,0" Text="Contingency" />
                    <ComboBox Name="ContingencySearchBox" Width="250" Height="25" IsEditable="True" IsTextSearchEnabled="True" IsTextSearchCaseSensitive="False" ItemsSource="{Binding ContingencySearchList}" SelectedValue="{Binding SelectedContengencyItem}">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Height" Value="22"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>

                </StackPanel>
            </GroupBox>

            <GroupBox Width="206"
			         Height="72" Margin="5,0,0,0"
			          HorizontalAlignment="Left"
			          VerticalAlignment="Top"
			          BorderBrush="#FF1D1C1C"
			          Header="Outages Types">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="CurrentOutages"
					             Margin="0,10,3,0"
					             Content="Current"
					             IsChecked="{Binding CurrentOutagesChecked,
					                                 Mode=TwoWay}" />
                    <RadioButton x:Name="PlannedOutages"
					             Margin="3,10,3,0"
					             Content="Planned"
					             IsChecked="{Binding PlannedOutagesChecked,
					                                 Mode=TwoWay}" />
                    <RadioButton x:Name="AllConstraintOutagesCheckBox"
					             Margin="3,10,3,0"
					             Content="All"
					             IsChecked="{Binding CheckAllConstraintOutages,
					                                 Mode=TwoWay}" />

                    <!--<CheckBox x:Name="AllConstraintOutagesCheckBox"
					          Margin="8,8,0,0"
					          Content="All" 
					          IsChecked="{Binding CheckAllConstraintOutages,
					                              Mode=TwoWay}" Click="AllConstraintOutagesCheckBox_Click"/>-->
                </StackPanel>
            </GroupBox>

            <Button x:Name="RefreshButton"
				        Width="65"
				        Height="27" Margin="10,4,3,0"				        
				        Command="{Binding Retrieve}"
				        Content="Retrieve"
				        IsEnabled="{Binding IsRefreshEnabled}"   />

            <Button x:Name="ExportButton"
				        Width="65"
				        Height="27" Margin="10,4,3,0"				        
				        Command="{Binding ExportCommand}"
				        Content="Export"
				        IsEnabled="{Binding IsExportEnabled}"   />

            <!--<Button x:Name="CLearButton"
				        Width="65"
				        Height="29"
				        Margin="10,0,0,0"
				        Command="{Binding ClearCommand}"
				        Content="Clear" />-->
        </StackPanel>
        <DataGrid x:Name="constraintDataGrid"
		          Grid.Row="1"
		          Margin="0,2,0,0"
		          HorizontalAlignment="Stretch"
		          VerticalAlignment="Stretch"
		          AlternatingRowBackground="LightGray"
		          AreRowDetailsFrozen="True"
		          AutoGenerateColumns="False"
		          CanUserAddRows="False"
		          FontFamily="Microsoft Sans Serif, 8.25pt"
		          FontWeight="ExtraLight"
		          ItemsSource="{Binding OutageList}"
		          SelectionMode="Single"
		          SelectionUnit="FullRow"
		          VirtualizingStackPanel.IsVirtualizing="True"
		          VirtualizingStackPanel.VirtualizationMode="Recycling">

            <DataGrid.Columns>
                <DataGridTextColumn Width="120*" 
				                    Binding="{Binding ConstraintName}"
				                    CanUserReorder="True"
				                    Header="Constraint Name"
				                    IsReadOnly="True" />
                <DataGridTextColumn Width="120*" 
				                    Binding="{Binding Contingency}"
				                    CanUserReorder="True"
				                    Header="Contingency"
				                    IsReadOnly="True" />
                <DataGridTextColumn Width="120*" 
				                    Binding="{Binding OutageName}"
				                    CanUserReorder="True"
				                    Header="Outages"
				                    IsReadOnly="True" />

                <DataGridTextColumn Width="35*" 
                                   Binding="{Binding TicketID}"
                                   CanUserReorder="True"
                                   Header="Ticket ID"
                                   IsReadOnly="True" />

                <DataGridTextColumn Width="45*" 
                                   Binding="{Binding Branch}"
                                   CanUserReorder="True"
                                   Header="FromSub"
                                   IsReadOnly="True" />

                <DataGridTextColumn Width="45*" 
                                   Binding="{Binding ToBranch}"
                                   CanUserReorder="True"
                                   Header="ToSub"
                                   IsReadOnly="True" />

                <DataGridTextColumn Width="45*" 
                                   Binding="{Binding Zone}"
                                   CanUserReorder="True"
                                   Header="Zone"
                                   IsReadOnly="True" />

                <DataGridTextColumn Width="50*" 
                                   Binding="{Binding EquipmentType}"
                                   CanUserReorder="True"
                                   Header="Equipment Type"
                                   IsReadOnly="True" />

                <DataGridTextColumn Width="35*" 
                                   Binding="{Binding Voltage}"
                                   CanUserReorder="True"
                                   Header="Voltage"
                                   IsReadOnly="True" />

                <DataGridTextColumn Width="40*" 
                                   Binding="{Binding OutageStatus}"
                                   CanUserReorder="True"
                                   Header="Status"
                                   IsReadOnly="True" />

                <DataGridTextColumn Width="55*" 
                                   Binding="{Binding Startdate,  StringFormat=MM/dd/yy HH:mm:ss}"
                                   CanUserReorder="True"
                                   Header="Start Date"
                                   IsReadOnly="True" />

                <DataGridTextColumn Width="55*" 
                                   Binding="{Binding Enddate,  StringFormat=MM/dd/yy HH:mm:ss}"
                                   CanUserReorder="True"
                                   Header="End Date"
                                   IsReadOnly="True" />

                <DataGridTextColumn Width="30*" 
                                   Binding="{Binding OutageDuration}"
                                   CanUserReorder="True"
                                   Header="Duration"
                                   IsReadOnly="True" />

                <DataGridTextColumn Width="50*" 
                                   Binding="{Binding OutageType}"
                                   CanUserReorder="True"
                                   Header="Outage Type"
                                   IsReadOnly="True" />
            </DataGrid.Columns>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Height" Value="18"  />
                </Style>
            </DataGrid.CellStyle>
        </DataGrid>
    </Grid>

</Window>
