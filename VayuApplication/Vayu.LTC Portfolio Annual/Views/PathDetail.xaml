<Window    x:Class="Vayu.LTC_PortfolioAnnual.Views.PathDetail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/" Title="Path Detail"             
             prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid>  
        <Grid.ColumnDefinitions>
        </Grid.ColumnDefinitions>
        <DataGrid x:Name="grdPathConstraintDataList"
		          Margin="0,10,0,0"
		          HorizontalAlignment="Stretch"
		          VerticalAlignment="Stretch"
		          AlternatingRowBackground="LightGray"
		          AreRowDetailsFrozen="True"
		          AutoGenerateColumns="False"
		          CanUserAddRows="False"
		          ItemsSource="{Binding PathDetailList}"
		          ScrollViewer.CanContentScroll="True"
		          ScrollViewer.IsDeferredScrollingEnabled="True"
		          SelectedItem="{Binding SelectedConstraintPathValue,
		                                 Mode=TwoWay}"
		          SelectionMode="Extended"
		          SelectionUnit="FullRow"
		          VirtualizingStackPanel.IsVirtualizing="True"
		          VirtualizingStackPanel.VirtualizationMode="Recycling" Grid.ColumnSpan="2">
            <DataGrid.Columns>
                <DataGridTextColumn Width="50*"
				                    MinWidth="40"
				                    Binding="{Binding ID}"
				                    CanUserReorder="False"
				                    FontWeight="Bold"
				                    Header="Constraint ID"
				                    IsReadOnly="True" />
                <DataGridTextColumn Width="70*"
				                    MinWidth="40"
				                    Binding="{Binding Source}"
				                    CanUserReorder="False"
				                    FontWeight="Bold"
				                    Header="Source"
				                    IsReadOnly="True" />
                <DataGridTextColumn Width="70*"
				                    MinWidth="40"
				                    Binding="{Binding Sink}"
				                    CanUserReorder="False"
				                    FontWeight="Bold"
				                    Header="Sink"
				                    IsReadOnly="True" />
                <DataGridTextColumn Width="30*"
				                    MinWidth="40"
				                    Binding="{Binding ClassType}"
				                    CanUserReorder="False"
				                    FontWeight="Bold"
				                    Header="Class Type"
				                    IsReadOnly="True" />
                <DataGridTextColumn Width="30*"
				                    MinWidth="40"
				                    Binding="{Binding Month}"
				                    CanUserReorder="False"
				                    FontWeight="Bold"
				                    Header="Period"
				                    IsReadOnly="True" />
                
                <DataGridTextColumn Width="30*"
				                    MinWidth="40"
				                    Binding="{Binding Sum,
				                                      StringFormat={}\{0:N0\}}"
				                    CanUserReorder="False"
				                    Header="Total"
				                    IsReadOnly="True" />
              
                <DataGridTextColumn Width="40*"
				                    MinWidth="40"
				                    Binding="{Binding PeakMW}"
				                    CanUserReorder="False"
				                    Header="Peak MW"
				                    IsReadOnly="True" />
                <DataGridTextColumn Width="40*"
				                    MinWidth="40"
				                    Binding="{Binding OffPeakMW}"
				                    CanUserReorder="False"
				                    Header="OffPeak MW"
				                    IsReadOnly="True" />
                <DataGridTextColumn Width="40*"
				                    MinWidth="40"
				                    Binding="{Binding PeakWEMW}"
				                    CanUserReorder="False"
				                    Header="PEAKWE MW"
				                    IsReadOnly="True" />
                <DataGridTextColumn Width="40*"
				                    MinWidth="40"
				                    Binding="{Binding SensSource,StringFormat={}\{0:N3\}}"
				                    CanUserReorder="False"
				                    Header="Sens Source"
				                    IsReadOnly="True" />
                <DataGridTextColumn Width="40*"
				                    MinWidth="40"
				                    Binding="{Binding SensSink,StringFormat={}\{0:N3\}}"
				                    CanUserReorder="False"
				                    Header="Sens Sink"
				                    IsReadOnly="True" />
                <DataGridTextColumn Width="40*"
				                    MinWidth="40"
				                    Binding="{Binding Delta,StringFormat={}\{0:N3\}}"
				                    CanUserReorder="False"
				                    Header="Sensitivity Path"
				                    IsReadOnly="True" />
                <DataGridTextColumn Width="40*"
				                    MinWidth="40"
				                    Binding="{Binding PeakMWhExposure,StringFormat={}\{0:N3\}}"
				                    CanUserReorder="False"
				                    Header="Peak MWhExposure"
				                    IsReadOnly="True" />
                <DataGridTextColumn Width="40*"
				                    MinWidth="40"
				                    Binding="{Binding OffPeakMWhExposure,StringFormat={}\{0:N3\}}"
				                    CanUserReorder="False"
				                    Header="OffPeak MWhExposure"
				                    IsReadOnly="True" />
                <DataGridTextColumn Width="40*"
				                    MinWidth="40"
				                    Binding="{Binding PeakWEMWhExposure,StringFormat={}\{0:N3\}}"
				                    CanUserReorder="False"
				                    Header="PEAKWE MWhExposure"
				                    IsReadOnly="True" />
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu Name="IndividualPathDetails" StaysOpen="True">
                    <MenuItem Command="{Binding ShowPathConstraintDialogCommand}" Header="Path Details" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</Window>
