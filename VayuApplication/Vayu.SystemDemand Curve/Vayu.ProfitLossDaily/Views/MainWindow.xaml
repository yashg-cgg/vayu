<mah:MetroWindow   x:Class="Vayu.ProfitLossDaily.Views.MainWindow"
                  xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:prism="http://prismlibrary.com/" 
                   xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf"
                     xmlns:oxyplot="http://oxyplot.org/wpf"
                  xmlns:pc="clr-namespace:Vayu.ProfitLossDaily.ViewModels"
                  xmlns:local="clr-namespace:Vayu.ProfitLossDaily.Views"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
                   prism:ViewModelLocator.AutoWireViewModel="False"
                  Title="VAYU - Daily PNL" Height="900" Width="1600"
                   >
    <Window.Resources>
        <ResourceDictionary>
            <pc:ValueToForegroundColorConverter x:Key="ValueToForeground"/>
            <pc:DataGridBackColorConverter x:Key="myBGColor" />
            <pc:InverseBooleanToVisibilityConverter x:Key="InvertBoolConverter" />
            <local:ForeColorConverter x:Key="foreGroundColor"/>
            <local:TextColumnConverter x:Key="textColumnConverter"/>
            <FrameworkElement x:Key="ProxyElement" DataContext="{Binding}" />
            <Style x:Key="CenterCellStyleBG" TargetType="{x:Type DataGridCell}">
                <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource Self}, Path=Content.Text, Converter={StaticResource myBGColor}}" />
            </Style>

            <Style x:Key="CenterCellStyleFGSimple" TargetType="{x:Type DataGridCell}">
                <Setter Property="Foreground" 
                        Value="{Binding RelativeSource={RelativeSource Self},
                          Path=Content.Text,
                        Converter={StaticResource foreGroundColor}}" />
                <Setter Property="Margin" Value="0,0,0,0"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <TabControl>
            <TabItem Header="Summary">
                <Grid x:Name="SummaryGrid" Margin="0,3,0,-3" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="308"/>
                        <ColumnDefinition Width="242"/>
                        <ColumnDefinition Width="163"/>
                        <ColumnDefinition Width="219"/>
                        <ColumnDefinition Width="179"/>
                        <ColumnDefinition Width="258"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="190"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Grid.ColumnSpan="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="330"/>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <GroupBox Grid.Column="0" Header="Product/Market" Width="230" Margin="-5,0,0,125"  BorderBrush="#FF1D1C1C">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox  Grid.Row="0"	 Grid.Column="0" Margin=" 2 2 2 2"							          
									          ItemsSource="{Binding ProductList}"
									          SelectedItem="{Binding SelectedProduct,
									                                 Mode=TwoWay}" />
                                    <ComboBox x:Name="marketListBox"
									          Grid.Row="0"	 Grid.Column="1"
									        Margin=" 2 2 2 2"									         
									          ItemsSource="{Binding MarketList, Mode=TwoWay}" 
									          SelectedItem="{Binding SelectedMarket}" />
                                </Grid>
                            </GroupBox>
                            <GroupBox Grid.Column="0" Header="Select Dates" Height="108" Width="235" Margin="-2,70,0,10" BorderBrush="#FF1D1C1C">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Label Grid.Row="0"	Margin="2,2,0,0"							      
								       Width="69"								      
								       HorizontalAlignment="Left"
								       VerticalAlignment="Top"
								       Content="Start Date" />
                                    <Label 								      
								       Width="69" Margin="2,2,0,0" Grid.Column="0" Grid.Row="1"
								       HorizontalAlignment="Left" 
								       VerticalAlignment="Top"
								       Content="End Date" />
                                    <Button x:Name="todayButtonNew"
								        Grid.Row="0"
								        Grid.Column="2"
								        HorizontalAlignment="Center"
								        VerticalAlignment="Center"
								        Command="{Binding TodaysDateCommand}"
								        Content="Today" />
                                    <DatePicker x:Name="startDatePicker"
								            Grid.Row="0" Margin="2,2,0,0"
								              Width="100"	 Grid.Column="1"	 				           
								            HorizontalAlignment="Left"
								            VerticalAlignment="Center"
								            SelectedDate="{Binding StartDate}"
								            SelectedDateFormat="Short" />
                                    <DatePicker x:Name="endDatePicker"								          
								             Width="100"	Margin="2,0,0,0"	Grid.Column="1" Grid.Row="1"						          
								            HorizontalAlignment="Left"
								            VerticalAlignment="Center"
								            SelectedDate="{Binding EndDate}"
								            SelectedDateFormat="Short" />
                                </Grid>

                            </GroupBox>
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Vertical" Margin="-5,0,0,0">
                                    <Label Margin="55,0,0,0"
								       HorizontalAlignment="Left"
								       VerticalAlignment="Top"
								       Content="Accounts" />
                                    <ListBox x:Name="accountListBox"	BorderThickness="1" BorderBrush="Black"							         
								         Width="145" Margin="-175,0,0,50"
								         Height="155"								       
								         VerticalAlignment="Bottom"
								         ItemsSource="{Binding AccountList,
								                               Mode=TwoWay}"
								         SelectedItem="{Binding SelectedAccount}"
								         SelectionChanged="AccountListBox_SelectionChanged"
								         SelectionMode="Multiple" />
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Margin="150,-205,0,50" Grid.ColumnSpan="2">
                                    <Label Margin="45,-26,0,0"
						            VerticalAlignment="Top"
						            Content="Portfolio" Visibility="{Binding PortfolioVisible}" />
                                    <ListBox x:Name="portfolioListBox" BorderThickness="1" BorderBrush="Black"							         
								         Width="150" Margin="5,0,-12,-2"
								         Height="155"
								         HorizontalAlignment="Left"
								         ItemsSource="{Binding PortfolioList}" Visibility="{Binding isVisible}"
								         SelectionChanged="PortfolioListBox_SelectionChanged"
								         SelectionMode="Multiple" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <Grid Grid.Column="2" Margin="2,0,0,2" Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30*"/>
                        </Grid.RowDefinitions>

                        <Button x:Name="portfolioSelectAllButton" Margin="-5 2 2 2"
								        Grid.Column="0" Grid.Row="0"						       
								        HorizontalAlignment="Center"
								        VerticalAlignment="Top"
								        Click="portfolioSelectAllButton_Click"
								        Content="Select All" Visibility="{Binding SelectAllVisible}"/>
                        <Button x:Name="portfolioUnSelectAllButton"	   Grid.Column="1" Grid.Row="0"	 							       
								        HorizontalAlignment="Center" Margin="-2 2 2 2"
								        VerticalAlignment="Top"
								        Click="portfolioUnSelectAllButton_Click"
								        Content="UnSelect All" Visibility="{Binding UnSelectAllVisible}" />
                        <Button x:Name="calculateButton1"   Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Center"
								        Command="{Binding RunCalcCommand}"
								        Content="Calculate"  
								        IsEnabled="{Binding IsCalculateEnable}" Margin="2,2,2,2" Width="100" />
                        <GroupBox Header="Filters" Height="115" Margin="2 0,2,0"  Grid.ColumnSpan="2" Grid.Row="2" Grid.RowSpan="3"  BorderBrush="#FF1D1C1C">
                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <CheckBox x:Name="summaryCheckBox"   Grid.ColumnSpan="2"
								           Grid.Row="0"  
								          Content="Summary"
								          IsChecked="{Binding SummaryChecked,
								                              Mode=TwoWay}" />
                                <CheckBox x:Name="showIncompleteCheckBox" 
								           Grid.Row="1"  
								          Content="Incomplete Hours"
								          IsChecked="{Binding IncomplteHrsChecked,
								                              Mode=TwoWay}"
								          IsEnabled="{Binding IscomplteHrsEnabled}" />
                                <CheckBox x:Name="latestHourCheckBox"   Grid.Row="2"                                     
                                          Content="Current Hour"
                                          IsChecked="{Binding LatestHourlyChecked, Mode=TwoWay}"/>
                            </Grid>
                        </GroupBox>

                    </Grid>

                    <StackPanel Orientation="Vertical" Grid.Column="3" Margin="2,10,0,0">
                        <Grid>
                            <Grid.Resources>
                                <Style TargetType="{x:Type TextBox}">
                                    <Setter Property="IsReadOnly" Value="True" />
                                </Style>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="120*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0"
								       Grid.Column="0"
								       Width="69"
								       Margin="2,0,0,0"
								       HorizontalAlignment="Left"
								       VerticalAlignment="Top"
								       Content="Total Profit" />
                            <TextBox x:Name="totalPnlTextBox"
								         Grid.Row="0"
								         Grid.Column="1"
								         Width="95"
								         Height="25"
								         Margin="0,5,0,0"
								         HorizontalAlignment="Left"
								         VerticalAlignment="Top"
								         Foreground="{Binding TotalPNL,
								                              Converter={StaticResource ValueToForeground}}"
								         IsReadOnly="True"
								         Text="{Binding TotalPNL,
								                        StringFormat={}\{0:C\}}"
								         TextWrapping="Wrap" />
                            <Label Grid.Row="1"
								       Grid.Column="0"
								       Width="108"
								       Margin="2,0,0,0"
								       HorizontalAlignment="Left"
								       VerticalAlignment="Top"
								       Content="Total Fee" />
                            <TextBox x:Name="totalFeeTextBox"
								         Grid.Row="1"
								         Grid.Column="1"
								         Width="95"
								         Height="25"
								         HorizontalAlignment="Left"
								         Foreground="{Binding TotalFee,
								                              Converter={StaticResource ValueToForeground}}"
								         IsReadOnly="True"
								         Text="{Binding TotalFee,
								                        StringFormat={}\{0:C\}}"
								         TextWrapping="Wrap" />
                            <Label Grid.Row="2"
								       Grid.Column="0"
								       Width="90"
								       Margin="2,0,0,0"
								       HorizontalAlignment="Left"
								       VerticalAlignment="Top"
								       Content="Total Net Profit" />
                            <TextBox x:Name="totalNetPnlTextBox"
								         Grid.Row="2"
								         Grid.Column="1"
								         Width="95"
								         Height="25"
								         HorizontalAlignment="Left"
								         Foreground="{Binding TotalNetPNL,
								                              Converter={StaticResource ValueToForeground}}"
								         IsReadOnly="True"
								         Text="{Binding TotalNetPNL,
								                        StringFormat={}\{0:C\}}"
								         TextWrapping="Wrap" />
                            <Label Grid.Row="3"
								       Grid.Column="0"
								       Width="110"
								       Margin="2,0,0,0"
								       HorizontalAlignment="Left"
								       VerticalAlignment="Top"
								       Content="Total Dollar Cleared" />
                            <TextBox x:Name="payCollectTextBox"
								         Grid.Row="3"
								         Grid.Column="1"
								         Width="95"
								         Height="25"
								         HorizontalAlignment="Left"
								         Foreground="{Binding TotalCollect,
								                              Converter={StaticResource ValueToForeground}}"
								         IsReadOnly="True"
								         Text="{Binding TotalCollect,
								                        StringFormat={}\{0:C\}}"
								         TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="5,38,0,0">
                        <Grid Width="160" Height="90">
                            <Grid.Resources>
                                <Style TargetType="{x:Type TextBox}">
                                    <Setter Property="IsReadOnly" Value="True" />
                                </Style>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0"
								       Grid.Column="0"
								       Width="69"
								       HorizontalAlignment="Left"
								       VerticalAlignment="Top"
								       Content="Total MW"
								       RenderTransformOrigin="0.449,0.038" />
                            <TextBox x:Name="totalMWTextBox"
								         Grid.Row="0"
								         Grid.Column="1"
								         Width="95"
								         Height="25"
								         HorizontalAlignment="Left"
								         IsReadOnly="True"
								         Text="{Binding TotalMW,
								                        StringFormat=0.00}"
								         TextWrapping="Wrap" />
                            <Label Grid.Row="1"
								       Grid.Column="0"
								       Width="47"
								       HorizontalAlignment="Left"
								       VerticalAlignment="Top"
								       Content="$/MW" />
                            <TextBox x:Name="mwTextBox"
								         Grid.Row="1"
								         Grid.Column="1"
								         Width="95"
								         Height="25"
								         HorizontalAlignment="Left"
								         VerticalAlignment="Center"
								         Foreground="{Binding TotalPNL,
								                              Converter={StaticResource ValueToForeground}}"
								         IsReadOnly="True"
								         Text="{Binding PercentMW,
								                        StringFormat={}{0:0.00}}"
								         TextWrapping="Wrap" />
                            <Label Grid.Row="2"
								       Grid.Column="0"
								       Width="48"
								       HorizontalAlignment="Left"
								       VerticalAlignment="Top"
								       Content="%WIN" />
                            <TextBox x:Name="mwPercentageTextBox"
								         Grid.Row="2"
								         Grid.Column="1"
								         Width="95"
								         Height="25"
								         HorizontalAlignment="Left"
								         IsReadOnly="True"
								         Text="{Binding WinText,
								                        StringFormat=###%}"
								         TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Grid.Column="5" Margin="5,31,0,0" Width="239">
                        <Grid>
                            <Grid.Resources>
                                <Style TargetType="{x:Type TextBox}">
                                    <Setter Property="IsReadOnly" Value="True" />
                                </Style>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Width="120" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Total DA Congestion" />
                            <TextBox x:Name="totalDAcongestion" Grid.Row="0" Grid.Column="1"  Width="95"   Height="25"  Margin="0,5,0,0"  HorizontalAlignment="Right" VerticalAlignment="Top"
								         Foreground="{Binding TotalDACong,Converter={StaticResource ValueToForeground}}"  IsReadOnly="True" Text="{Binding TotalDACong, StringFormat={}\{0:C\}}" TextWrapping="Wrap" />
                            <Label Grid.Row="1" Grid.Column="0" Width="120" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Total RT Congestion" />
                            <TextBox x:Name="totalRTcongestion" Grid.Row="1" Grid.Column="1"  Width="95"   Height="25"  Margin="0,5,0,0"  HorizontalAlignment="Right" VerticalAlignment="Top"
								         Foreground="{Binding TotalRTCong,Converter={StaticResource ValueToForeground}}"  IsReadOnly="True" Text="{Binding TotalRTCong, StringFormat={}\{0:C\}}" TextWrapping="Wrap" />
                            <Label Grid.Row="2" Grid.Column="0" Width="90" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Total DA Loss" />
                            <TextBox x:Name="totalDALoss" Grid.Row="2" Grid.Column="1"  Width="95"   Height="25"  Margin="0,5,0,0"  HorizontalAlignment="Right" VerticalAlignment="Top"
								         Foreground="{Binding TotalDALoss,Converter={StaticResource ValueToForeground}}"  IsReadOnly="True" Text="{Binding TotalDALoss, StringFormat={}\{0:C\}}" TextWrapping="Wrap" />
                            <Label Grid.Row="3" Grid.Column="0" Width="90" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Total RT Loss" />
                            <TextBox x:Name="totalRTLoss" Grid.Row="3" Grid.Column="1"  Width="95"   Height="25"  Margin="0,5,0,0"  HorizontalAlignment="Right" VerticalAlignment="Top"
								         Foreground="{Binding TotalRTLoss,Converter={StaticResource ValueToForeground}}"  IsReadOnly="True" Text="{Binding TotalRTLoss, StringFormat={}\{0:C\}}" TextWrapping="Wrap" />

                        </Grid>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Grid.Column="6" Margin="0,40,0,0" Width="81">
                        <Button x:Name="calculateButton"
								        Grid.Row="2"
								        Grid.Column="4"
								        Width="76"
								        Height="26"
								        Margin="10,0,-5,4"
								        HorizontalAlignment="Center"
								        VerticalAlignment="Center"
								        Command="{Binding RunCalcCommand}"
								        Content="Calculate"
								        IsEnabled="{Binding IsCalculateEnable}" Visibility="Hidden"/>
                        <Button x:Name="resetButton"
								        Grid.Row="1"
								        Grid.Column="4"
								        Width="76"
								        Height="26"
								        Margin="10,4,-5,4"
								        HorizontalAlignment="Center"
								        VerticalAlignment="Center"
								        Click="resetButton_Click"
								        Command="{Binding ResetCommand}"
								        Content="Reset" />
                        <Button 
                        HorizontalAlignment="Center" Grid.Row="1"
                        Grid.Column="4"  Margin="10,4,-5,4"
                        VerticalAlignment="Top" 
                        Width="76"
                        Height="26"
                        Content="ExportToCSV"
                        Command="{Binding RunExportCSVCommand}"/>
                    </StackPanel>
                    <CheckBox x:Name="chkTemp"
					          IsChecked="{Binding IsIncVisible,
					                              Mode=TwoWay}"
					          Visibility="Collapsed" Grid.ColumnSpan="2" />
                    <CheckBox x:Name="chkSink"
					          IsChecked="{Binding IsSinkVisible,
					                              Mode=TwoWay}"
					          Visibility="Collapsed" Grid.ColumnSpan="2" />
                    <DataGrid x:Name="pnlDataGrid"
				          Grid.Row="1"
				          Margin="0,0,0,0"
				          HorizontalAlignment="Left"
				          AlternatingRowBackground="LightGray"
				          AutoGenerateColumns="False"
				          CanUserAddRows="False"
				          IsReadOnly="True"   
                              
				          ItemsSource="{Binding PNLList}" Grid.ColumnSpan="7"		
                          ScrollViewer.CanContentScroll="True" 
						  ScrollViewer.VerticalScrollBarVisibility="Auto"
						  ScrollViewer.HorizontalScrollBarVisibility="Auto" Width="1586">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="80"
						                    Binding="{Binding PortfolioName}"
						                    Header="Portfolio" />
                            <DataGridTextColumn Width="70*"
						                    Binding="{Binding MarketDate,
						                                      StringFormat=d}"
						                    ClipboardContentBinding="{x:Null}"
						                    Header="MarketDate" />
                            <DataGridTextColumn Width="50*"
						                    Binding="{Binding HE}"
						                    ClipboardContentBinding="{x:Null}" 
						                    Header="HE"
						                    Visibility="{Binding Source={x:Reference summaryCheckBox},
						                                         Path=IsChecked,
						                                         Converter={StaticResource InvertBoolConverter}}" />
                            <DataGridTextColumn Width="100*"
						                    Binding="{Binding Source}"
						                    ClipboardContentBinding="{x:Null}"
						                    Header="Source"
						                    Visibility="{Binding Source={x:Reference summaryCheckBox},
						                                         Path=IsChecked,
						                                         Converter={StaticResource InvertBoolConverter}}" />
                            <DataGridTextColumn Width="100*"
						                    Binding="{Binding Sink}"
						                    ClipboardContentBinding="{x:Null}"
						                    Header="Sink"
						                    Visibility="{Binding Source={x:Reference chkSink},
						                                         Path=IsChecked,
						                                         Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <DataGridTextColumn Width="100*"
						                    Binding="{Binding SourceZone}"
						                    ClipboardContentBinding="{x:Null}"
						                    Header="Source Zone"
						                    Visibility="{Binding Source={x:Reference summaryCheckBox},
						                                         Path=IsChecked,
						                                         Converter={StaticResource InvertBoolConverter}}" />

                            <DataGridTextColumn Width="100*"
						                    Binding="{Binding SinkZone}"
						                    ClipboardContentBinding="{x:Null}"
						                    Header="Sink Zone"
						                    Visibility="{Binding Source={x:Reference chkSink},
						                                         Path=IsChecked,
						                                         Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <DataGridTextColumn Width="60*"
						                    Binding="{Binding IncDEC}"
						                    ClipboardContentBinding="{x:Null}"
						                    Header="Inc/Dec"
						                    Visibility="{Binding Source={x:Reference chkTemp},
						                                         Path=IsChecked,
						                                         Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <DataGridTextColumn Width="50*"
						                    Binding="{Binding MW,
						                                      StringFormat={}{0:0.00}}"
						                    CellStyle="{StaticResource CenterCellStyleBG}"
						                    ClipboardContentBinding="{x:Null}"
						                    Header="MW" />
                            <DataGridTextColumn Width="60*"
						                    Binding="{Binding DA,
						                                      StringFormat=C}"
						                    CellStyle="{StaticResource CenterCellStyleBG}"
						                    ClipboardContentBinding="{x:Null}"
						                    Header="DA"
						                    Visibility="{Binding Source={x:Reference summaryCheckBox},
						                                         Path=IsChecked,
						                                         Converter={StaticResource InvertBoolConverter}}" />
                            <DataGridTextColumn Width="60*"
						                    Binding="{Binding RT,
						                                      StringFormat=C}"
						                    CellStyle="{StaticResource CenterCellStyleBG}"
						                    ClipboardContentBinding="{x:Null}"
						                    Header="RT"
						                    Visibility="{Binding Source={x:Reference summaryCheckBox},
						                                         Path=IsChecked,
						                                         Converter={StaticResource InvertBoolConverter}}" />
                            <DataGridTextColumn Width="60*"
						                    Binding="{Binding DACong,
						                                      StringFormat=C}"
						                    CellStyle="{StaticResource CenterCellStyleBG}"
						                    ClipboardContentBinding="{x:Null}"
						                    Header="DACong"
						                    Visibility="{Binding Source={x:Reference summaryCheckBox},
						                                         Path=IsChecked,
						                                         Converter={StaticResource InvertBoolConverter}}" />
                            <DataGridTextColumn Width="60*"
						                    Binding="{Binding RTCong,
						                                      StringFormat=C}"
						                    CellStyle="{StaticResource CenterCellStyleBG}"
						                    ClipboardContentBinding="{x:Null}"
						                    Header="RTCong"
						                    Visibility="{Binding Source={x:Reference summaryCheckBox},
						                                         Path=IsChecked,
						                                         Converter={StaticResource InvertBoolConverter}}" />
                            <DataGridTextColumn Width="60*"
						                    Binding="{Binding DALoss,
						                                      StringFormat=C}"
						                    CellStyle="{StaticResource CenterCellStyleBG}"
						                    ClipboardContentBinding="{x:Null}"
						                    Header="DALoss"
						                    Visibility="{Binding Source={x:Reference summaryCheckBox},
						                                         Path=IsChecked,
						                                         Converter={StaticResource InvertBoolConverter}}" />
                            <DataGridTextColumn Width="60*"
						                    Binding="{Binding RTLoss,
						                                      StringFormat=C}"
						                    CellStyle="{StaticResource CenterCellStyleBG}"
						                    ClipboardContentBinding="{x:Null}"
						                    Header="RTLoss"
						                    Visibility="{Binding Source={x:Reference summaryCheckBox},
						                                         Path=IsChecked,
						                                         Converter={StaticResource InvertBoolConverter}}" />

                            <DataGridTextColumn Width="60*"
						                    Binding="{Binding DART,
						                                      StringFormat=C}"
						                    CellStyle="{StaticResource CenterCellStyleBG}"
						                    ClipboardContentBinding="{x:Null}"
						                    Header="DART"
						                    Visibility="{Binding Source={x:Reference summaryCheckBox},
						                                         Path=IsChecked,
						                                         Converter={StaticResource InvertBoolConverter}}" />
                            <DataGridTextColumn Width="50*"
						                    Binding="{Binding PnlValue,
						                                      StringFormat={}\{0:C\}}"
						                    CellStyle="{StaticResource CenterCellStyleBG}"
						                    ClipboardContentBinding="{x:Null}"
						                    Header="Profit" />
                            <DataGridTextColumn Width="100*"
						                    Binding="{Binding Fee,
						                                      StringFormat={}\{0:C\}}"
						                    CellStyle="{StaticResource CenterCellStyleBG}"
						                    ClipboardContentBinding="{x:Null}"
						                    Header="Fee" />
                            <DataGridTextColumn Width="100*"
						                    Binding="{Binding NetPnl,
						                                      StringFormat={}\{0:C\}}"
						                    CellStyle="{StaticResource CenterCellStyleBG}"
						                    ClipboardContentBinding="{x:Null}"
						                    Header="Net Profit" />
                            <DataGridTextColumn Width="100*"
						                    Binding="{Binding CummPnl,
						                                      StringFormat={}\{0:C\}}"
						                    CellStyle="{StaticResource CenterCellStyleBG}"
						                    ClipboardContentBinding="{x:Null}"
						                    Header="Cumm. Profit"
						                    Visibility="{Binding Source={x:Reference summaryCheckBox},
						                                         Path=IsChecked,
						                                         Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <DataGridTextColumn Width="100*"
						                    Binding="{Binding PayCollect,
						                                      StringFormat={}\{0:C\}}"
						                    CellStyle="{StaticResource CenterCellStyleBG}"
						                    ClipboardContentBinding="{x:Null}"
						                    Header="Dollar Cleared"
						                    Visibility="{Binding Source={x:Reference summaryCheckBox},
						                                         Path=IsChecked,
						                                         Converter={StaticResource InvertBoolConverter}}" />
                        </DataGrid.Columns>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="{x:Type DataGridColumnHeader}">
                                <Setter Property="FontWeight" Value="Bold" />
