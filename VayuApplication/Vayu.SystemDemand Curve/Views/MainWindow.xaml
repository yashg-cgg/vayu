<Window 
         x:Class="Vayu.SystemDemand_Curve.Views.MainWindow"
         
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"  
       xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf"
     xmlns:oxyplot="http://oxyplot.org/wpf"
    prism:ViewModelLocator.AutoWireViewModel="False"
        Title="Vayu- System Demand Curve" Height="Auto" Width="997">
    <Window.Resources>
        <ResourceDictionary>

        </ResourceDictionary>
    </Window.Resources>
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="75" />
            <RowDefinition Height="700*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="450"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Label Content="StartDate"   Grid.Row="0" Grid.Column="0" />
            <Label Content="EndDate" Grid.Row="1" Grid.Column="0" />
            <DatePicker Grid.Row="0" Grid.Column="1" BorderBrush="Black" Margin="4" SelectedDate="{Binding FromSelectedDate, Mode=TwoWay}" />
            <DatePicker Grid.Row="1" Grid.Column="1" BorderBrush="Black" Margin="4" SelectedDate="{Binding EndSelectedDate, Mode=TwoWay}" />
            <ComboBox  Grid.Row="0" Grid.Column="2" Margin="4 4 4 4 "
				          IsEditable="True" BorderBrush="Black"
				          ItemsSource="{Binding ZoneList}"
				          SelectedItem="{Binding ZoneSelectedItem,
				                                 Mode=TwoWay}" />
            <Button  Grid.Column="2" Grid.Row="1" Margin=" 4 4 4 4 "
				        Command="{Binding RefreshCommand}" BorderBrush="Black"
				        Content="Refresh" />
            <GroupBox Margin="0,5,0,0" Header="Frozen"  BorderBrush="Black" Grid.Column="3" Grid.RowSpan="2">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <!--<RadioButton Content="5" Margin="5 10"  IsChecked="{Binding FiveFrozenChecked, Mode=TwoWay}" />
                        <RadioButton Content="11"  Margin="15 10" IsChecked="{Binding ElevenFrozenChecked, Mode=TwoWay}" />-->
                        <!--<CheckBox Content="PRT" IsChecked="{Binding FrozenPRTChecked, Mode=TwoWay}" />
                                <CheckBox Content="WSI" IsChecked="{Binding FrozenWSIChecked, Mode=TwoWay}" />
                                <CheckBox Content="DTN" IsChecked="{Binding FrozenDTNChecked, Mode=TwoWay}" />-->
                        <CheckBox Content="Frozen Forecast" Margin="15 10" IsChecked="{Binding FrozenISOChecked, Mode=TwoWay}" />
                        <StackPanel.Resources>
                            <Style TargetType="RadioButton">
                                <Setter Property="Margin" Value="20,4,0,0" />
                            </Style>
                            <Style TargetType="CheckBox">
                                <Setter Property="Margin" Value="15,0,0,0" />
                            </Style>
                        </StackPanel.Resources>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <Grid Grid.Row="0" Grid.Column="4" Grid.RowSpan="2" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <CheckBox Content="Actual Hourly Avg Load" Grid.Row="0" Margin="5 " Grid.Column="0" IsChecked="{Binding CURRENTChecked, Mode=TwoWay}" />
                <CheckBox Content="Current Forecast"  Margin="5 " Grid.Row="1"  Grid.Column="0" IsChecked="{Binding ISOChecked, Mode=TwoWay}" />
                <CheckBox Content="Day Ahead Forecast" Margin="5 " Grid.Row="0"  Grid.Column="1" IsChecked="{Binding DAChecked, Mode=TwoWay}" />
                <CheckBox Visibility="Collapsed" Content="Genscape Forecast" IsChecked="{Binding GenscapeChecked, Mode=TwoWay}" />
                <!--<CheckBox Content="HOURLY"  Margin="5 " Grid.Row="1"  Grid.Column="1" IsChecked="{Binding HourlyChecked, Mode=TwoWay}" />-->
                <CheckBox Content="Peak Load Of Day" Grid.Row="1"  Grid.Column="1" IsChecked="{Binding ISODayHighChecked, Mode=TwoWay}" />
                <CheckBox Content="Net Load" Grid.Row="0"  Grid.Column="2" IsChecked="{Binding NetLoadHighChecked, Mode=TwoWay}" />
                <CheckBox Content="Frozen Net Load" Grid.Row="1"  Grid.Column="2" IsChecked="{Binding FrozenNetLoadChecked, Mode=TwoWay}" />
            </Grid>
            <StackPanel Grid.Row="0" Grid.Column="5"
					            Margin="25,20,0,0"
					            Orientation="Horizontal">
                <TextBlock Text="Update Time:" ToolTip="Updated only on Callback" />
                <TextBlock Margin="5,0,0,0" Text="{Binding UpdateTime, Mode=TwoWay}" />

            </StackPanel>
            <Grid Grid.Row="1" Grid.Column="5">
                <TextBlock Text="Frozen Update Time:" ToolTip="Updated only on Callback" Margin="27,0,0,0" />
                <TextBlock Margin="150,0,7,0" Text="{Binding FrozenUpdateTime, Mode=TwoWay}"  />
            </Grid>
        </Grid>
        <oxyplot:PlotView Grid.Row="1"
		          Height="Auto"
		          Margin="0,2,10,4"
		          VerticalContentAlignment="Stretch"
		          Background="Black"
		          BorderBrush="Gray"
		          BorderThickness="1" 
		          Model="{Binding PlotDataModel}" />
        <ContentControl prism:RegionManager.RegionName="ContentRegion" />
    </Grid>

</Window>
