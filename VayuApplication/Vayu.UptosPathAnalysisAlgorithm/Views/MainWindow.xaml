<Window x:Class="Vayu.UptosPathAnalysisAlgorithm.Views.MainWindow"
         
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Vayu.UptosPathAnalysisAlgorithm.ViewModels"        
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="False"
        Title="VAYU - DART Path Analyzer"  
        Width="1405"  
        Height="780">
    <Window.Resources>
        <ResourceDictionary>
            <vm:ComparisonConverter x:Key="ComparisonConverter"></vm:ComparisonConverter>
            <vm:IsLesserConverter x:Key="lesserThanConverter"></vm:IsLesserConverter>

            <Style x:Key="negativeStyle" x:Name="negativeStyle" TargetType="DataGridCell">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=Content,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type DataGridCell}},Converter={StaticResource lesserThanConverter}}" Value="true">
                        <Setter Property="Background" Value="Red"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="negativeStyle2" x:Name="negativeStyle2" TargetType="DataGridCell">
                <Style.Triggers>
                    <DataTrigger Value="true">
                        <DataTrigger.Binding>
                            <PriorityBinding>
                                <Binding Converter="{StaticResource lesserThanConverter}" />
                                <Binding Path="MaxLoss" Converter="{StaticResource lesserThanConverter}"/>
                            </PriorityBinding>
                        </DataTrigger.Binding>
                        <Setter Property="Background" Value="Red"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
       
        <Grid.RowDefinitions>
            <RowDefinition Height="140" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0"
		            Margin="10,10,0,0"
		            Orientation="Horizontal" >
            <!--<StackPanel Orientation="Vertical">-->

            <!--<GroupBox Width="150" Height="210" HorizontalAlignment="Center" Background="LightSteelBlue" BorderBrush="#FF1D1C1C" BorderThickness="1" Header="Algorithms">
                    <StackPanel Orientation="Vertical" Margin="0,0,0,-10">
                        <RadioButton Name="JabbaRadioButton" Height="21" Margin="5,4,5,3" Content="Ramp Algo"
						             IsChecked="{Binding Path=SelectedRobotType, Converter={StaticResource ResourceKey=ComparisonConverter}, ConverterParameter={x:Static vm:RobotType.Ramp}}"
                                     IsEnabled="{Binding IsRampEnabled}"/>
                        <RadioButton Name="PeakOffPeakRadioButton" Height="21" Margin="5,4,5,3" Content="PeakOffPeak Algo"
						             IsChecked="{Binding Path=SelectedRobotType, Converter={StaticResource ResourceKey=ComparisonConverter}, ConverterParameter={x:Static vm:RobotType.PeakOffPeak}}"
                                     IsEnabled="{Binding IsPeakOffPeakEnabled}"/>
                        <RadioButton Name="BlockRadioButton" Height="21" Margin="5,4,5,3" Content="Block Algo"
						             IsChecked="{Binding Path=SelectedRobotType, Converter={StaticResource ResourceKey=ComparisonConverter}, ConverterParameter={x:Static vm:RobotType.Block}}" />
                        <RadioButton Name="VirtualBlock" Height="21" Margin="5,4,5,3" Content="Virtual Block Algo"
                                     IsChecked="{Binding Path=SelectedRobotType, Converter={StaticResource ResourceKey=ComparisonConverter}, ConverterParameter={x:Static vm:RobotType.VirtualBlock}}" />
                        <RadioButton Name="UptosShortAlgo" Height="21" Margin="5,4,5,3" Content="UptosShort Algo"
                                     IsChecked="{Binding Path=SelectedRobotType, Converter={StaticResource ResourceKey=ComparisonConverter}, ConverterParameter={x:Static vm:RobotType.UptosShort}}" />
                        <RadioButton Name="VirtualShortAlgo" Height="21" Margin="5,4,5,3" Content="VirtualShort Algo"
                                     IsChecked="{Binding Path=SelectedRobotType,	Converter={StaticResource ResourceKey=ComparisonConverter},	ConverterParameter={x:Static vm:RobotType.VirtualShort}}" />
                        <RadioButton Name="OutageAlgo" Height="21" Margin="5,4,5,3" Content="Outage Algo"
                                     IsChecked="{Binding Path=SelectedRobotType, Converter={StaticResource ResourceKey=ComparisonConverter}, ConverterParameter={x:Static vm:RobotType.Outage}}" />
                    </StackPanel>
                </GroupBox>-->
            <!--</StackPanel>-->

            <!--<StackPanel Orientation="Vertical">-->

            <GroupBox Width="122" Height="100" Margin="-2,-15,0,0" BorderBrush="#FF1D1C1C" BorderThickness="1" Header="Algorithms">
                <StackPanel Orientation="Vertical" Margin="0,20,0,0">
                    <ComboBox Width="110" Height="30" VerticalAlignment="Center" ItemsSource="{Binding AlgorithmList}" SelectedItem="{Binding ComboSelectedRobotType, Mode=TwoWay}" 
        				DisplayMemberPath="AlgorithmList" SelectedValuePath="AlgorithmList" SelectedIndex="0" />
                </StackPanel>
            </GroupBox>

            <!--</StackPanel>-->

            <StackPanel Margin="2,0,5,5" Orientation="Horizontal">

                <ListBox x:Name="lstSourceZones"
        			Width="100" BorderBrush="Black" BorderThickness="2"
        			Height="100" Foreground="Black"
        			Margin="5,0,0,0"
        			ItemsSource="{Binding SourceZoneList}"
        			SelectedItem="{Binding SourceZoneSelectedItem, Mode=TwoWay}"
        			SelectionChanged="ListBox_SelectionChanged_1"
        			SelectionMode="Multiple">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel HorizontalAlignment="Left" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <StackPanel Height="100" Orientation="Vertical">
                    <Button x:Name="SelectSourceZones"
        				Width="90"
        				Height="45"
        				Margin="3,05,5,0"
        				Click="Button_Click_2">
                        <TextBlock><Run Text="Select All"/><LineBreak /><Run Text="Source Zones"/></TextBlock>
                    </Button>
                    <Button x:Name="UnselectSourceZones"
        				Width="90"
        				Height="45"
        				Margin="5,2,5,0"
        				Click="Button_Click_2">
                        <TextBlock><Run Text="Unselect All"/><LineBreak /><Run Text="Source Zones"/></TextBlock>
                    </Button>
                </StackPanel>
                <ListBox x:Name="lstSinkZones"
        			Width="100" BorderBrush="Black" BorderThickness="2"
        			Height="100" Foreground="Black"
        			Margin="0,0,0,0"
        			ItemsSource="{Binding SinkZoneList}"
        			SelectedItem="{Binding SinkZoneSelectedItem, Mode=TwoWay}"
        			SelectionChanged="ListBox_SelectionChanged_1"
        			SelectionMode="Multiple">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel HorizontalAlignment="Left" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <StackPanel Height="100" Orientation="Vertical">
                    <Button x:Name="SelectSinkZones"
        				Width="90"
        				Height="45"
        				Margin="3,2,5,0"
        				Click="Button_Click_2"
        				IsEnabled="{Binding SelectAllSinkZone}">
                        <TextBlock><Run Text="Select All"/><LineBreak /><Run Text="Sink Zones"/></TextBlock>
                    </Button>
                    <Button x:Name="UnselectSinkZones"
        				Width="90"
        				Height="45"
        				Margin="3,2,5,0"
        				Click="Button_Click_2"
        				IsEnabled="{Binding UnSelectAllSinkZone}">
                        <TextBlock><Run Text="Unselect All"/><LineBreak /><Run Text="Sink Zones"/></TextBlock>
                    </Button>
                </StackPanel>
                <ListBox x:Name="lstSourceNodeType"
        			Width="90" BorderBrush="Black" BorderThickness="2"
        			Height="100"
        			Margin="0,0,0,0"
        			ItemsSource="{Binding SourceNodeTypeList}"
        			SelectedItem="{Binding SourceNodeTypeSelectedItem, Mode=TwoWay}"
        			SelectionChanged="ListBox_SelectionChanged_1"
        			SelectionMode="Multiple">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel HorizontalAlignment="Left" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <StackPanel Height="100" Orientation="Vertical">
                    <Button x:Name="SelectSourceNodeType"
        				Height="45"
        				Margin="3,2,5,0"
        				Click="Button_Click_2">
                        <TextBlock><Run Text="Select All Source"/><LineBreak /><Run Text="NodeType"/></TextBlock>
                    </Button>
                    <Button x:Name="UnselectSourceNodeType"
        				Height="45"
        				Margin="3,2,5,0"
        				Click="Button_Click_2">
                        <TextBlock><Run Text="Unselect All Source"/><LineBreak /><Run Text="NodeType"/></TextBlock>
                    </Button>
                </StackPanel>
                <ListBox x:Name="lstSinkNodeType"
        			Width="90" BorderBrush="Black" BorderThickness="2"
        			Height="100"
        			Margin="0,0,0,0"
        			ItemsSource="{Binding SinkNodeTypeList}"
        			SelectedItem="{Binding SinkNodeTypeSelectedItem, Mode=TwoWay}"
        			SelectionChanged="ListBox_SelectionChanged_1"
        			SelectionMode="Multiple">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel HorizontalAlignment="Left" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <StackPanel Height="100" Orientation="Vertical">
                    <Button x:Name="SelectSinkNodeType"
        				Height="45"
        				Margin="3,2,5,0"
        				Click="Button_Click_2"
        				IsEnabled="{Binding SelectAllSinkNode}">
                        <TextBlock><Run Text="Select All Sink"/><LineBreak /><Run Text="NodeType"/></TextBlock>
                    </Button>
                    <Button x:Name="UnselectSinkNodeType"
        				Height="45"
        				Margin="3,2,5,0"
        				Click="Button_Click_2"
        				IsEnabled="{Binding UnSelectAllSinkNode}">
                        <TextBlock><Run Text="Unselect All Sink"/><LineBreak /><Run Text="NodeType"/></TextBlock>
                    </Button>
                </StackPanel>
                <GroupBox Header="Price" Margin="0,-10,0,0">
                    <Grid>
                        <Grid.Resources>
                            <Style TargetType="{x:Type TextBox}">
                                <Setter Property="Width" Value="30" />
                                <Setter Property="Margin" Value="3,0,0,0" />
                                <Setter Property="Height" Value="22" />
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
        					Grid.Column="0"
        					VerticalAlignment="Center"
        					Text="Min." />
                        <TextBox Grid.Row="0"
        					Grid.Column="1"
        					Text="{Binding MinPriceFilter, Mode=TwoWay, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1"
        					Grid.Column="0"
        					VerticalAlignment="Center"
        					Text="Max." />
                        <TextBox Grid.Row="1"
        					Grid.Column="1"
        					Text="{Binding MaxPriceFilter, Mode=TwoWay, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </GroupBox>
                <GroupBox Header="Sum Value" Margin="0,-10,0,0">
                    <Grid>
                        <Grid.Resources>
                            <Style TargetType="{x:Type TextBox}">
                                <Setter Property="Margin" Value="10,0,0,0" />
                                <Setter Property="Height" Value="22" />
                                <Setter Property="Width" Value="30" />
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
        					Grid.Column="0"
        					VerticalAlignment="Center"
        					Text="Min." />
                        <TextBox Grid.Row="0"
        					Grid.Column="1"
        					Text="{Binding SumValueMinFilter, Mode=TwoWay, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1"
        					Grid.Column="0"
        					VerticalAlignment="Center"
        					Text="Max." />
                        <TextBox Grid.Row="1"
        					Grid.Column="1"
        					Text="{Binding SumValueMaxFilter, Mode=TwoWay, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </GroupBox>

            </StackPanel>

            <StackPanel Margin="0,0,5,0" Orientation="Vertical">
                <Button Width="80"
        			Height="30"
        			Margin="0,10,0,0"
        			HorizontalContentAlignment="Center"
        			Command="{Binding FilterRobotListCommand}"
        			Content="Filter"
        			FontSize="12"
        			FontWeight="Bold" />
                <Button Width="80"
        			Height="30"
        			Margin="0,10,0,0"
        			HorizontalContentAlignment="Center"
        			Command="{Binding ResetRobotListCommand}"
        			Content="Reset"
        			FontSize="12"
        			FontWeight="Bold" />
            </StackPanel>
            <StackPanel Margin="0,25,0,0" Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Margin="-4,10,0,0" >
                    <Label Content="Date" Margin="0,0,5,0"/>
                    <DatePicker VerticalAlignment="Center" Width="105" Margin="-5,0,0,0" SelectedDate="{Binding SelectedDate}"/>
                    <!--<Button Content="Load" Width="100" Height="30" Margin="5,0,0,0" Command="{Binding LoadDataByDate}"/>-->
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Width="97"
        				Height="30"
        				Margin="2,8,0,0"
        				HorizontalAlignment="Left"
        				VerticalAlignment="Center"                                				
        				Content="ExportToExcel"
        				FontSize="10"
                          Click="Button_Click_1"
        				FontWeight="Bold" />
                    <!--Click="Button_Click_1"-->
                    <!--Command="{Binding ExportToExcel}"-->
                    <StackPanel Margin="0,4,5,0" Orientation="Horizontal">
                        <Label Content="Count:" />
                        <Label Content="{Binding ListCount}" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <StackPanel.Resources>
                <Style TargetType="TextBox">
                    <Setter Property="Height" Value="22" />
                    <Setter Property="Width" Value="40" />
                </Style>
                <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </Style>
                <Style TargetType="GroupBox">
                    <Setter Property="Margin" Value="5,-5,0,0" />
                    <Setter Property="Height" Value="90" />
                    <Setter Property="Width" Value="85" />
                    <Setter Property="BorderBrush" Value="Black" />
                </Style>
            </StackPanel.Resources>
        </StackPanel>
        <DataGrid x:Name="RobotDataGrid"
		          Grid.Row="1"
		          Width="Auto"
		          AlternatingRowBackground="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}" 
		          AreRowDetailsFrozen="True"
		          AutoGenerateColumns="True"
		          CanUserAddRows="False"
		          ColumnWidth="50*"
		          GridLinesVisibility="All"
		          ItemsSource="{Binding RobotTypeDataList}"
		          RowHeight="21"
		          SelectedItem="{Binding SourceSinkClassSelectedItem, Mode=TwoWay}"
                  SelectedCellsChanged="DataGrid_SelectedCellsChanged"
                  SelectionUnit="CellOrRowHeader"
		          SelectionMode="Extended" AutoGeneratingColumn="RobotDataGrid_AutoGeneratingColumn_1" Margin="0,0,0,0" IsReadOnly="True">
            <DataGrid.ContextMenu>
                <ContextMenu >
                    <MenuItem Header="LMP Graphs" Click="LMPGraph_Click" />
                    <MenuItem Header="Node Analyzer" Click="NodeAnalyzer_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="FontWeight" Value="Bold" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="{x:Type DataGridCell}">
                    <Setter Property="ContentStringFormat" Value="{}{0:N2}"/>
                </Style>
            </DataGrid.CellStyle>
        </DataGrid>
        <xctk:BusyIndicator Name="BusyBar"
		                    Grid.Row="2"
		                    IsBusy="{Binding ProgressBar,
		                                     Mode=TwoWay}">
            <xctk:BusyIndicator.BusyContent>
                <TextBlock Text="Application is running a background process. Please wait..." />
            </xctk:BusyIndicator.BusyContent>
        </xctk:BusyIndicator>
    </Grid>
</Window>
