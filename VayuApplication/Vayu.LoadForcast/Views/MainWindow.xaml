<Window    x:Class="Vayu.LoadForcast.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:vm ="clr-namespace:Vayu.LoadForcast.ViewModels"        
                 prism:ViewModelLocator.AutoWireViewModel="False"
        Title="Vayu Load Forecast" Height="750" Width="755"
                 ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary>
            <vm:DataGridBackColorConverter x:Key="myBGColor"/>
            <vm:ValueToForegroundColorConverter x:Key="ValueToForeground"/>
            <Style x:Key="CenterCellStyleBG" TargetType="{x:Type DataGridCell}">
                <Setter Property="Foreground" 
                        Value="{Binding RelativeSource={RelativeSource Self},
                        Path=Content.Text, 
                        Converter={StaticResource myBGColor}}" />
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="Black"/>
            </Style>


        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>
        <Grid  Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Header="Market" Grid.Column="0">
                <ComboBox x:Name="MarketName" 
                      IsEditable="True" 
                      Height="30"
                      ItemsSource="{Binding ISOMarketList}" 
                      SelectedValue="{Binding MarketComboSelectedValue, Mode=TwoWay}"
            	    
                          />
            </GroupBox>
            <GroupBox Header="Select Dates" Grid.Column="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,25">
                        <Label Content="StartDate"/>
                        <DatePicker x:Name="startdate"
                            
                            SelectedDate="{Binding StartDate}"
                            HorizontalAlignment="Left"
							VerticalAlignment="Center"
                            
                            SelectedDateFormat="Short" />
                    </StackPanel>
                    <StackPanel  Orientation="Horizontal">
                        <Label Content="EndDate" Width="60"/>
                        <DatePicker x:Name="Enddate"
                            Width="121"
                            SelectedDate="{Binding Enddate}"
                            HorizontalAlignment="Left"
							VerticalAlignment="Center"
                            
                            SelectedDateFormat="Short"/>
                    </StackPanel>
                </StackPanel>
                
            </GroupBox>
            <StackPanel Grid.Column="2">
                <Button Content="Refresh"
            	   Width="80" Height="30"
            		VerticalAlignment="Center"
            		HorizontalAlignment="Center"
                        Margin="0,25"
            		Command="{Binding RunRefreshCommand}"
            		/>
                <Button Content="ExportToCSV" Width="Auto" Height="30" HorizontalAlignment="Center"  VerticalAlignment="Center"   Command="{Binding RunExportCSVCommand}"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                
            </Grid.ColumnDefinitions>
            <TabControl Grid.Row="1" HorizontalAlignment="Left">
                <TabItem Header="Details"  VerticalAlignment="Top"  HorizontalAlignment="Left">
                    
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Background="LightSteelBlue">
                        </StackPanel>
                        <DataGrid x:Name="TempDataGrid"
				          Grid.Row="1"
				          HorizontalAlignment="Left"
				          AlternatingRowBackground="LightGray"
				          AutoGenerateColumns="False"
				          CanUserAddRows="False"
				          IsReadOnly="True"   
                          ItemsSource="{Binding LoadforecastList}"
                          
                          BorderThickness="2"
				          >
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="Black"/>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="Auto"
						                    Binding="{Binding Zone }"
						                    Header="Zone" />
                                <DataGridTextColumn Header="CurrentDayMaxMW" Binding="{Binding CurrentDayMaxMW,  Mode=TwoWay, StringFormat=N2}"  IsReadOnly="True" CellStyle="{StaticResource CenterCellStyleBG}" Width="*">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="NextDayMaxMW" Binding="{Binding NextDayMaxMW, Mode=TwoWay, StringFormat=N2}"  IsReadOnly="True" CellStyle="{StaticResource CenterCellStyleBG}" Width="*">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="LoadForecast" Binding="{Binding LoadForecast, Mode=TwoWay, StringFormat=N2}"  IsReadOnly="True" CellStyle="{StaticResource CenterCellStyleBG}" Width="*">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="DifferenceInMW" Binding="{Binding DifferenceInMW,  Mode=TwoWay, StringFormat=N2}"  IsReadOnly="True" CellStyle="{StaticResource CenterCellStyleBG}" Width="*">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Percentage" Binding="{Binding Percentage, Mode=TwoWay, StringFormat=N2}"  IsReadOnly="True" CellStyle="{StaticResource CenterCellStyleBG}" Width="*">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="FontWeight" Value="Bold" />
                                </Style>
                                
                            </DataGrid.ColumnHeaderStyle>
                        </DataGrid>

                    </StackPanel>
                    <!--</ScrollViewer>-->
                </TabItem>

            </TabControl>
        </Grid>
        <ContentControl prism:RegionManager.RegionName="ContentRegion" />
    </Grid>
</Window>
