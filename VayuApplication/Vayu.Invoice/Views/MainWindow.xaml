<Window   
    x:Class="Vayu.Invoice.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:vm="clr-namespace:Vayu.Invoice.ViewModels"
        Background="#B9CDF7" 
        Title="Vayu - StatementId Invoice"  Height="220.012" Width="825"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True" >
    <!--Icon="\Images\accountingApp.ico"-->
    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="HeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="22" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>

        <DataGrid AutoGenerateColumns="False" HorizontalAlignment="Stretch" ItemsSource="{Binding InvoiceList, Mode=TwoWay}" AlternatingRowBackground="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}"
                               CanUserDeleteRows="False" CanUserAddRows="False" VerticalScrollBarVisibility="Visible" 
                   HorizontalScrollBarVisibility="Visible" RowHeight="21" Margin="0,22,0,0" >

            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding InvoiceId}" CanUserReorder="False" Header="InvoiceId" IsReadOnly="True" 
                                                Width="Auto"  />
                <DataGridTextColumn Binding="{Binding InvoiceDate, StringFormat=MM/dd/yyyy}" CanUserReorder="False" Header="InvoiceDate" IsReadOnly="True"
                                                Width="Auto" />
                <DataGridTextColumn Binding="{Binding InvoiceTotal}" CanUserReorder="False" Header="InvoiceTotal" IsReadOnly="True" 
                                                Width="Auto" MinWidth="120" />
                <DataGridTextColumn Binding="{Binding StatementType}" CanUserReorder="False" Header="StatementType" IsReadOnly="True" 
                                                Width="Auto" MinWidth="120" />
                <DataGridTextColumn Binding="{Binding StatementId}" CanUserReorder="False" Header="StatementId" IsReadOnly="True" 
                                                Width="Auto" MinWidth="120" />
                <DataGridTextColumn Binding="{Binding OperatingDate, StringFormat=MM/dd/yyyy}" CanUserReorder="False" Header="OperatingDate" IsReadOnly="True" 
                                                Width="Auto" MinWidth="180" />
                <DataGridTextColumn Binding="{Binding StatementAmount}" CanUserReorder="False" Header="StatementAmount" IsReadOnly="True" 
                                                Width="Auto" MinWidth="180" />
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Window >
