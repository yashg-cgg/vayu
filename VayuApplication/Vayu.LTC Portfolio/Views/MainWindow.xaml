<Window    x:Class="Vayu.LTC_Portfolio.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:hh="clr-namespace:Vayu.LTC_Portfolio.Model"
				 xmlns:prism="http://prismlibrary.com/"
                 xmlns:oxy="http://oxyplot.org/wpf"
                  xmlns:util="clr-namespace:Vayu.CommonControls;assembly=Vayu.CommonControls"
                  xmlns:Behaviours="clr-namespace:Vayu.CommonControls;assembly=Vayu.CommonControls"
                  xmlns:GridLines="clr-namespace:Vayu.CommonControls;assembly=Vayu.CommonControls"
                 xmlns:nps="clr-namespace:Vayu.LTC_Portfolio.ViewModels"
                 xmlns:cc="clr-namespace:Vayu.LTC_Portfolio.Views"
           xmlns:local="clr-namespace:Vayu.LTC_Portfolio.Views"
                 prism:ViewModelLocator.AutoWireViewModel="False"
        Title="LTC Portfolio" Height="1003" Width="1750">
    <Window.Resources>
        <ResourceDictionary>
            <local:DataGridCellForeColorConverterSimple x:Key="myFGColorSimple" />
            <hh:IsGreaterConverter x:Key="greaterThanConverter"/>
            <hh:IsLesserConverter x:Key="lesserThanConverter" />
            <cc:TextBlockBackColorConverter x:Key="myTBBGColor"/>
            <cc:TextBlockForeColorConverter x:Key="myTBFGColor"/>
            <nps:BackgroundConverter x:Key="listVievBgConvertor"/>
            <Style TargetType="TextBox" x:Key="creditBox">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text, Converter={StaticResource lesserThanConverter}}" Value="true">
                        <Setter Property="Foreground" Value="Red" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="{x:Type DataGrid}">
                <Setter Property="AlternationCount" Value="2"/>
                <Setter Property="AlternatingRowBackground" Value="LightGray"/>
            </Style>
            <Style x:Key="CenterCellStyleBG" TargetType="{x:Type DataGridCell}">
                <!--<Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource Self}, Path=Content.Text, Converter={StaticResource myBGColor}}" />-->
            </Style>
            <Style x:Key="CenterCellStyleFGSimple" TargetType="{x:Type DataGridCell}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Content.Text, Converter={StaticResource lesserThanConverter}}" Value="true">
                        <Setter Property="Foreground" Value="Red" />
                    </DataTrigger>
                </Style.Triggers>
                <!--<Setter Property="Foreground"
					Value="{Binding RelativeSource={RelativeSource Self},Path=Content.Text,
					Converter={StaticResource myFGColorSimple}}" />-->
                <Setter Property="Margin" Value="0,0,0,0" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                            <Grid Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

            </Style>
            <Style x:Key="CenterCellStyleFGSimpleR" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource CenterCellStyleFGSimple}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Content.Text, Converter={StaticResource lesserThanConverter}}" Value="true">
                        <Setter Property="Foreground" Value="Red" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="HeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="22" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource BackgroundColorLight}"/>
                <Setter Property="Foreground" Value="{DynamicResource ForegroundColorLight}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="540*"/>
        </Grid.RowDefinitions>
        <Expander Grid.Row="0" Header="Parameters"   IsExpanded="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90*"/>
                    <ColumnDefinition Width="50*"/>
                    <ColumnDefinition Width="90*"/>
                    <ColumnDefinition Width="100*"/>
                    <ColumnDefinition Width="50*"/>
                </Grid.ColumnDefinitions>
                <GroupBox Header="Date" >
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition  Height="*"/>
                            <RowDefinition  Height="*"/>
                            <RowDefinition  Height="*"/> 
                            <RowDefinition  Height="*"/>
                        </Grid.RowDefinitions>
                        <Label Content="Days" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" />
                        <TextBox Text="{Binding DaysChanged,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Grid.Row="0" Grid.Column="1"/>
                        <Button x:Name="Season" Content="Season" Grid.Column="2" Command="{Binding SeasonCommand}"/>
                        <DatePicker Grid.Row="1" Grid.Column="0" x:Name="startDate" SelectedDate="{Binding StartDate}" SelectedDateFormat="Short"/>
                        <DatePicker Grid.Row="1" Grid.Column="1" x:Name="EndtDate" SelectedDate="{Binding EndDate}" SelectedDateFormat="Short"/>
                        <RadioButton Content="Range" Grid.Column="2" Grid.Row="1" IsChecked="{Binding RangeChecked, Mode=TwoWay}"/>
                        <RadioButton Content="Collection" Grid.Column="2" Grid.Row="2"  IsChecked="{Binding CollectionChecked,Mode=TwoWay}"/>
                        <ComboBox Name="CollectionCombo"  Grid.Column="0" Grid.Row="2" ItemsSource="{Binding  CollectionList}" SelectedItem="{Binding Path=CollectionComboSelectedValue,  Mode=TwoWay}"/>
                        <ListBox Grid.Row="2" Grid.Column="1"   Name="DateCollectionListBox"  ItemsSource="{Binding DateCollectionList,  Mode=TwoWay}" BorderThickness="1" />
                        <GroupBox Name="groupBox6" Header="Sort By" Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2.5*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Name="dateRadioButton" Grid.Column="0"
							             Content="Date"
							             FontWeight="Normal"
							             IsChecked="{Binding SortDateChecked,
							                                 Mode=TwoWay}" />
                                <RadioButton Name="daRadioButton" Grid.Column="1"
							             Content="DA"
							             FontWeight="Normal"
							             IsChecked="{Binding SortDaChecked,
							                                 Mode=TwoWay}" />
                                <RadioButton Name="rtButton" Grid.Column="2"
							             Content="RT"
							             FontWeight="Normal"
							             IsChecked="{Binding SortRtChecked,
							                                 Mode=TwoWay}" />
                                <RadioButton Name="dartRadioButton" Grid.Column="3"
							             Content="DART"
							             FontWeight="Normal"
							             IsChecked="{Binding SortDartChecked,
							                                 Mode=TwoWay}" />
                            </Grid>
                        </GroupBox>
                    </Grid>
                </GroupBox>
                <Grid x:Name="button" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/> 
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Row="0" Grid.Column="0" Name="marketComboBox"  ItemsSource="{Binding ISOMarketList}"  SelectedValue="{Binding Path=MarketComboSelectedValue,  Mode=TwoWay}" SelectionChanged="selectionISOChanged" />
                    <Button Grid.Column="1" Name="ResetButton" Content="Reset"  Command="{Binding ResetCommand}"/>
                    
                    <Button Grid.Column="1" Grid.Row="1" Content="Calculate"  Command="{Binding RunRetrieveFetchDataAndUpdateChartCommand}" />
                    <GroupBox Grid.Row="2" Grid.ColumnSpan="2" Header="Summary Period"  > 
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/> 
                                <ColumnDefinition Width="*"/> 
                                
                            </Grid.ColumnDefinitions>
                            <RadioButton Name="rbMonthly"
							              Grid.Column="0"
							             Content="Monthly"
							             GroupName="DailyMonthly"
							             IsChecked="{Binding MonthlyChecked,
							                                 Mode=TwoWay}" />
                            <RadioButton Name="rbDaily"
							              Grid.Column="1"
							             Content="Daily"
							             GroupName="DailyMonthly"
							             IsChecked="{Binding DailyChecked,
							                                 Mode=TwoWay}" />
                        </Grid>
                    </GroupBox>
                    <GroupBox Grid.Row="3" Header="As Bid/Must Take" Grid.ColumnSpan="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton Name="asBidRadioButton"
						            Grid.Column="0"
						             Content="As Bid"
						             FontWeight="Normal"
						             GroupName="RTDA"
						             IsChecked="{Binding AsBidChecked,
						                                 Mode=TwoWay}" />
                            <RadioButton Name="mustTakeRadioButton"
						              Grid.Column="1"
						             Content="Must Take"
						             FontWeight="Normal"
						             GroupName="RTDA"
						             IsChecked="{Binding MustTakeChecked,
						                                 Mode=TwoWay}" />
                        </Grid>
                    </GroupBox>
                </Grid>
                <GroupBox Header="Portfolio" Grid.Row="0" Grid.Column="2"  >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Name="traderPortfolioComboBox"
						          IsEditable="True" Grid.Row="0" Grid.Column="0"
						          IsTextSearchEnabled="True"
						          ItemsSource="{Binding TraderPortfolioComboList}"
						          SelectedValue="{Binding TraderPortfolioComboSelectedItem}" />
                        <Button x:Name="importbtn" Grid.Column="1"
						        Command="{Binding ImportCommand}"
						        Content="Import" />
                        <Button  x:Name="deletebtn" Grid.Column="2"
						        Command="{Binding DeleteCommand}"
						        Content="Delete" />
                        <ComboBox x:Name="auctionComboBox"
						          Grid.Column="0" Grid.Row="1"
						          IsEditable="True"
						          IsTextSearchEnabled="True"
						          ItemsSource="{Binding AuctionPortfolioComboList}"
						          SelectedValue="{Binding AuctionSelectedItem}"
						          Text="{Binding Auctiontext}" />
                        <ComboBox Name="portfolioComboBox"
						           Grid.Column="2" Grid.Row="1"
						          IsEditable="True"
						          IsTextSearchEnabled="True"
						          ItemsSource="{Binding PortfolioComboList}"
						          SelectedValue="{Binding PortfolioComboSelectedItem}" />
                        <CheckBox  Grid.Row="3" Grid.Column="0"
						          Content="New Portfolios"
						          IsChecked="{Binding ShowNewPortfolioChecked}" />
                        <CheckBox   Grid.Row="3" Grid.Column="1"
						          Content="External Porfolio"
						          IsChecked="{Binding ExternalPorfolios}" />
                        <CheckBox    Grid.Row="3" Grid.Column="2"
						          Content="Valid/Invalid"
						          IsChecked="{Binding ShowValidChecked}" />
                        <Button Name="addPortfolioCommand"
						        Grid.Row="2" Grid.Column="0"
						        Command="{Binding AddPortfolioCommand}"
						        Content="Add"
						        FontWeight="Bold" />
                        <Button Name="removePortfolioButton"
						       Grid.Row="2" Grid.Column="1"
						        Command="{Binding RemovePortfolioCommand}"
						        Content="Remove" />
                        <Button Name="retrieveButton"
						        Grid.Row="2" Grid.Column="2"
						        Command="{Binding RetrieveCommand}"
						        Content="Retrieve" />
                        <ListBox Grid.Row="4" Grid.Column="1" BorderThickness="1" Grid.ColumnSpan="2" ItemsSource="{Binding PortfolioList,   Mode=TwoWay}" SelectedValue="{Binding Path=PortfolioListSelected}"/>
                    </Grid>
                </GroupBox>
                <Grid Grid.Column="3" Name="ISO">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>  
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/> 
                    </Grid.RowDefinitions>
                    <GroupBox Header="ISO" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                        <DataGrid   AutoGenerateColumns="False"
							          CanUserAddRows="False"
							          CanUserDeleteRows="False"
                                    Selector.SelectionChanged="DataGrid_SelectionChanged"
							          CanUserReorderColumns="False"
							          ItemsSource="{Binding TransactionList}"
							          SelectedValue="{Binding SelectedTransaction}"><!--Selector.SelectionChanged="DataGrid_SelectionChanged"-->
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding ID}" Header="ID" />
                                <DataGridTextColumn Binding="{Binding Name}" Header="Name" />
                                <DataGridTextColumn Binding="{Binding Market}" Header="Market" />
                                <DataGridTextColumn Binding="{Binding Round}" Header="Round" />
                                <DataGridTextColumn Binding="{Binding Date, StringFormat={}\{0:MM/dd/yyyy\}}" Header="Date" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                    <Grid Grid.Column="2"   Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/> 
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBox  Grid.Row="0" Grid.Column="0"
							         Text="{Binding TypeText,
							                        Mode=TwoWay}"
							         TextWrapping="Wrap" />
                        <ComboBox  Grid.Row="0" Grid.Column="1"
							          ItemsSource="{Binding RoundComboList}"
							          SelectedValue="{Binding SelectedRound,
							                                  Mode=TwoWay}" />
                        <Button  Grid.Column="0" Grid.Row="1"
							        Command="{Binding SubmitCommand}"
							        Content="Submit" />
                        <Button   Grid.Column="1" Grid.Row="1"
							        Command="{Binding CancelCommand}"  />
                        <Button   Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2" 
							        Command="{Binding CreateSubmissionFileCommand}"
							        Content="Create Submission File" />
                    </Grid>
                    <GroupBox Header="Monthly Details" Grid.Row="1" Grid.ColumnSpan="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Label  Grid.Row="0"
							       Content="Submitted MWH"  HorizontalContentAlignment="Left" />
                            <TextBox  Grid.Row="1"
							         IsReadOnly="True"
							         Text="{Binding SubmittedMwhText,
							                        Mode=TwoWay}"
							         TextWrapping="Wrap" />
                        </Grid>
                    </GroupBox>
                </Grid>
                <GroupBox Header="Months"   Grid.Column="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <CheckBox Name="JanCheckBox" Grid.Row="0" Grid.Column="0" Content="Jan"  IsChecked="{Binding JanChecked, Mode=TwoWay}" />
                        <CheckBox Name="FebCheckBox" Grid.Row="0" Grid.Column="1"  Content="Feb" IsChecked="{Binding FebChecked,  Mode=TwoWay}" />
                        <CheckBox Name="MarCheckBox"  Grid.Row="0" Grid.Column="2" Content="Mar" IsChecked="{Binding MarChecked,  Mode=TwoWay}" />
                        <CheckBox Name="AprCheckBox" Content="Apr" Grid.Row="1" Grid.Column="0" IsChecked="{Binding AprChecked,  Mode=TwoWay}" />
                        <CheckBox Name="MayCheckBox" Content="May"  Grid.Row="1" Grid.Column="1" IsChecked="{Binding MayChecked,  Mode=TwoWay}" />
                        <CheckBox Name="JunCheckBox"   Content="Jun"  Grid.Row="1" Grid.Column="2" IsChecked="{Binding JunChecked,  Mode=TwoWay}" />
                        <CheckBox Name="JulCheckBox"   Content="Jul" Grid.Row="2" Grid.Column="0" IsChecked="{Binding JulChecked,    Mode=TwoWay}" />
                        <CheckBox Name="AugCheckBox"   Content="Aug" Grid.Row="2" Grid.Column="1" IsChecked="{Binding AugChecked, Mode=TwoWay}" />
                        <CheckBox Name="SepCheckBox"   Content="Sep"  Grid.Row="2" Grid.Column="2" IsChecked="{Binding SepChecked,  Mode=TwoWay}" />
                        <CheckBox Name="OctCheckBox"   Content="Oct" Grid.Row="3" Grid.Column="0"  IsChecked="{Binding OctChecked,  Mode=TwoWay}" />
                        <CheckBox Name="NovCheckBox"    Content="Nov" Grid.Row="3" Grid.Column="1" IsChecked="{Binding NovChecked,   Mode=TwoWay}" />
                        <CheckBox Name="DecCheckBox"  Content="Dec"  Grid.Row="3" Grid.Column="2" IsChecked="{Binding DecChecked,  Mode=TwoWay}" />
                        <Button Name="WinterButton" Command="{Binding WinterCommand}" Grid.Row="4" Grid.Column="0" Content="Winter" />
                        <Button Name="SpringButton"  Command="{Binding SpringCommand}" Grid.Row="4" Grid.Column="1"   Content="Spring" />
                        <Button Name="SummerButton"  Grid.Row="4" Grid.Column="2"
                                Command="{Binding SummerCommand}"  Content="Summer" />
                        <Button Name="FallButton"  Grid.Row="5" Grid.Column="0"
                                Command="{Binding FallCommand}" Content="Fall" />
                        <Button Name="AllMonthButton"  Grid.Row="5" Grid.Column="1"
                                Command="{Binding AllCommand}" 
						        Content="All" />
                        <Button Name="NoneMonthButton"  Grid.Row="5" Grid.Column="2"
                                Command="{Binding NoneClick}"
						        Content="None" />
                    </Grid>
                </GroupBox>
                <Grid Name="stat" Grid.Row="2" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Header="Summary"   Grid.Column="0" Grid.ColumnSpan="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions> 
                                <CheckBox Name="cbTotal" Grid.Column="0"
							          Content="Total"
							          IsChecked="{Binding FilterDayComparisonTotalChecked,
							                              Mode=TwoWay}" />
                            <CheckBox Name="cbAvg" Grid.Column="1"
							          Content="Avg"
							          IsChecked="{Binding FilterDayComparisonAvgChecked,
							                              Mode=TwoWay}" />
                            <CheckBox Name="cbMinPct" Grid.Column="2"
							          Content="Min"
							          IsChecked="{Binding FilterDayComparisonMinChecked,
							                              Mode=TwoWay}" />
                            <CheckBox Name="cbMaxPct" Grid.Column="3"
							          Content="Max"
							          IsChecked="{Binding FilterDayComparisonMaxChecked,
							                              Mode=TwoWay}" />
                            <CheckBox Name="cbWinPct" Grid.Column="4"
							          Content="Win %"
							          IsChecked="{Binding FilterDayComparisonWinPctChecked,
							                              Mode=TwoWay}" />
                            <CheckBox Name="cbRisk" Grid.Column="5"
							          Content="Risk"
							          IsChecked="{Binding FilterDayComparisonRiskChecked,
							                              Mode=TwoWay}" />
                        </Grid>
                    </GroupBox>
                </Grid>
                <GroupBox Header="Highlight" Grid.Row="2" Grid.Column="2"  >
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Above" Grid.Column="0"/>
                        <Label Content="Below" Grid.Column="2"/>
                        <TextBox x:Name="abovetxt" Grid.Column="1"  Text="{Binding SpreadHighlightAbove, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                        <TextBox x:Name="belowtxt" Grid.Column="3" Text="{Binding SpreadHighlightBelow, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    </Grid>
                </GroupBox>
                <Grid Grid.Column="3"  Grid.ColumnSpan="2" Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Header="Credit" Grid.Column="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBox   Text="{Binding TotalCredit, Mode=TwoWay}" Style="{StaticResource creditBox}"  />
                            <Button    Command="{Binding CreditCommand}"
							        Content="Calculate" Grid.Column="1"/>
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="Results" Grid.Column="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/> 
                                <ColumnDefinition Width="1.5*"/> 
                                <ColumnDefinition Width="1*"/> 
                                <ColumnDefinition Width="1.5*"/> 
                                <ColumnDefinition Width="1*"/> 
                                <ColumnDefinition Width="1*"/> 
                                <ColumnDefinition Width="1*"/> 
                                <ColumnDefinition Width="1.2*"/> 
                            </Grid.ColumnDefinitions>
                            
                                <TextBox  Grid.Column="1"
							         IsReadOnly="True"
							         Text="{Binding MWText,
							                        Mode=TwoWay}"
							         TextWrapping="Wrap" />
                                <Label  Grid.Column="0"
							       Content="MW" />
                                <Label Grid.Column="2"
							       Content="DA $" />
                                <TextBox  Grid.Column="3"
							         IsReadOnly="True"
							         Text="{Binding DAText,
							                        Mode=TwoWay}"
							         TextWrapping="Wrap" />
                                <Label  Grid.Column="4"
							       Content="Count" />
                                <TextBox  Grid.Column="5"
							         IsReadOnly="True"
							         Text="{Binding CountText,
							                        Mode=TwoWay}"
							         TextWrapping="Wrap" />
                                <Label Grid.Column="6"
							       Content="Cleared" />
                                <TextBox  Grid.Column="7"
							         IsReadOnly="True"
							         Text="{Binding ClearedText,
							                        Mode=TwoWay}"
							         TextWrapping="Wrap" />
                         
                        </Grid>
                    </GroupBox>
                </Grid>
            </Grid>
        </Expander>
        <Expander Header="Summary" IsExpanded="True" Grid.Row="1">
             <DataGrid 
				          AreRowDetailsFrozen="True"
				          AutoGenerateColumns="False"
				          CanUserAddRows="False"
				          CanUserReorderColumns="False"
				          CanUserResizeRows="False"
				          CanUserSortColumns="False"
				          ColumnHeaderStyle="{StaticResource HeaderStyle}"
				          EnableRowVirtualization="True"
				          GridLinesVisibility="All"
				          HeadersVisibility="All"
				          HorizontalGridLinesBrush="#A0A0A0"
				          HorizontalScrollBarVisibility="Visible"
				          ItemsSource="{Binding HourlyPivotListSummary}"
				          RowHeight="20"
				          ScrollViewer.CanContentScroll="true"
				          SelectionUnit="CellOrRowHeader"
				          UseLayoutRounding="False"
				          VerticalGridLinesBrush="#A0A0A0"
				          VerticalScrollBarVisibility="Hidden">
                    <DataGrid.Resources>
                        <Style TargetType="{x:Type DataGridRowHeader}">
                            <Setter Property="Width" Value="20" />
                        </Style>
                        <Style TargetType="{x:Type DataGridRow}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="DarkBlue" />
                                    <Setter Property="BorderBrush" Value="PaleTurquoise" />
                                    <Setter Property="Background" Value="PaleTurquoise" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Width="60"
						                    MinWidth="50"
						                    Binding="{Binding RowDisplayType}"
						                    CanUserReorder="False"
						                    Header="Stat"
						                    IsReadOnly="True" />
                        <DataGridTextColumn Width="45"
						                    MinWidth="50"
						                    Binding="{Binding RowDay}"
						                    CanUserReorder="False"
						                    Header="Type"
						                    IsReadOnly="True" />
                        <DataGridTextColumn Width="70*"
						                    MinWidth="50"
						                    Binding="{Binding monthlyClearedmwhText}"
						                    CanUserReorder="False"
						                    CellStyle="{StaticResource CenterCellStyleFGSimple}"
						                    Header="MWH"
						                    IsReadOnly="True" />


                        <DataGridTextColumn Width="50*"
						                    MinWidth="40"
						                    Binding="{Binding Average,
						                                      StringFormat={}\{0:N\}}"
						                    CanUserReorder="False"
						                    CellStyle="{StaticResource CenterCellStyleFGSimple}"
						                    Header="Avg"
						                    IsReadOnly="True" />
                        <DataGridTextColumn Width="70*"
						                    MinWidth="50"
						                    Binding="{Binding Total,
						                                      StringFormat={}\{0:N\}}"
						                    CanUserReorder="False"
						                    CellStyle="{StaticResource CenterCellStyleFGSimple}"
						                    Header="Total"
						                    IsReadOnly="True" />



                        <DataGridTextColumn Width="50*"
						                    MinWidth="40"
						                    Binding="{Binding HE1,
						                                      StringFormat={}\{0:N\}}"
						                    CanUserReorder="False"
						                    CellStyle="{StaticResource CenterCellStyleFGSimple}"
						                    Header="1"
						                    IsReadOnly="True" />
                        <DataGridTextColumn Width="50*"
						                    MinWidth="40"
						                    Binding="{Binding HE2,
						                                      StringFormat={}\{0:N\}}"
						                    CanUserReorder="False"
						                    CellStyle="{StaticResource CenterCellStyleFGSimple}"
						                    Header="2"
						                    IsReadOnly="True" />
