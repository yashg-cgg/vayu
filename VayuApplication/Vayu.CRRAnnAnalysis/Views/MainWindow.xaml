<Window x:Class="Vayu.CRRAnnAnalysis.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vayu.CRRAnnAnalysis.Views"
        mc:Ignorable="d"
        Title="CRR Annual Analysis" Height="1003" Width="1683">
    <Window.Resources>
        <ResourceDictionary>

        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="250"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <!--<ColumnDefinition Width="300*"/>-->
                <!--<ColumnDefinition Width="150*"/>-->

            </Grid.ColumnDefinitions>
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30*"/>
                    <RowDefinition Height="50*"/>
                    <RowDefinition Height="30*"/>
                    <RowDefinition Height="50*"/>
                    <RowDefinition Height="0*"/>
                    <RowDefinition Height="0*"/>
                  
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" Margin="10 5 2 2" ItemsSource="{Binding YearList}"
                          SelectedItem="{Binding StartYear,Mode=TwoWay}"
                          IsEditable="True"
                          IsReadOnly="True"
                          Text="Start Year"
                          Foreground="Gray"
                          />
                <!--<DatePicker Name="StartDatePicker" BorderThickness="1" BorderBrush="Black" Margin="10 5 2 2"
                            Grid.Column="0"
                            SelectedDate="{Binding StartDate}"
                            SelectedDateFormat="Short"/>-->
                <ComboBox Grid.Column="1" Margin="10 5 2 2" ItemsSource="{Binding YearList}"
                          SelectedItem="{Binding EndYear,Mode=TwoWay}"
                          IsEditable="True"
                          IsReadOnly="True"
                          Text="End Year"
                          Foreground="Gray"
                          />
                <ComboBox Grid.Column="2" 
                          Margin="10 5 2 2" 
                          ItemsSource="{Binding MonthList}"
                          SelectedItem="{Binding SelectedMonth,Mode=TwoWay}"
                          IsEditable="True"
                          IsReadOnly="True"
                          Text="Select Month"
                          Foreground="Gray"
                    />
                <!--<DatePicker Name="EndDatePicker" BorderThickness="1" BorderBrush="Black" Margin="10 5 15 2"
                            Grid.Column="1"
                            SelectedDate="{Binding EndDate}"
                            SelectedDateFormat="Short"/>-->
                <ComboBox Name="marketComboBox"
		              Grid.Column="3" BorderThickness="1" BorderBrush="Black" Margin="10 5 15 2"
		              ItemsSource="{Binding ISOMarketList}"
		              SelectedValue="{Binding Path=MarketComboSelectedValue, Mode=TwoWay}" />
                <GroupBox Grid.Row="1" Grid.ColumnSpan="4" Header="Hours" Margin="0,0,0,1">
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <RadioButton 
				             Content="PeakWD"
				             FontWeight="Normal"  Grid.Column="0"  Width="auto"
				             GroupName="RTDA"
                            
                            IsChecked="{Binding IsPeakWD,Mode=TwoWay}"/>
                        
                        <RadioButton 
				             Content="OFFPEAK" Grid.Column="1"   Margin="1 0 0 0"
				             FontWeight="Normal"
				             GroupName="RTDA"
                             IsChecked="{Binding IsOffPeak,Mode=TwoWay}"  />
                        <RadioButton
				             Content="PEAKWE" Grid.Column="2" Margin="2 0 0 0"
                            HorizontalContentAlignment="Right"
				             FontWeight="Normal"
				             GroupName="RTDA" 
                             IsChecked="{Binding IsPeakWe,Mode=TwoWay}"/>
                        <!--<RadioButton
				             Content="24H " Grid.Column="3"
                             Margin="6 0 0 0 "  Width="auto"
				             FontWeight="Normal" 
				             GroupName="RTDA"  
                             IsChecked="{Binding Hour24Checked}"/>-->
                        <!--<Button x:Name="updateButton" Content="Refresh" Margin="0 0 2 0 "    Background="#3da3ff" Grid.Column="4" Click="Refresh_Click" Command="{Binding RunRetrieveFetchDataAndUpdateChartCommand}" FontSize="10" />-->
                        <Button Name="ResetButton" Grid.Column="5"
		                Command="{Binding ResetCommand}" Content="Reset"     FontSize="10" />
                    </Grid>
                </GroupBox>
                <!--<Grid Grid.Row="2" Grid.ColumnSpan="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <RadioButton Content="RT" Grid.Column="0" Margin="2"
					          IsChecked="{Binding FilterDayComparisonRTChecked,Mode=TwoWay}" />
                    <RadioButton Content="DA" Grid.Column="1" Margin="2"
					          IsChecked="{Binding FilterDayComparisonDAChecked,Mode=TwoWay}" />
                    <RadioButton Content="CRR"  Grid.Column="2" Margin="2"
					          IsChecked="{Binding FilterDayComparisonCrrChecked,Mode=TwoWay}" />
                    <RadioButton Content="DA-CRR"  Grid.Column="3" Margin="-3"
					          IsChecked="{Binding FilterDayComparisonDACrrChecked,Mode=TwoWay}" />
