<Window 
        
        x:Class="Vayu.CongestionVolatilityIndex.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
    xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf"
        prism:ViewModelLocator.AutoWireViewModel="False"   ResizeMode="CanResize"
        Title="Congestion Volatility Index" Height="Auto" Width="1350">
    <Grid Background="Teal">
        <Grid.RowDefinitions>
            <RowDefinition Height="1.2*"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="5.5*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Header="Market">
                <ComboBox ItemsSource="{Binding  MarketList,Mode=TwoWay}" SelectedItem="{Binding MarketSelected, Mode=TwoWay}"/>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Date Range">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/> 
                        <ColumnDefinition Width="*"/> 
                    </Grid.ColumnDefinitions>
                    <DatePicker  Grid.Column="0" VerticalAlignment="Center" SelectedDate="{Binding FromSelectedDate}"/>
                    <DatePicker  Grid.Column="1" Margin="2" VerticalAlignment="Center"  SelectedDate="{Binding EndSelectedDate}"/>
                </Grid>
            </GroupBox>
            <GroupBox Header="Type" Grid.Column="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton Content="Hourly" Grid.Column="0" IsChecked="{Binding HourlyChecked,Mode=TwoWay}"/>
                    <RadioButton Content=" 4 Hourly" Grid.Column="1" IsChecked="{Binding FourhourlyChecked,Mode=TwoWay}"/>
                    <RadioButton Content="Daily" Grid.Column="2" IsChecked="{Binding DailyChecked,Mode=TwoWay}"/>
                    <Button x:Name="btnRefresh" Grid.Column="3" Command="{Binding RefreshCommand}" Content="Refresh"/>
                </Grid>
            </GroupBox>
           
        </Grid>
        <Grid Grid.Row="2">
            <oxy:PlotView  Grid.Row="1" Height="Auto" Margin="0,2,10,4" VerticalContentAlignment="Stretch" Background="Black" BorderBrush="Gray" BorderThickness="1" Model="{Binding PlotDataModel}" />
        </Grid>
        <ContentControl prism:RegionManager.RegionName="ContentRegion" />
    </Grid>
</Window>
